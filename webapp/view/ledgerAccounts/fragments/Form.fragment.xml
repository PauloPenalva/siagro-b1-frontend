<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="ledgerAccountsForm"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Dados da Conta Contábil"
              emphasized="true"
          />
          <Label text="Codigo" />
          <Input
              value="{Code}"
              required="true"
              maxLength="20"
          />
          <Label text="Nome" />
          <Input
              value="{Name}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Tipo"/>
          <Select
            required="true"
            selectedKey="{
              path: 'Type',
              targetType: 'any'
            }"
            forceSelection="false"
          >
            <core:ListItem key="Asset" text="Ativo" />
            <core:ListItem key="Liability" text="Passivo" />
            <core:ListItem key="Revenue" text="Receita" />
            <core:ListItem key="Expense" text="Despesa" />
            <core:ListItem key="Equity" text="Patrimônio Líquido" />
          </Select>
          <Label text="Natureza" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <Select
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
            selectedKey="{
              path: 'Nature',
              targetType: 'any'
            }"
            forceSelection="false"
          >
            <core:ListItem key="Debit" text="Devedora" />
            <core:ListItem key="Credit" text="Credora" />
          </Select>
          <Label text="Conta superior" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <Input
            value="{ParentCode}"
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openSyntheticLedgerAccountsValueHelp"
            showClearIcon="true"
            maxLength="20"
          />
          <Label text="Aceita lançamento ?" />
          <CheckBox
            selected="{AllowsPosting}"
          />
          <Label text="Aceita centro de custo ?" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <CheckBox
            selected="{AcceptsCostCenter}"
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
          />
          <Label text="Exige centro de custo ?" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <CheckBox
            selected="{RequiresCostCenter}"
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
          />
          <Label text="Aceita item contábil ?" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <CheckBox
            selected="{AcceptsAccountingItem}"
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
          />
          <Label text="Exige item contábil ?" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <CheckBox
            selected="{RequiresAccountingItem}"
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
          />
          <Label text="Conta de apuração" visible="{= ${sessionModel>/erp} === 'STANDALONE' &amp;&amp; (${Type} === 'Revenue' || ${Type} === 'Expense') }" />
          <Input
            value="{ResultClosingAccountCode}"
            visible="{= ${sessionModel>/erp} === 'STANDALONE' &amp;&amp; (${Type} === 'Revenue' || ${Type} === 'Expense') }"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openPostingLedgerAccountsValueHelp"
            showClearIcon="true"
            maxLength="20"
          />
          <Label text="Código referencial (RFB)" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <Input
            value="{ReferentialCode}"
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
            maxLength="30"
          />
          <Label text="Bloqueada de / até" visible="{= ${sessionModel>/erp} === 'STANDALONE' }" />
          <DatePicker
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
            value="{ path: 'BlockedFrom', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { precision: 7 }, formatOptions: { pattern: 'dd/MM/yyyy' } }"
            displayFormat="dd/MM/yyyy"
          />
          <DatePicker
            visible="{= ${sessionModel>/erp} === 'STANDALONE' }"
            value="{ path: 'BlockedTo', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { precision: 7 }, formatOptions: { pattern: 'dd/MM/yyyy' } }"
            displayFormat="dd/MM/yyyy"
          />
          <Label text="Inativo ?" />
          <CheckBox
            selected="{Inactive}"
          />
        </f:content>
        <core:Title />
        <core:Title />
    </f:SimpleForm>
</core:FragmentDefinition>
