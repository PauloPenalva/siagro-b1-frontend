<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="docNumbersForm"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0"
    >
        <f:content>
            <core:Title
                text="Dados da Numeração de Documento"
                emphasized="true"
            />
            <Label text="Documento" />
            <Select
                id="docNumberTransactionCode"
                selectedKey="{
                  path: 'TransactionCode',
                  targetType: 'any'
                }"
                editable="{= ${ui>/docNumberTransactionLocked} !== true }"
                required="true"
                forceSelection="false"
            >
              <core:ListItem key="PurchaseContract" text="Contrato de Compra"/>
              <core:ListItem key="SalesContract" text="Contrato de Venda"/>
              <core:ListItem key="SalesInvoice" text="Documento de Saída"/>
              <core:ListItem key="WeighingTicket" text="Ticket de Pesagem"/>
              <core:ListItem key="StorageAddress" text="Lote de Armazenagem"/>
              <core:ListItem key="StorageTransaction" text="Romaneio"/>
              <core:ListItem key="OwnershipTransfer" text="Transferencia Propriedade"/>
              <core:ListItem key="StorageInvoice" text="Fatura de Serviço"/>
              <core:ListItem key="ShipmentLoad" text="Carga"/>
              <core:ListItem key="FinancialDocument" text="Financeiro"/>
              <core:ListItem key="WarehouseReconciliation" text="Conferência de Saldo"/>
              <core:ListItem key="PurchaseInvoice" text="Documento de Entrada"/>
              <core:ListItem key="Customer" text="Cliente"/>
              <core:ListItem key="Supplier" text="Fornecedor"/>
              <core:ListItem key="Item" text="Produto"/>
            </Select>
            <Label text="Nome" />
            <Input
                value="{Name}"
                editable="true"
                required="true"
                liveChange=".validateField"
            />
            <Label text="Primeiro Numero" visible="{= !${IsManual} }" />
            <Input 
                visible="{= !${IsManual} }"
                type="Number"
								required="true"
                value="{FirstNumber}" />
            <Label text="Próximo Numero" visible="{= !${IsManual} }" />
            <Input 
                visible="{= !${IsManual} }"
                type="Number"
								required="true"
                value="{NextNumber}" />

            <core:Title  text=""/>
            <Label text="Prefixo" visible="{= !${IsManual} }" />
            <Input value="{Prefix}" visible="{= !${IsManual} }" />
            <Label text="Sufixo" visible="{= !${IsManual} }" />
            <Input value="{Suffix}" visible="{= !${IsManual} }" />
            <Label text="Qtd. Digitos" visible="{= !${IsManual} }" />
            <Input type="Number" value="{NumberSize}" visible="{= !${IsManual} }" />
            <Label text="Padrão ?"/>
            <CheckBox selected="{Default}" editable="{= !${IsManual} }" />
            <Label text="Inativo ?"/>
            <CheckBox selected="{Inactive}" />
            <Label text="Manual ?"/>
            <CheckBox selected="{IsManual}" editable="false" />

        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>
