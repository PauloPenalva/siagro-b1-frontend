<mvc:View
	controllerName="siagrob1.controller.companySignatories.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:rowmodes="sap.ui.table.rowmodes"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Signatários da Empresa">
		<content>
			<t:Table
				id="tableCompanySignatories"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/CompanySignatories',
					sorter: [
						{ path: 'Order' },
						{ path: 'Name' }
					]
				}"
			>
				<t:rowMode>
					<rowmodes:Auto />
				</t:rowMode>
				<t:extension>
					<OverflowToolbar>
						<ToolbarSpacer />
						<SearchField placeholder="Pesquisar..." width="30%" search=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="Nome" sortProperty="Name" filterProperty="Name">
						<t:template>
							<Text text="{Name}" />
						</t:template>
					</t:Column>
					<t:Column label="CPF/CNPJ" sortProperty="TaxId" filterProperty="TaxId" width="11rem">
						<t:template>
							<Text text="{TaxId}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="E-mail" sortProperty="Email" filterProperty="Email">
						<t:template>
							<Text text="{Email}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Papel" sortProperty="Role" width="16rem">
						<t:template>
							<Text text="{path: 'Role', targetType: 'any', formatter: '.formatter.signatoryRoleText'}" />
						</t:template>
					</t:Column>
					<t:Column label="Ordem" sortProperty="Order" hAlign="End" width="6rem">
						<t:template>
							<Text text="{Order}" wrapping="false"/>
						</t:template>
					</t:Column>
					<!-- Filial vazia = assina por todas. -->
					<t:Column label="Filial" sortProperty="BranchCode" filterProperty="BranchCode" width="8rem">
						<t:template>
							<Text text="{BranchCode}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Ativo" width="7rem">
						<t:template>
							<ObjectStatus
								text="{path: 'Active', targetType: 'any', formatter: '.formatter.formatActive'}"
								state="{path: 'Active', targetType: 'any', formatter: '.formatter.stateActive'}" />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit"/>
				<Button text="Deletar" icon="sap-icon://delete" press=".onDelete"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
