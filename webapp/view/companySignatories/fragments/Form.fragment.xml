<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
  <f:Form id="formCompanySignatory" editable="true">
    <f:layout>
      <f:ColumnLayout columnsM="2" columnsL="3" columnsXL="4"/>
    </f:layout>
    <f:formContainers>
      <f:FormContainer title="Dados do Signatário">
        <f:formElements>
          <f:FormElement label="Nome">
            <f:fields>
              <Input
                value="{Name}"
                maxLength="100"
                required="true"
                liveChange=".validateField"/>
            </f:fields>
          </f:FormElement>
          <f:FormElement label="CPF/CNPJ">
            <f:fields>
              <Input
                value="{TaxId}"
                maxLength="14"
                required="true"
                liveChange=".validateField"/>
            </f:fields>
          </f:FormElement>
          <!-- É por este e-mail que o webhook do provedor identifica quem assinou. -->
          <f:FormElement label="E-mail">
            <f:fields>
              <Input
                value="{Email}"
                type="Email"
                maxLength="200"
                required="true"
                liveChange=".validateField"/>
            </f:fields>
          </f:FormElement>
          <f:FormElement label="Papel">
            <f:fields>
              <Select
                forceSelection="false"
                required="true"
                selectedKey="{path: 'Role', targetType: 'any'}"
                items="{options>/roles}">
                <core:ListItem key="{options>key}" text="{options>text}"/>
              </Select>
            </f:fields>
          </f:FormElement>
          <f:FormElement label="Ordem">
            <f:fields>
              <StepInput value="{Order}" min="0" max="99" step="1" width="8rem"/>
            </f:fields>
          </f:FormElement>
          <!-- Vazia = assina por todas as filiais. -->
          <f:FormElement label="Filial">
            <f:fields>
              <Input
                value="{BranchCode}"
                showValueHelp="true"
                valueHelpRequest=".openBranchsValueHelp"/>
            </f:fields>
          </f:FormElement>
          <f:FormElement label="Ativo">
            <f:fields>
              <CheckBox selected="{Active}"/>
            </f:fields>
          </f:FormElement>
        </f:formElements>
      </f:FormContainer>
    </f:formContainers>
  </f:Form>
</core:FragmentDefinition>
