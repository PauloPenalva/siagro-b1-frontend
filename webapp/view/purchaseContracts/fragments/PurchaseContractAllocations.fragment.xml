<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
  <t:Table
    id="purchaseContractsAllocationsTable"
    class="sapUiSizeCondensed"
    alternateRowColors="true"
    enableBusyIndicator="true"
    enableSelectAll="false"
    selectionBehavior="Row"
    selectionMode="Single"
    busyIndicatorDelay="0"
    rows="{allocationModel>/allocations}"
    visible="true"
    >
    <t:rowSettingsTemplate>
      <t:RowSettings highlight="{
        path: 'allocationModel>Origin',
        formatter: '.formatter.allocationOriginHighlight'
      }" />
    </t:rowSettingsTemplate>
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Entregas do Contrato de Compra" />
          <ToolbarSpacer />
          <!-- Legenda das faixas de cor: uma entrada por origem (helpers/AllocationOriginHelpers) -->
          <HBox items="{allocationOrigins>/}" alignItems="Center">
            <ObjectStatus
              class="sapUiSmallMarginBegin"
              text="{allocationOrigins>legend}"
              state="{allocationOrigins>state}"
              icon="sap-icon://color-fill" />
          </HBox>
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <t:Column label="Filial" tooltip="Filial">
        <t:template>
          <Text text="{allocationModel>BranchName}" tooltip="{allocationModel>BranchName}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Romaneio" tooltip="Romaneio">
        <t:template>
          <Text text="{allocationModel>StorageTransactionCode}" tooltip="{allocationModel>StorageTransactionCode}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Data" tooltip="Data">
        <t:template>
          <Text wrapping="false" text="{
            path: 'allocationModel>StorageTransactionDate',
            formatter: '.formatter.formatDate'
          }" />
        </t:template>
      </t:Column>
      <t:Column label="Tipo" tooltip="Tipo">
        <t:template>
          <Text text="{allocationModel>StorageTransactionTypeName}" tooltip="{allocationModel>StorageTransactionTypeName}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Origem" tooltip="Origem" width="10rem">
        <t:template>
          <ObjectStatus
            text="{ path: 'allocationModel>Origin', formatter: '.formatter.allocationOriginText' }"
            state="{ path: 'allocationModel>Origin', formatter: '.formatter.allocationOriginState' }"
            icon="{ path: 'allocationModel>Origin', formatter: '.formatter.allocationOriginIcon' }"
            tooltip="{
              parts: ['allocationModel>Origin', 'allocationModel>WarehouseReconciliationCode'],
              formatter: '.formatter.allocationOriginTooltip'
            }" />
        </t:template>
      </t:Column>
      <t:Column label="Motivo" tooltip="Motivo" width="12rem">
        <t:template>
          <Text text="{allocationModel>ReasonDescription}" tooltip="{allocationModel>ReasonDescription}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Quantidade" tooltip="Quantidade" hAlign="End">
        <t:template>
          <Text wrapping="false" text="{
            path: 'allocationModel>Volume',
            type: 'sap.ui.model.type.Float',
            formatOptions: {
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
            } 
          }" />   
        </t:template>
      </t:Column>
      <t:Column label="Un.Med." tooltip="Un.Med.">
        <t:template>
          <Text text="{allocationModel>UnitOfMeasureCode}" tooltip="{allocationModel>UnitOfMeasureCode}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Armazem" tooltip="Armazem">
        <t:template>
          <Text text="{allocationModel>WarehouseCode}" tooltip="{allocationModel>WarehouseCode}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Nome" tooltip="Nome" width="15rem">
        <t:template>
          <Text text="{allocationModel>WarehouseName}" tooltip="{allocationModel>WarehouseName}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Placa" tooltip="Placa">
        <t:template>
          <Text text="{allocationModel>TruckCode}" tooltip="{allocationModel>TruckCode}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Nota Fiscal Venda" tooltip="Nota Fiscal Venda">
        <t:template>
          <Text text="{allocationModel>NotaFiscalVenda}" tooltip="{allocationModel>NotaFiscalVenda}" wrapping="false" />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
