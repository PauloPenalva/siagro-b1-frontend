<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
<!--
  Situação de assinatura. Fica FORA do formulário do contrato de propósito: o formulário só é
  editável em rascunho, e a assinatura vale em qualquer status. A gravação é a action
  PurchaseContractsSetSignatureStatus, não o PATCH do cabeçalho.

  O Select escreve num JSONModel (viewModel), não no contexto OData — o valor só chega ao
  servidor quando o usuário confirma.
-->
<Dialog id="purchaseContractSignatureDialog" title="Situação da Assinatura">
  <content>
    <VBox class="sapUiSmallMargin" width="420px">
      <MessageStrip
        text="A situação da assinatura pode ser alterada a qualquer momento, independente do status do contrato."
        type="Information"
        showIcon="true"
        class="sapUiSmallMarginBottom"
      />
      <f:Form editable="true">
        <f:layout>
          <f:ColumnLayout columnsM="1" columnsL="1" columnsXL="1"/>
        </f:layout>
        <f:formContainers>
          <f:FormContainer>
            <f:formElements>
              <f:FormElement label="Situação">
                <f:fields>
                  <!-- forceSelection=false: "não informado" é estado legítimo. -->
                  <Select
                    id="purchaseContractSignatureStatusSelect"
                    forceSelection="false"
                    width="100%"
                    selectedKey="{viewModel>/signatureStatus}"
                  >
                    <core:ListItem key="" text="Não informado"/>
                    <core:ListItem key="AwaitingSignature" text="Aguardando Assinatura"/>
                    <core:ListItem key="Signed" text="Assinado"/>
                  </Select>
                </f:fields>
              </f:FormElement>
            </f:formElements>
          </f:FormContainer>
        </f:formContainers>
      </f:Form>
    </VBox>
  </content>
  <footer>
    <OverflowToolbar>
      <ToolbarSpacer />
      <Button text="Confirmar" type="Emphasized" press=".onConfirmSignatureStatus"/>
      <Button text="Fechar" press=".onCloseSignatureStatusDialog" />
    </OverflowToolbar>
  </footer>
</Dialog>
</core:FragmentDefinition>
