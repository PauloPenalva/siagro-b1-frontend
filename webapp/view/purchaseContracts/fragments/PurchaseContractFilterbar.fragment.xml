<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
>
<fb:FilterBar id="purchaseContractFb" search=".onSearch" showClearOnFB="true" clear=".onClearFilters">
  <fb:filterGroupItems>
       <fb:FilterGroupItem name="branch" label="Filial" groupName="GroupBranch" visibleInFilterBar="true">
        <fb:control>
            <Select 
              forceSelection="false"
              selectedKey="{filter>/BranchCode}"
              items="{
                path: '/Branchs',
                suspended: true,
                sorter: { 
                  path: 'Code'
                }
              }">
              <core:ListItem key="{Code}" text="{ShortName}"/>
            </Select>
        </fb:control>
      </fb:FilterGroupItem>
       <fb:FilterGroupItem name="status" label="Status" groupName="GroupStatus" visibleInFilterBar="true">
        <fb:control>
            <MultiComboBox width="100%" selectedKeys="{filter>/Status}">
              <core:Item key="Draft" text="Rascunho"/>
              <core:Item key="Approved" text="Aprovado"/>
              <core:Item key="Finished" text="Finalizado"/>
              <core:Item key="Canceled" text="Cancelado"/>
              <core:Item key="InApproval" text="Em Aprovação"/>
              <core:Item key="Rejected" text="Rejeitado"/>
            </MultiComboBox>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="signatureStatus" label="Assinatura" groupName="GroupSignatureStatus" visibleInFilterBar="true">
        <fb:control>
            <MultiComboBox width="100%" selectedKeys="{filter>/SignatureStatus}">
              <core:Item key="AwaitingSignature" text="Aguardando Assinatura"/>
              <core:Item key="Signed" text="Assinado"/>
              <core:Item key="NoContract" text="Sem Contrato"/>
            </MultiComboBox>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="code" label="Codigo" groupName="GroupCode" visibleInFilterBar="true">
        <fb:control>
            <Input showClearIcon="true" value="{filter>/Code}">
            </Input>
        </fb:control>
      </fb:FilterGroupItem>
       <fb:FilterGroupItem name="type" label="Tipo de Contrato" groupName="GroupType" visibleInFilterBar="true">
        <fb:control>
            <Select 
              forceSelection="false"
              selectedKey="{
                path: 'filter>/Type',
                type: 'sap.ui.model.type.String'
              }"
            >
              <core:ListItem key="Fixed" text="FIX - Preço Fixo"/>
              <core:ListItem key="ToBeDetermined" text="PAF - Preço a Fixar"/>
            </Select>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="complement" label="Complemento" groupName="GroupComplement" visibleInFilterBar="true">
        <fb:control>
            <Input showClearIcon="true" value="{filter>/Complement}">
            </Input>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="businessPartners" label="Fornecedor" groupName="GroupFornecedor" visibleInFilterBar="true">
        <fb:control>
            <Input
              showClearIcon="true"
              showValueHelp="true"
              valueHelpRequest=".openSuppliersValueHelp"
              value="{filter>/CardCode}"
              >
            </Input>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="agent" label="Comprador" groupName="GroupAgent" visibleInFilterBar="true">
        <fb:control>
            <Input
              showClearIcon="true"
              showValueHelp="true"
              valueHelpRequest=".openAgentsValueHelp"
              value="{filter>/AgentCode}"
              />
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="items" label="Produto" groupName="GroupItem" visibleInFilterBar="true">
        <fb:control>
            <Input
              showClearIcon="true"
              showValueHelp="true"
              valueHelpRequest=".openItemValueHelp"
              value="{filter>/ItemCode}"
              >
            </Input>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="deliveryLocation" label="Armazém" groupName="GroupDeliveryLocation" visibleInFilterBar="true">
        <fb:control>
            <Input
              showClearIcon="true"
              showValueHelp="true"
              valueHelpRequest=".openWarehouseValueHelp"
              value="{filter>/DeliveryLocationCode}"
              >
            </Input>
        </fb:control>
      </fb:FilterGroupItem>

      <fb:FilterGroupItem name="marketType" label="Tipo de Mercado" groupName="GroupMarketType" visibleInFilterBar="true">
        <fb:control>
            <Select 
              forceSelection="false"
              selectedKey="{
                path: 'filter>/MarketType',
                type: 'sap.ui.model.type.String'
              }"
            >
              <core:ListItem key="Internal" text="Interno"/>
              <core:ListItem key="External" text="Exportação"/>
            </Select>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="standardCashFlowDateFrom" label="Prev. Pagto. de" groupName="GroupStandardCashFlowDateFrom" visibleInFilterBar="true">
        <fb:control>
           <DatePicker
            value="{
              path: 'filter>/StandardCashFlowDateFrom',
              type: 'sap.ui.model.type.String'
            }"
            displayFormat="dd/MM/yyyy"
            valueFormat="yyyy-MM-dd"
           />
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="standardCashFlowDateTo" label="Prev. Pagto. até" groupName="GroupStandardCashFlowDateTo" visibleInFilterBar="true">
        <fb:control>
           <DatePicker
            value="{
              path: 'filter>/StandardCashFlowDateTo',
              type: 'sap.ui.model.type.String'
            }"
            displayFormat="dd/MM/yyyy"
            valueFormat="yyyy-MM-dd"
           />
        </fb:control>
      </fb:FilterGroupItem>
    </fb:filterGroupItems>
  </fb:FilterBar>
</core:FragmentDefinition>
