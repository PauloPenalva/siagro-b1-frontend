<mvc:View
	controllerName="siagrob1.controller.accountingPeriods.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">

	<Page title="Calendário Contábil" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<MessageStrip
				text="Período fechado ou bloqueado não aceita lançamento contábil com data dentro dele. Fechar segue a ordem dos meses; reabrir um mês fechado exige motivo e o papel ADMIN."
				type="Information"
				showIcon="true"
				class="sapUiSmallMargin" />
			<OverflowToolbar class="sapUiSmallMarginBeginEnd">
				<Label text="Exercício" labelFor="periodYear" />
				<StepInput id="periodYear" width="8rem" min="2000" max="2100" value="{calendar>/Year}" change=".onYearChange" />
				<Button text="Gerar exercício" icon="sap-icon://create" press=".onGenerateYear" />
			</OverflowToolbar>
			<t:Table
				id="accountingPeriodsTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/AccountingPeriods',
					sorter: [ { path: 'Year' }, { path: 'Month' } ]
				}">
				<t:columns>
					<t:Column label="Mês" width="6rem" hAlign="Center">
						<t:template><Text text="{ parts: [ 'Month', 'Year' ], formatter: '.monthText' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Início" width="7rem" hAlign="Center">
						<t:template><Text text="{ path: 'StartDate', type: 'sap.ui.model.odata.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Fim" width="7rem" hAlign="Center">
						<t:template><Text text="{ path: 'EndDate', type: 'sap.ui.model.odata.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Situação" width="7rem">
						<t:template>
							<ObjectStatus
								text="{= ${Status} === 'Closed' ? 'Fechado' : ${Status} === 'Blocked' ? 'Bloqueado' : 'Aberto' }"
								state="{= ${Status} === 'Closed' ? 'Warning' : ${Status} === 'Blocked' ? 'Error' : 'Success' }" />
						</t:template>
					</t:Column>
					<t:Column label="Fechado em" width="9rem" hAlign="Center">
						<t:template><Text text="{ path: 'ClosedAt', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { precision: 7 }, formatOptions: { pattern: 'dd/MM/yyyy HH:mm' } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Fechado por" width="8rem">
						<t:template><Text text="{ClosedBy}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Reaberto em" width="9rem" hAlign="Center">
						<t:template><Text text="{ path: 'ReopenedAt', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { precision: 7 }, formatOptions: { pattern: 'dd/MM/yyyy HH:mm' } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Reaberto por" width="8rem">
						<t:template><Text text="{ReopenedBy}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Motivo da reabertura" width="18rem">
						<t:template><Text text="{ReopenReason}" wrapping="false" tooltip="{ReopenReason}" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Fechar" icon="sap-icon://locked" type="Emphasized" press=".onClosePeriod" />
				<Button text="Bloquear" icon="sap-icon://private" press=".onBlockPeriod" />
				<Button text="Reabrir" icon="sap-icon://unlocked" press=".onReopenPeriod" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
