<mvc:View
	controllerName="siagrob1.controller.fiscalInventoryOpeningBalances.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Saldo inicial do estoque fiscal" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<MessageStrip
				text="Saldo inicial valorizado por filial e produto: é a camada mais antiga do Kardex Fiscal (PEPS), na data do saldo. Movimentos até essa data são ignorados pelo Kardex. Um lançamento por filial e produto."
				type="Information"
				showIcon="true"
				class="sapUiSmallMargin" />
			<t:Table
				id="openingBalancesTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/FiscalInventoryOpeningBalances',
					sorter: [ { path: 'BranchCode' }, { path: 'ItemCode' } ]
				}">
				<t:columns>
					<t:Column label="Filial" width="7rem">
						<t:template><Text text="{BranchCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Produto" width="9rem">
						<t:template><Text text="{ItemCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Descrição" width="20rem">
						<t:template><Text text="{ItemName}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Data do saldo" width="8rem" hAlign="Center">
						<t:template><Text text="{ path: 'BalanceDate', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { precision: 7 }, formatOptions: { pattern: 'dd/MM/yyyy' } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="UM" width="4rem">
						<t:template><Text text="{UnitOfMeasureCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Quantidade" width="9rem" hAlign="End">
						<t:template><Text text="{ path: 'Quantity', type: 'sap.ui.model.odata.type.Decimal', constraints: { precision: 19, scale: 3 }, formatOptions: { decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.', minFractionDigits: 3, maxFractionDigits: 3 } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Valor total" width="9rem" hAlign="End">
						<t:template><Text text="{ path: 'TotalValue', type: 'sap.ui.model.odata.type.Decimal', constraints: { precision: 19, scale: 2 }, formatOptions: { decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.', minFractionDigits: 2, maxFractionDigits: 2 } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Custo unitário" width="9rem" hAlign="End">
						<t:template>
							<Text text="{ parts: [ 'Quantity', 'TotalValue' ], formatter: '.unitCost' }" wrapping="false" />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate" />
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit" />
				<Button text="Excluir" icon="sap-icon://delete" press=".onDelete" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
