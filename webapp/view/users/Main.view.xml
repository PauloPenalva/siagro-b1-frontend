<mvc:View
	controllerName="siagrob1.controller.users.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Usuários">
		<content>
      <t:Table
				id="tableUsers"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/Users'
				}"
			>
				<t:extension>
					<OverflowToolbar >
            <ToolbarSpacer />
						<SearchField placeholder="Pesquisar..." width="30%" search=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column
						label="Usuário"
						sortProperty="Username"
						filterProperty="Username"
            visible="true"
            width="10rem"
						>
						<t:template>
							<Text text="{Username}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Nome"
						sortProperty="FullName"
						filterProperty="FullName"
						>
						<t:template>
							<Text text="{FullName}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Email"
						sortProperty="Email"
						filterProperty="Email"
						>
						<t:template>
							<Text text="{Email}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Ativo ?"
						sortProperty="IsActive"
						filterProperty="IsActive"
						>
						<t:template>
							<CheckBox selected="{IsActive}" />
						</t:template>
					</t:Column>
				</t:columns>

			</t:Table>
		</content>
    <footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit"/>
				<Button text="Deletar" icon="sap-icon://delete" press=".onDelete"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
