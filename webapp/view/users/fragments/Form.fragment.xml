<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="userForm"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Dados do Usuário"
              emphasized="true"
          />
          <Label text="Usuário" />
          <Input
              value="{Username}"
              required="true"
              maxLength="50"
              liveChange=".validateField"
              editable="false"
          />
          <!--
              Em modo SAPB1 nome e e-mail vêm do cadastro do SAP (OUSR): editá-los aqui só
              produziria uma alteração que a próxima sincronização desfaz.
          -->
          <Label text="Nome" />
          <Input
              value="{FullName}"
              editable="{= ${sessionModel>/erp} !== 'SAPB1' }"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <!--
              E-mail não é obrigatório: o OUSR do SAP também não o exige, e mais da metade dos
              usuários espelhados de lá está sem endereço. Marcá-lo como obrigatório aqui - onde
              ele ainda por cima é somente-leitura em modo SAPB1 - travaria o Save desses
              usuários sem dar ao operador nenhuma forma de destravar.
          -->
          <Label text="Email" />
          <Input
              value="{Email}"
              editable="{= ${sessionModel>/erp} !== 'SAPB1' }"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Ativo ?" />
          <CheckBox
              selected="{IsActive}"
              required="true"
          />
        </f:content>
        <core:Title />
        <core:Title />
    </f:SimpleForm>
</core:FragmentDefinition>
