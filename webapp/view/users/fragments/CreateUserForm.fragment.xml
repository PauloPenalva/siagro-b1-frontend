<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="createUserForm"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Criar Novo Usuário"
              emphasized="true"
          />
          <Label text="Usuário" />
          <Input
              value="{Username}"
              required="true"
              maxLength="50"
              liveChange=".validateField"
          />
          <Label text="Nome" />
          <Input
              value="{FullName}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Email" />
          <Input
              value="{Email}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Senha" />
          <Input
              value="{Password}"
              editable="true"
              required="true"
              liveChange=".validateField"
              type="Password"
              maxLength="100"
          />
          <Label text="Ativo ?" />
          <CheckBox
              selected="{IsActive}"
              required="true"
          />
        </f:content>
        <core:Title />
        <core:Title />
    </f:SimpleForm>
</core:FragmentDefinition>
