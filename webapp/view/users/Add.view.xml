<mvc:View
	controllerName="siagrob1.controller.users.Add"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.ui.layout.form"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Usuário">
		<content>
      <core:Fragment fragmentName="siagrob1.view.users.fragments.CreateUserForm" type="XML" />
       <IconTabBar>
        <items>
          <IconTabFilter text="Perfis">
            <content>
              <core:Fragment fragmentName="siagrob1.view.users.fragments.Profiles" type="XML" />
            </content>
          </IconTabFilter>
        </items>
      </IconTabBar>
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="Cancelar" press=".onCancel"  />
				<Button text="Salvar" type="Emphasized" press=".onSave"/>
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
