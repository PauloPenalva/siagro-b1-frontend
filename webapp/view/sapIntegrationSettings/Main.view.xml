<mvc:View
	controllerName="siagrob1.controller.sapIntegrationSettings.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Integração SAP" busy="{ui>/busy}" busyIndicatorDelay="0">
		<content>
			<MessageStrip
				text="Disponível somente com integração SAP Business One."
				type="Warning" showIcon="true" class="sapUiSmallMargin"
				visible="{= ${sap>/SapMode} !== true }" />
			<MessageStrip
				text="O SAP é quem cancela as notas fiscais vinculadas. A sincronização marca os documentos de saída cuja nota foi cancelada no SAP como Canc. SAP pendente, para o usuário cancelar no Siagro."
				type="Information" showIcon="true" class="sapUiSmallMargin"
				visible="{= ${sap>/SapMode} === true }" />
			<f:Form id="sapIntegrationSettingsForm" editable="true">
				<f:layout>
					<f:ColumnLayout columnsM="1" columnsL="1" columnsXL="2" />
				</f:layout>
				<f:formContainers>
					<f:FormContainer title="Sincronização de notas fiscais">
						<f:formElements>
							<f:FormElement label="Sincronizar cancelamentos do SAP">
								<Switch state="{sap>/InvoiceSyncEnabled}" enabled="{= ${sap>/SapMode} === true }" />
							</f:FormElement>
							<f:FormElement label="Intervalo (minutos)">
								<StepInput value="{sap>/InvoiceSyncIntervalMinutes}" min="1" max="1440" step="1"
									enabled="{= ${sap>/SapMode} === true }" />
							</f:FormElement>
							<f:FormElement label="Última execução">
								<Text text="{= ${sap>/InvoiceSyncLastRunAt} ? ${path: 'sap>/InvoiceSyncLastRunAt', formatter: '.formatter.formatDateTime'} : 'Nunca' }" />
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>
		</content>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer />
				<Button text="Sincronizar agora" icon="sap-icon://synchronize" press=".onRunNow"
					enabled="{= ${sap>/SapMode} === true }" />
				<Button text="Salvar" type="Emphasized" icon="sap-icon://save" press=".onSave"
					enabled="{= ${sap>/SapMode} === true }" />
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
