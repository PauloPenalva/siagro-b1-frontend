<mvc:View
	controllerName="siagrob1.controller.login.ResetPassword"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

  <Page showHeader="false" class="sapUiResponsiveContentPadding" busy="{ui>/busy}" busyIndicatorDelay="0">
    <content>
      <VBox fitContainer="true" justifyContent="Center" alignItems="Center" alignContent="Center">
        <items>
          <VBox fitContainer="true" justifyContent="Center" alignItems="Center" alignContent="Center">
            <items>
              <Image
                class="sapUiSmallMarginBottom"
                src="/assets/logo_siagro_principal.png"
                height="40px"
                width="80px"/>
              <Title text="Definir nova senha" level="H4" class="sapUiSmallMarginBottom"/>

              <!-- Token já validado: só então o formulário aparece. -->
              <VBox visible="{= ${reset>/valid} === true &amp;&amp; !${reset>/done} }">
                <items>
                  <Label text="Nova senha:" required="true"/>
                  <Input
                    value="{reset>/NewPassword}"
                    type="Password"
                    width="250px"
                    submit=".onConfirm"
                    showClearIcon="true"/>
                  <Label text="Confirme a nova senha:" required="true"/>
                  <Input
                    value="{reset>/ConfirmPassword}"
                    type="Password"
                    width="250px"
                    submit=".onConfirm"
                    showClearIcon="true"/>
                  <Text
                    text="{reset>/passwordRequirements}"
                    width="250px"
                    class="sapUiTinyMarginTop"/>
                  <Button
                    text="Salvar nova senha"
                    width="250px"
                    press=".onConfirm"
                    type="Emphasized"
                    class="sapUiSmallMarginTop"/>
                </items>
              </VBox>

              <VBox visible="{= ${reset>/valid} === false }" width="300px">
                <items>
                  <MessageStrip
                    type="Error"
                    showIcon="true"
                    text="Este link de redefinição é inválido ou já expirou. Solicite um novo."/>
                  <Button
                    text="Solicitar novo link"
                    press=".onRequestNewLink"
                    class="sapUiSmallMarginTop"/>
                </items>
              </VBox>

              <VBox visible="{reset>/done}" width="300px">
                <items>
                  <MessageStrip
                    type="Success"
                    showIcon="true"
                    text="Senha redefinida com sucesso. Entre com a nova senha."/>
                </items>
              </VBox>

              <Link
                text="Voltar para o login"
                press=".onBackToLogin"
                width="250px"
                textAlign="Center"
                class="sapUiSmallMarginTop"/>
            </items>
          </VBox>
        </items>
      </VBox>
    </content>
  </Page>
</mvc:View>
