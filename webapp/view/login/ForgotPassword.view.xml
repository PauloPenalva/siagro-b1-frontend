<mvc:View
	controllerName="siagrob1.controller.login.ForgotPassword"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

  <Page showHeader="false" class="sapUiResponsiveContentPadding" busy="{ui>/busy}" busyIndicatorDelay="0">
    <content>
      <VBox fitContainer="true" justifyContent="Center" alignItems="Center" alignContent="Center">
        <items>
          <VBox fitContainer="true" justifyContent="Center" alignItems="Center" alignContent="Center">
            <items>
              <Image
                class="sapUiSmallMarginBottom"
                src="/assets/logo_siagro_principal.png"
                height="40px"
                width="80px"/>
              <Title text="Recuperar senha" level="H4"/>
              <Title
                text="Informe seu usuário ou e-mail para receber o link de redefinição"
                level="H5"
                class="sapUiSmallMarginBottom"/>

              <!--
                Uma tela só, com dois estados: o formulário some depois do envio e dá lugar à
                confirmação, para não convidar o usuário a pedir o link várias vezes.
              -->
              <VBox visible="{= !${forgot>/sent} }">
                <items>
                  <Label text="Usuário ou e-mail:" required="true"/>
                  <Input
                    value="{forgot>/UsernameOrEmail}"
                    placeholder="Usuário ou e-mail..."
                    width="250px"
                    submit=".onSend"
                    showClearIcon="true"/>
                  <Button
                    text="Enviar link"
                    width="250px"
                    press=".onSend"
                    type="Emphasized"
                    class="sapUiSmallMarginTop"/>
                </items>
              </VBox>

              <VBox visible="{forgot>/sent}" width="300px">
                <items>
                  <MessageStrip
                    type="Success"
                    showIcon="true"
                    text="{forgot>/message}"/>
                  <Text
                    text="O link vale por 30 minutos e só pode ser usado uma vez."
                    class="sapUiSmallMarginTop"/>
                </items>
              </VBox>

              <Link
                text="Voltar para o login"
                press=".onBackToLogin"
                width="250px"
                textAlign="Center"
                class="sapUiSmallMarginTop"/>
            </items>
          </VBox>
        </items>
      </VBox>
    </content>
  </Page>
</mvc:View>
