<mvc:View
	controllerName="siagrob1.controller.shipmentLoads.Edit"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="{form>/title}" showNavButton="true" navButtonPress=".onNavBack" busy="{ui>/busy}" busyIndicatorDelay="0">
		<content>
			<core:Fragment fragmentName="siagrob1.view.shipmentLoads.fragments.LoadForm" type="XML"/>
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer/>
				<Button text="Cancelar" press=".onCancel"/>
				<Button text="Salvar" type="Emphasized" press=".onSave"/>
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
