<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">
	<!-- Transbordos da carga (GAC-1181): a mercadoria é descarregada num armazém intermediário e
	     recarregada dali, sem que a viagem vire duas cargas. Só aparece na carga Normal — a
	     Remoção não tem transbordo (ShipmentLoadTransshipmentRules.EnsureLoadAcceptsTransshipment),
	     e é o próprio Detail.view.xml que esconde a seção inteira nesse caso.

	     `$$ownRequest` é obrigatório: sem ele a coleção vira $expand do GET da carga e o
	     refresh() depois de gravar não recarrega nada. Mesmo motivo do `loadDischargesTable`.

	     `$select` explícito pela mesma armadilha das Descargas: `Comments` não tem coluna própria
	     aqui, mas entra na lista porque uma coluna invisível NÃO cria binding neste projeto — se
	     algum dia o controller precisar dele (ex.: tooltip), o campo já chega pronto.

	     `Situação` é derivada no cliente a partir de `EntryStorageTransactionKey`,
	     `LotExitStorageTransactionKey` (GAC-1181 fase 2 — direto no registro, sem cruzamento
	     nenhum; gravado pelo próprio armazém ao confirmar a pesagem de saída do romaneio, não mais
	     por uma ação do escritório na carga) e de `viewModel>/transshipmentLinkage/linkedKeys`
	     (Task 11): o backend
	     não expõe, num único campo, se a Expedição de venda já foi vinculada a este transbordo —
	     esse vínculo por papel é `ShipmentLoadsAttachTransactions` com `TransshipmentKey`, e
	     `linkedKeys` é montado por `BaseController#refreshTransshipmentLinkage` cruzando os
	     romaneios da carga (`ShipmentLoadKey` gravado) contra os transbordos — por isso NÃO
	     enxerga a saída do lote, que fica só com `ShipmentLoadTransshipmentKey`, sem
	     `ShipmentLoadKey`. Os quatro estados (Aguardando entrada / Aguardando saída / Aguardando
	     expedição / Concluído) são alcançáveis por aqui. -->
	<t:Table
		id="loadTransshipmentsTable"
		class="sapUiSizeCondensed"
		alternateRowColors="true"
		enableBusyIndicator="true"
		enableSelectAll="false"
		selectionMode="Single"
		selectionBehavior="Row"
		busyIndicatorDelay="0"
		visibleRowCount="5"
		noData="Nenhum transbordo registrado nesta carga."
		rows="{
			path: 'Transshipments',
			parameters: {
				'$$ownRequest': true,
				'$select': 'Key,Sequence,Origin,WarehouseCode,WarehouseName,TransshipmentDate,OutgoingQuantity,EntryQuantity,ShrinkageQuantity,EntryStorageTransactionKey,LotExitStorageTransactionKey,Comments'
			},
			sorter: { path: 'Sequence' }
		}">
		<t:extension>
			<OverflowToolbar>
				<content>
					<Title text="Transbordos"/>
					<ToolbarSpacer/>
					<!-- Espelha EnsureLoadAcceptsTransshipment + EnsureIsLastAsync: carga encerrada não
					     aceita transbordo, e um transbordo já aberto (Status InTransshipment) bloqueia
					     o início de outro. `targetType: 'any'` em toda expressão sobre enum, senão o
					     valor não chega como string e a comparação nunca casa. -->
					<Button
						type="Transparent"
						text="Iniciar Transbordo"
						icon="sap-icon://add"
						visible="{= ${path: 'Status', targetType: 'any'} !== 'Cancelled' &amp;&amp; ${path: 'Status', targetType: 'any'} !== 'Returned' &amp;&amp; ${path: 'Status', targetType: 'any'} !== 'Completed' &amp;&amp; ${path: 'Status', targetType: 'any'} !== 'InTransshipment' &amp;&amp; ${path: 'Status', targetType: 'any'} !== 'Discharged' }"
						press=".onStartTransshipment"/>
					<!-- Registrar Entrada/Estornar só fazem sentido enquanto HÁ transbordo aberto —
					     exatamente quando a carga está InTransshipment. Mesma convenção do vizinho: o
					     botão fica visível pelo Status da CARGA (não há como amarrar visibilidade ao
					     transbordo selecionado sem um listener de seleção, que este módulo não usa em
					     lugar nenhum), e quem valida o registro escolhido é o handler no clique — igual
					     a onRegisterTransshipmentEntry, que já alerta se a entrada estiver registrada
					     demais. Vincular a saída do lote NÃO é mais um botão daqui: desde a fase 2, o
					     próprio armazém grava LotExitStorageTransactionKey ao confirmar a pesagem de
					     saída do romaneio — sem ação nenhuma do escritório na carga. -->
					<Button
						type="Transparent"
						text="Registrar Entrada"
						icon="sap-icon://accept"
						visible="{= ${path: 'Status', targetType: 'any'} === 'InTransshipment' }"
						press=".onRegisterTransshipmentEntry"/>
					<Button
						type="Transparent"
						text="Estornar"
						icon="sap-icon://undo"
						visible="{= ${path: 'Status', targetType: 'any'} === 'InTransshipment' }"
						press=".onReverseTransshipment"/>
				</content>
			</OverflowToolbar>
		</t:extension>
		<t:columns>
			<t:Column label="Seq." hAlign="Center" width="5rem">
				<t:template><Text text="{Sequence}" wrapping="false"/></t:template>
			</t:Column>
			<t:Column label="Origem" width="9rem">
				<t:template>
					<Text wrapping="false" text="{ path: 'Origin', targetType: 'any', formatter: '.formatter.formatTransshipmentOrigin' }"/>
				</t:template>
			</t:Column>
			<t:Column label="Armazém" width="16rem">
				<t:template><Text text="({WarehouseCode}) {WarehouseName}" wrapping="false"/></t:template>
			</t:Column>
			<t:Column label="Data" width="8rem">
				<t:template>
					<Text wrapping="false" text="{ path: 'TransshipmentDate', targetType: 'any', formatter: '.formatter.formatDate' }"/>
				</t:template>
			</t:Column>
			<t:Column label="Saída" hAlign="End" width="9rem">
				<t:template>
					<ObjectNumber
						textAlign="End"
						number="{ path: 'OutgoingQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"/>
				</t:template>
			</t:Column>
			<t:Column label="Entrada" hAlign="End" width="9rem">
				<t:template>
					<ObjectNumber
						textAlign="End"
						number="{ path: 'EntryQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"/>
				</t:template>
			</t:Column>
			<t:Column label="Quebra" hAlign="End" width="9rem">
				<t:template>
					<ObjectNumber
						textAlign="End"
						number="{ path: 'ShrinkageQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"/>
				</t:template>
			</t:Column>
			<t:Column label="Situação" width="11rem">
				<t:template>
					<Text wrapping="false" text="{
						parts: [
							{ path: 'EntryStorageTransactionKey', targetType: 'any' },
							{ path: 'LotExitStorageTransactionKey', targetType: 'any' },
							{ path: 'Key', targetType: 'any' },
							{ path: 'viewModel>/transshipmentLinkage/linkedKeys', targetType: 'any' }
						],
						formatter: '.formatter.formatTransshipmentStatus'
					}"/>
				</t:template>
			</t:Column>
		</t:columns>
	</t:Table>
</core:FragmentDefinition>
