<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.ui.layout.form">
	<Dialog
		id="changeReleaseDialog"
		title="{= ${changeRelease>/IsSwap} ? 'Inverter Liberações' : 'Trocar Liberação' }"
		contentWidth="76rem"
		class="sapUiSizeCompact"
		busy="{changeRelease>/busy}"
		busyIndicatorDelay="0">
		<content>
			<!-- A troca em si: gera estorno na origem e nova Expedição no destino, com a data da
			     carga; o total da carga pode ajustar pela regra da quantidade. -->
			<MessageStrip
				text="A troca gera um estorno na origem e uma nova Expedição no destino, com a data da carga. Se a carga tiver uma única Expedição vigente, a nova Expedição recebe a quantidade faturada da carga."
				type="Information"
				showIcon="true"
				class="sapUiSmallMarginBottom"/>

			<!-- Situação atual de cada romaneio selecionado e, na inversão, o destino de cada um. -->
			<t:Table
				id="changeReleaseRowsTable"
				class="sapUiSizeCondensed sapUiSmallMarginBottom"
				selectionMode="None"
				alternateRowColors="true"
				visibleRowCountMode="Fixed"
				visibleRowCount="2"
				noData="Nenhum romaneio selecionado."
				rows="{changeRelease>/Rows}">
				<t:extension>
					<OverflowToolbar><Title text="Romaneios"/></OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column id="changeReleaseRowsCodeColumn" width="8rem" sortProperty="Code" filterProperty="Code">
						<Label text="Romaneio"/>
						<t:template><Text text="{changeRelease>Code}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseRowsWeightColumn" width="9rem" hAlign="End" sortProperty="GrossWeight" filterProperty="GrossWeight" filterType="sap.ui.model.type.Float">
						<Label text="Peso Bruto"/>
						<t:template>
							<ObjectNumber
								number="{ path: 'changeRelease>GrossWeight', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"/>
						</t:template>
					</t:Column>
					<t:Column id="changeReleaseRowsContractColumn" width="14rem" sortProperty="ContractText" filterProperty="ContractText">
						<Label text="Contrato Atual"/>
						<t:template><Text text="{changeRelease>ContractText}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseRowsNewContractColumn" width="14rem" visible="{changeRelease>/IsSwap}" sortProperty="NewContractText" filterProperty="NewContractText">
						<Label text="Novo Contrato"/>
						<t:template><Text text="{changeRelease>NewContractText}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseRowsWarehouseColumn" width="14rem" sortProperty="WarehouseText" filterProperty="WarehouseText">
						<Label text="Armazém Atual"/>
						<t:template><Text text="{changeRelease>WarehouseText}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseRowsNewWarehouseColumn" width="14rem" visible="{changeRelease>/IsSwap}" sortProperty="NewWarehouseText" filterProperty="NewWarehouseText">
						<Label text="Novo Armazém"/>
						<t:template><Text text="{changeRelease>NewWarehouseText}" wrapping="false"/></t:template>
					</t:Column>
				</t:columns>
			</t:Table>

			<!-- Troca simples: escolher a liberação de destino. Na inversão o destino é o outro romaneio. -->
			<t:Table
				id="changeReleaseTargets"
				class="sapUiSizeCondensed sapUiSmallMarginBottom"
				visible="{= !${changeRelease>/IsSwap} }"
				selectionMode="Single"
				selectionBehavior="RowSelector"
				alternateRowColors="true"
				visibleRowCountMode="Fixed"
				visibleRowCount="6"
				filter=".onChangeReleaseTargetsFilterOrSort"
				sort=".onChangeReleaseTargetsFilterOrSort"
				noData="Nenhuma outra liberação ativa com saldo para este produto, em qualquer armazém."
				rows="{changeRelease>/Targets}">
				<t:extension>
					<OverflowToolbar><Title text="Liberação de Destino"/></OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column id="changeReleaseTargetsContractColumn" width="8rem" sortProperty="PurchaseContractCode" filterProperty="PurchaseContractCode">
						<Label text="Contrato"/>
						<t:template><Text text="{changeRelease>PurchaseContractCode}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseTargetsPaymentColumn" width="8rem" sortProperty="StandardCashFlowDate" filterProperty="StandardCashFlowDateText">
						<Label text="Prev. Pagto."/>
						<t:template><Text text="{changeRelease>StandardCashFlowDateText}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseTargetsOriginColumn" width="9rem" sortProperty="OriginText" filterProperty="OriginText">
						<Label text="Origem"/>
						<t:template><Text text="{changeRelease>OriginText}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseTargetsSupplierColumn" width="14rem" sortProperty="FName" filterProperty="FName">
						<Label text="Fornecedor"/>
						<t:template><Text text="{changeRelease>FName}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseTargetsWarehouseColumn" width="14rem" sortProperty="DeliveryLocationText" filterProperty="DeliveryLocationText">
						<Label text="Armazém"/>
						<t:template><Text text="{changeRelease>DeliveryLocationText}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="changeReleaseTargetsBalanceColumn" width="9rem" hAlign="End" sortProperty="AvailableQuantity" filterProperty="AvailableQuantity" filterType="sap.ui.model.type.Float">
						<Label text="Saldo"/>
						<t:template>
							<ObjectNumber
								number="{ path: 'changeRelease>AvailableQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"
								unit="{changeRelease>UnitOfMeasureCode}"/>
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>

			<f:Form editable="true">
				<f:layout><f:ColumnLayout columnsM="1" columnsL="1" columnsXL="1"/></f:layout>
				<f:formContainers>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="Motivo">
								<f:fields>
									<TextArea
										value="{changeRelease>/Reason}"
										required="true"
										rows="3"
										maxLength="500"
										width="100%"
										placeholder="Ex.: relatório do armazém, ordem do financeiro"/>
								</f:fields>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>
		</content>
		<beginButton>
			<Button type="Emphasized" text="Confirmar" press=".onConfirmChangeRelease"/>
		</beginButton>
		<endButton>
			<Button text="Cancelar" press=".onCloseChangeRelease"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
