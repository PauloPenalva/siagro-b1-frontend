<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
>
<!--
  Filtros da aba Cargas. Só colunas NÃO-numéricas entram aqui — Qtd. Total, Qtd. Faturada e Saldo
  ficam de fora de propósito.

  Status é ENUM e aceita VÁRIAS situações: o MultiComboBox grava um array em filterLoads>/Status e
  o controller o transforma num grupo `(Status eq 'A' or Status eq 'B')` em string crua, porque
  sap.ui.model.Filter sobre enum estoura "Unsupported type" — ver applyFilters em
  Main.controller.ts. Nada selecionado = todas as situações, por isso não há mais item "Todos".

  Filial usa o JSONModel "branches" (carregado uma vez em Main.controller#loadBranches), não bind
  direto em /Branchs — ver o comentário de loadBranches para o motivo (resume() da FilterBar sobre
  binding suspenso).

  Motorista, Transportadora e Armazém gravam CÓDIGO pelo value help, então entram como `eq` em
  applyFilters (exactMatchFields), e não como `contains`.
-->
<fb:FilterBar search=".onSearchLoadFilters" showClearOnFB="true" clear=".onClearLoadFilters">
  <fb:filterGroupItems>
    <fb:FilterGroupItem name="code" label="Código" groupName="GroupCode" visibleInFilterBar="true">
      <fb:control>
        <Input showClearIcon="true" value="{filterLoads>/Code}" />
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="dateFrom" label="Data de" groupName="GroupDateFrom" visibleInFilterBar="true">
      <fb:control>
        <DatePicker
          value="{
            path: 'filterLoads>/DateFrom',
            type: 'sap.ui.model.type.String'
          }"
          displayFormat="dd/MM/yyyy"
          valueFormat="yyyy-MM-dd"
        />
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="dateTo" label="Data até" groupName="GroupDateTo" visibleInFilterBar="true">
      <fb:control>
        <DatePicker
          value="{
            path: 'filterLoads>/DateTo',
            type: 'sap.ui.model.type.String'
          }"
          displayFormat="dd/MM/yyyy"
          valueFormat="yyyy-MM-dd"
        />
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="status" label="Situação" groupName="GroupStatus" visibleInFilterBar="true">
      <fb:control>
        <MultiComboBox
          width="100%"
          selectedKeys="{filterLoads>/Status}"
          items="{path: 'loadStatuses>/items', templateShareable: false}"
        >
          <core:Item key="{loadStatuses>key}" text="{loadStatuses>text}"/>
        </MultiComboBox>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="branchCode" label="Filial" groupName="GroupBranchCode" visibleInFilterBar="true">
      <fb:control>
        <Select
          id="branchCodeSelectLoads"
          forceSelection="false"
          selectedKey="{filterLoads>/BranchCode}"
          items="{branches>/}">
          <core:ListItem key="{branches>Code}" text="{branches>ShortName}"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="truck" label="Veículo" groupName="GroupTruck" visibleInFilterBar="true">
      <fb:control>
        <Input
          showClearIcon="true"
          showValueHelp="true"
          valueHelpRequest=".openTrucksValueHelp"
          value="{filterLoads>/TruckCode}"
          />
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="truckDriver" label="Motorista" groupName="GroupTruckDriver" visibleInFilterBar="true">
      <fb:control>
        <Input
          showClearIcon="true"
          showValueHelp="true"
          valueHelpRequest=".openTruckDriversValueHelp"
          value="{filterLoads>/TruckDriverCode}"
          />
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="carrier" label="Transportadora" groupName="GroupCarrier" visibleInFilterBar="true">
      <fb:control>
        <Input
          showClearIcon="true"
          showValueHelp="true"
          valueHelpRequest=".openSuppliersValueHelp"
          value="{filterLoads>/CarrierCardCode}"
          />
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="warehouse" label="Armazém" groupName="GroupWarehouse" visibleInFilterBar="true">
      <fb:control>
        <Input
          showClearIcon="true"
          showValueHelp="true"
          valueHelpRequest=".openWarehouseValueHelp"
          value="{filterLoads>/WarehouseCode}"
          />
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="item" label="Produto" groupName="GroupItem" visibleInFilterBar="true">
      <fb:control>
        <Input
          showClearIcon="true"
          showValueHelp="true"
          valueHelpRequest=".openItemValueHelp"
          value="{filterLoads>/ItemCode}"
          />
      </fb:control>
    </fb:FilterGroupItem>
  </fb:filterGroupItems>
</fb:FilterBar>
</core:FragmentDefinition>
