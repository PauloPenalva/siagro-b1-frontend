<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.ui.layout.form">
	<Dialog
		id="shipDialog"
		title="Expedir na carga {ship>/LoadCode}"
		contentWidth="60rem"
		busyIndicatorDelay="0"
		busy="{ui>/busy}"
		class="sapUiSizeCompact">
		<content>
			<t:Table
				id="shipReleasesTable"
				class="sapUiSizeCondensed"
				selectionMode="Single"
				selectionBehavior="RowSelector"
				alternateRowColors="true"
				visibleRowCountMode="Fixed"
				visibleRowCount="6"
				filter=".onShipReleasesFilterOrSort"
				sort=".onShipReleasesFilterOrSort"
				noData="Nenhuma liberação de embarque com saldo para este produto e armazém."
				rows="{shipReleases>/}">
				<t:columns>
					<t:Column id="shipReleasesContractColumn" width="9rem" sortProperty="PurchaseContractCode" filterProperty="PurchaseContractCode">
						<Label text="Contrato"/>
						<t:template><Text text="{shipReleases>PurchaseContractCode}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="shipReleasesSupplierColumn" width="18rem" sortProperty="FName" filterProperty="FName">
						<Label text="Fornecedor"/>
						<t:template><Text text="{shipReleases>FName}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="shipReleasesOriginColumn" width="12rem" sortProperty="Origin" filterProperty="Origin">
						<Label text="Origem"/>
						<t:template><Text text="{ path: 'shipReleases>Origin', formatter: '.formatter.releaseOriginText' }" wrapping="false"/></t:template>
					</t:Column>
					<t:Column id="shipReleasesBalanceColumn" width="10rem" hAlign="End" sortProperty="AvailableQuantity" filterProperty="AvailableQuantity" filterType="sap.ui.model.type.Float">
						<Label text="Saldo"/>
						<t:template>
							<ObjectNumber
								number="{ path: 'shipReleases>AvailableQuantity', type: 'sap.ui.model.type.Float', formatOptions: { maxFractionDigits: 3 } }"
								unit="{shipReleases>UnitOfMeasureCode}"/>
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
			<f:Form id="shipForm" editable="true">
				<f:layout>
					<f:ColumnLayout columnsM="2" columnsL="2" columnsXL="2"/>
				</f:layout>
				<f:formContainers>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="Armazém">
								<f:fields>
									<Input
										value="{ship>/WarehouseCode}"
										description="{ship>/WarehouseName}"
										required="true"
										showValueHelp="true"
										valueHelpOnly="true"
										valueHelpRequest=".openWarehouseValueHelp">
										<customData>
											<core:CustomData key="descriptionProperty" value="WarehouseName:Name"/>
										</customData>
									</Input>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Motorista">
								<f:fields>
									<Input
										value="{ship>/TruckDriverCode}"
										description="{ship>/TruckDriverName}"
										required="true"
										showValueHelp="true"
										valueHelpOnly="true"
										valueHelpRequest=".openTruckDriversValueHelp">
										<customData>
											<core:CustomData key="descriptionProperty" value="TruckDriverName:Name"/>
										</customData>
									</Input>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Situação Royalty" visible="{ui>/royaltyVisible}">
								<f:fields>
									<Select forceSelection="true" selectedKey="{royalty>/RoyaltySituation}"
										tooltip="Vazio: Armazém Participante quando o armazém do carregamento é participante">
										<core:ListItem key="" text="(padrão do armazém)"/>
										<core:ListItem key="Declared" text="Declarada"/>
										<core:ListItem key="Tested" text="Testada"/>
										<core:ListItem key="Conventional" text="Convencional"/>
										<core:ListItem key="ParticipantWarehouse" text="Armazém Participante"/>
									</Select>
									<Input enabled="{= ${royalty>/RoyaltySituation} === 'Tested' }"
										required="{= ${royalty>/RoyaltySituation} === 'Tested' }"
										placeholder="Código do teste" maxLength="50" value="{royalty>/RoyaltyTestCode}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Data">
								<f:fields>
									<DatePicker
										value="{ship>/TransactionDate}"
										valueFormat="yyyy-MM-dd"
										displayFormat="dd/MM/yyyy"
										required="true"/>
								</f:fields>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="Peso bruto">
								<f:fields>
									<Input type="Number" value="{ship>/GrossWeight}" required="true"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Observação">
								<f:fields>
									<TextArea value="{ship>/Comments}" rows="3"/>
								</f:fields>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>
		</content>
		<beginButton>
			<Button text="Expedir" type="Emphasized" press=".onConfirmShip"/>
		</beginButton>
		<endButton>
			<Button text="Cancelar" press=".onCloseShip"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
