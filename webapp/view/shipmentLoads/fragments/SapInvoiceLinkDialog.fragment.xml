<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">
	<Dialog
		id="sapLinkDialog"
		title="Vincular NF do SAP"
		class="sapUiSizeCompact"
		contentWidth="75rem"
		resizable="true"
		draggable="true"
		busyIndicatorDelay="0">
		<content>
			<VBox class="sapUiSmallMargin">
				<HBox alignItems="End" wrap="Wrap">
					<VBox class="sapUiSmallMarginEnd">
						<Label text="De" labelFor="sapLinkDateFrom"/>
						<DatePicker
							id="sapLinkDateFrom"
							width="10rem"
							valueFormat="yyyy-MM-dd"
							displayFormat="dd/MM/yyyy"
							value="{sapLink>/DateFrom}"/>
					</VBox>
					<VBox class="sapUiSmallMarginEnd">
						<Label text="Até" labelFor="sapLinkDateTo"/>
						<DatePicker
							id="sapLinkDateTo"
							width="10rem"
							valueFormat="yyyy-MM-dd"
							displayFormat="dd/MM/yyyy"
							value="{sapLink>/DateTo}"/>
					</VBox>
					<Button text="Buscar" icon="sap-icon://search" press=".onSearch"/>
				</HBox>

				<t:Table
					id="sapLinkInvoicesTable"
					class="sapUiSmallMarginTop sapUiSizeCondensed"
					selectionMode="MultiToggle"
					selectionBehavior="RowSelector"
					alternateRowColors="true"
					visibleRowCountMode="Fixed"
					visibleRowCount="8"
					rowSelectionChange=".onInvoiceSelect"
					filter=".onInvoicesFilterOrSort"
					sort=".onInvoicesFilterOrSort"
					noData="Nenhuma nota fiscal do SAP disponível para esta carga neste período."
					rows="{ path: 'sapLink>/Invoices' }">
					<t:extension>
						<Toolbar><Title text="Notas fiscais do SAP"/></Toolbar>
					</t:extension>
					<t:columns>
						<t:Column id="sapLinkInvoicesDateColumn" width="7rem" sortProperty="DocDateSort" filterProperty="DocDateText">
							<Label text="Data"/>
							<t:template>
								<Text text="{sapLink>DocDateText}" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkInvoicesNumberColumn" width="10rem" sortProperty="InvoiceText" filterProperty="InvoiceText">
							<Label text="NF / Série"/>
							<t:template>
								<Text text="{sapLink>InvoiceText}" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkInvoicesCustomerColumn" width="16rem" sortProperty="CustomerText" filterProperty="CustomerText">
							<Label text="Cliente"/>
							<t:template>
								<Text text="{sapLink>CustomerText}" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkInvoicesQuantityColumn" width="9rem" hAlign="End" sortProperty="Quantity" filterProperty="Quantity" filterType="sap.ui.model.type.Float">
							<Label text="Quantidade (kg)"/>
							<t:template>
								<Text text="{ path: 'sapLink>Quantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkInvoicesPriceColumn" width="8rem" hAlign="End" sortProperty="UnitPrice" filterProperty="UnitPrice" filterType="sap.ui.model.type.Float">
							<Label text="Preço"/>
							<t:template>
								<Text text="{ path: 'sapLink>UnitPrice', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkInvoicesTotalColumn" width="9rem" hAlign="End" sortProperty="LineTotal" filterProperty="LineTotal" filterType="sap.ui.model.type.Float">
							<Label text="Total"/>
							<t:template>
								<Text text="{ path: 'sapLink>LineTotal', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkInvoicesCarrierColumn" width="9rem" sortProperty="CarrierCode" filterProperty="CarrierCode">
							<Label text="Transportadora"/>
							<t:template>
								<HBox alignItems="Center">
									<Text text="{sapLink>CarrierCode}" wrapping="false"/>
									<core:Icon
										class="sapUiTinyMarginBegin"
										src="sap-icon://alert"
										color="Critical"
										tooltip="Transportadora da NF diferente da carga"
										visible="{= ${sapLink>CarrierMismatch} === true }"/>
								</HBox>
							</t:template>
						</t:Column>
					</t:columns>
					<t:footer>
						<HBox alignItems="Center" wrap="Wrap">
							<ObjectStatus
								text="{sapLink>/SummaryText}"
								state="{= ${sapLink>/SumExceeds} === true ? 'Error' : (${sapLink>/SumBelow} === true ? 'Warning' : (${sapLink>/SumMatches} === true ? 'Success' : 'None')) }"/>
							<ObjectStatus
								class="sapUiSmallMarginBegin"
								text="A soma das notas fiscais é maior que o saldo da carga."
								state="Error"
								icon="sap-icon://error"
								visible="{= ${sapLink>/SumExceeds} === true }"/>
							<ObjectStatus
								class="sapUiSmallMarginBegin"
								text="A soma das notas fiscais é menor que o saldo da carga."
								state="Warning"
								icon="sap-icon://message-warning"
								visible="{= ${sapLink>/SumBelow} === true }"/>
							<ObjectStatus
								class="sapUiSmallMarginBegin"
								text="Selecione notas fiscais do mesmo cliente."
								state="Error"
								icon="sap-icon://error"
								visible="{= ${sapLink>/MixedCustomers} === true }"/>
						</HBox>
					</t:footer>
				</t:Table>

				<t:Table
					id="sapLinkReleasesTable"
					class="sapUiMediumMarginTop sapUiSizeCondensed"
					selectionMode="Single"
					selectionBehavior="RowSelector"
					alternateRowColors="true"
					visibleRowCountMode="Fixed"
					visibleRowCount="5"
					rowSelectionChange=".onReleaseSelect"
					filter=".onReleasesFilterOrSort"
					sort=".onReleasesFilterOrSort"
					noData="Nenhuma liberação de entrega disponível."
					rows="{ path: 'sapLink>/Releases' }">
					<t:extension>
						<Toolbar><Title text="Liberação de entrega"/></Toolbar>
					</t:extension>
					<t:columns>
						<t:Column id="sapLinkReleasesContractColumn" width="7rem" sortProperty="SalesContractCode" filterProperty="SalesContractCode">
							<Label text="Contrato"/>
							<t:template>
								<Text text="{sapLink>SalesContractCode}" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkReleasesComplementColumn" width="9rem" sortProperty="Complement" filterProperty="Complement">
							<Label text="Compl."/>
							<t:template>
								<Text text="{sapLink>Complement}" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkReleasesCustomerColumn" width="16rem" sortProperty="CustomerText" filterProperty="CustomerText">
							<Label text="Cliente"/>
							<t:template>
								<ObjectStatus
									text="{sapLink>CustomerText}"
									state="{= ${sapLink>OtherCustomer} === true ? 'Warning' : 'None' }"
									icon="{= ${sapLink>OtherCustomer} === true ? 'sap-icon://message-warning' : '' }"
									tooltip="{= ${sapLink>OtherCustomer} === true ? 'Cliente diferente do da nota fiscal. O documento de saída nasce com o cliente da nota fiscal; o saldo é baixado neste contrato.' : ${sapLink>CustomerText} }"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkReleasesWarehouseColumn" width="15rem" sortProperty="DeliveryLocationName" filterProperty="DeliveryLocationName">
							<Label text="Armazém"/>
							<t:template>
								<Text text="({sapLink>DeliveryLocationCode}) {sapLink>DeliveryLocationName}" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkReleasesPriceColumn" width="8rem" hAlign="End" sortProperty="DisplayPrice" filterProperty="DisplayPrice" filterType="sap.ui.model.type.Float">
							<Label text="Preço Unit."/>
							<t:template>
								<ObjectNumber
									number="{
										parts: [{path: 'sapLink>DisplayPrice'}],
										formatter: 'formatter.formatCommercialOrKgPrice'
									}"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkReleasesBalanceColumn" width="9rem" hAlign="End" sortProperty="AvailableQuantity" filterProperty="AvailableQuantity" filterType="sap.ui.model.type.Float">
							<Label text="Saldo"/>
							<t:template>
								<Text text="{ path: 'sapLink>AvailableQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }" wrapping="false"/>
							</t:template>
						</t:Column>
						<t:Column id="sapLinkReleasesUomColumn" width="4rem" sortProperty="UnitOfMeasureCode" filterProperty="UnitOfMeasureCode">
							<Label text="Um"/>
							<t:template>
								<Text text="{sapLink>UnitOfMeasureCode}" wrapping="false"/>
							</t:template>
						</t:Column>
					</t:columns>
				</t:Table>
			</VBox>
		</content>
		<buttons>
			<Button
				text="Vincular"
				type="Emphasized"
				enabled="{= ${sapLink>/CanLink} === true }"
				press=".onLink"/>
			<Button text="Cancelar" press=".onCancel"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
