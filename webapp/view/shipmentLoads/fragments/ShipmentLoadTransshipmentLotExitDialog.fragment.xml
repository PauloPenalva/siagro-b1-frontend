<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<!-- Vincular a Saída do Lote (GAC-1181 fase 2, Task 10): em armazém PRÓPRIO, o armazém recarrega
	     o caminhão a partir do LOTE que recebeu a entrada do transbordo, e é este vínculo — não a
	     entrada — que EMITE a liberação pela quantidade REAL carregada
	     (ShipmentLoadsTransshipmentAttachLotExitService). É por ele que a carga passa de
	     "Aguardando saída" para "Aguardando expedição".

	     Diálogo separado do ShipmentLoadTransshipmentDialog (Iniciar/Registrar Entrada) de
	     propósito: a action `ShipmentLoadsTransshipmentAttachLotExit` não tem parâmetro de data
	     nenhum, e encaixar um terceiro modo no diálogo existente arrastaria para cá a validação de
	     data que aquele SEMPRE exige.

	     Select com um ÚNICO caminho de itens — mesma armadilha do Select de Entrada em
	     Armazenagem do outro diálogo: agregação bindada
	     (`items="{viewModel>/transshipmentLotExitDialog/lotExits}"`) sem nenhum `<core:ListItem>`
	     estático ao lado. A lista é montada em BaseController#loadEligibleLotExitOptionsAsync,
	     filtrando pelo MESMO lote da entrada (StorageAddressCode do romaneio de Entrada em
	     Armazenagem vinculado), pelos mesmos critérios de
	     ShipmentLoadTransshipmentRules.EnsureLotExitIsUsable no servidor. -->
	<Dialog
		id="shipmentLoadTransshipmentLotExitDialog"
		title="{viewModel>/transshipmentLotExitDialog/title}"
		contentWidth="34rem">
		<content>
			<VBox class="sapUiSmallMargin">
				<f:Form editable="true">
					<f:layout>
						<f:ColumnLayout columnsM="1" columnsL="1" columnsXL="1"/>
					</f:layout>
					<f:formContainers>
						<f:FormContainer>
							<f:formElements>
								<f:FormElement label="Saída do Lote">
									<f:fields>
										<Select
											forceSelection="false"
											required="true"
											items="{viewModel>/transshipmentLotExitDialog/lotExits}"
											selectedKey="{viewModel>/transshipmentLotExitDialog/lotExitKey}">
											<core:ListItem key="{viewModel>Key}" text="{viewModel>Text}"/>
										</Select>
									</f:fields>
								</f:FormElement>
							</f:formElements>
						</f:FormContainer>
					</f:formContainers>
				</f:Form>
			</VBox>
		</content>
		<beginButton>
			<Button text="Gravar" type="Emphasized" press=".onConfirmTransshipmentLotExitDialog"/>
		</beginButton>
		<endButton>
			<Button text="Cancelar" press=".onCloseTransshipmentLotExitDialog"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
