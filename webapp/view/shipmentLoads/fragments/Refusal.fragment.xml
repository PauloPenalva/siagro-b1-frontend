<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.ui.layout.form">
	<Dialog
		id="refusalDialog"
		title="Registrar Recusa da Carga"
		contentWidth="82rem"
		class="sapUiSizeCompact"
		busy="{refusal>/busy}"
		busyIndicatorDelay="0">
		<content>
			<f:Form editable="true">
				<f:layout>
					<f:ColumnLayout columnsM="1" columnsL="1" columnsXL="1"/>
				</f:layout>
				<f:formContainers>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="Destino Físico">
								<f:fields>
									<RadioButtonGroup
										id="refusalDestinationGroup"
										columns="1"
										selectedIndex="{refusal>/DestinationIndex}"
										select=".onRefusalDestinationChange">
										<RadioButton text="Caminhão segue para novo destino (mercadoria fica na carga)"/>
										<RadioButton text="Mercadoria retorna a um armazém"/>
									</RadioButtonGroup>
								</f:fields>
							</f:FormElement>
							<f:FormElement
								label="Armazém de Destino"
								visible="{= ${refusal>/DestinationIndex} === 1 }">
								<f:fields>
									<!-- editable="true" é obrigatório mesmo com valueHelpOnly: com
									     editable="false" o ícone de value help não aparece e o campo
									     fica impossível de preencher. -->
									<Input
										required="true"
										editable="true"
										showValueHelp="true"
										valueHelpOnly="true"
										valueHelpRequest=".openRefusalWarehouseValueHelp"
										value="{refusal>/DestinationWarehouseCode}"/>
									<Input value="{refusal>/DestinationWarehouseName}" editable="false"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Motivo da Recusa">
								<f:fields>
									<TextArea
										required="true"
										rows="3"
										maxLength="500"
										placeholder="Ex.: recusado por qualidade no porto"
										value="{refusal>/Reason}"/>
								</f:fields>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>

			<t:Table
				id="refusalDocsTable"
				selectionMode="None"
				class="sapUiSizeCondensed"
				visibleRowCount="6"
				rows="{refusalDocs>/}">
				<t:extension>
					<OverflowToolbar>
						<Title text="Documentos de Saída da Carga"/>
						<ToolbarSpacer/>
						<Text text="Zere a quantidade dos documentos que não foram recusados."/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="Documento" width="9rem">
						<t:template><Text text="{refusalDocs>InvoiceNumber}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Emissão" width="8rem">
						<t:template>
							<Text wrapping="false" text="{ path: 'refusalDocs>InvoiceDate', targetType: 'any', formatter: '.formatter.formatDate' }"/>
						</t:template>
					</t:Column>
					<t:Column label="Cliente" width="14rem">
						<t:template><Text text="({refusalDocs>CardCode}) {refusalDocs>CardName}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Local de Entrega" width="14rem">
						<t:template><Text text="({refusalDocs>DeliveryCardCode}) {refusalDocs>DeliveryCardName}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Qtd. Faturada" hAlign="End" width="9rem">
						<t:template>
							<ObjectNumber
								textAlign="End"
								number="{ path: 'refusalDocs>Quantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"
								unit="{refusalDocs>UnitOfMeasureCode}"/>
						</t:template>
					</t:Column>
					<t:Column label="Já Devolvido" hAlign="End" width="8rem">
						<t:template>
							<ObjectNumber
								textAlign="End"
								number="{ path: 'refusalDocs>AlreadyReturnedQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"/>
						</t:template>
					</t:Column>
					<t:Column label="Qtd. a Devolver" hAlign="End" width="11rem">
						<t:template>
							<!-- Modelo JSON, então sap.ui.model.type.Float é o tipo certo aqui. A
							     regra "Double, nunca Decimal" vale para o PAYLOAD da action, que o
							     controller monta com números crus. -->
							<Input
								textAlign="End"
								value="{ path: 'refusalDocs>ReturnQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"/>
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<beginButton>
			<Button text="Fechar" type="Transparent" press=".onCloseRefusal"/>
		</beginButton>
		<endButton>
			<Button text="Confirmar Recusa" type="Emphasized" press=".onConfirmRefusal"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
