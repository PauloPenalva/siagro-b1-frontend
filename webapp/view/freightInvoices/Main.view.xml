<mvc:View
	controllerName="siagrob1.controller.freightInvoices.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">
	<f:DynamicPage busyIndicatorDelay="0" busy="{ui>/busy}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Faturas de Frete"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<fb:FilterBar id="freightInvoicesFb" search=".onSearch" showClearOnFB="true" clear=".onClearFilters">
						<fb:filterGroupItems>
							<fb:FilterGroupItem name="taker" label="Tomador" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<Input value="{filter>/TakerCardCode}" description="{filter>/TakerName}" showValueHelp="true"
										valueHelpRequest=".onPickTaker" showClearIcon="true"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="status" label="Situação" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<MultiComboBox selectedKeys="{filter>/Statuses}" items="{statuses>/}">
										<core:Item key="{statuses>key}" text="{statuses>text}"/>
									</MultiComboBox>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="dateFrom" label="Emissão de" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<DatePicker value="{ path: 'filter>/DateFrom', type: 'sap.ui.model.type.String' }"
										displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="dateTo" label="Emissão até" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<DatePicker value="{ path: 'filter>/DateTo', type: 'sap.ui.model.type.String' }"
										displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd"/>
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<t:Table
				id="tableFreightInvoices"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/FreightInvoices',
					parameters: {
						$select: 'Key,Code,TakerCardCode,TakerName,IssueDate,DueDate,TotalAmount,Status',
						$expand: 'Items($select=Key;$filter=IsActive eq true)'
					},
					sorter: [ { path: 'IssueDate', descending: true }, { path: 'Code', descending: true } ]
				}">
				<t:extension>
					<OverflowToolbar>
						<Title text="Faturas"/>
						<ToolbarSpacer/>
						<Button type="Emphasized" icon="sap-icon://add" text="Gerar fatura" press=".onCreate"/>
						<Button icon="sap-icon://batch-payments" text="Gerar em lote" press=".onOpenBatch"/>
						<Button type="Transparent" text="Visualizar" press=".onDetail"/>
						<Button type="Transparent" icon="sap-icon://refresh" text="Atualizar" press=".onRefresh"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="Número" width="8rem" sortProperty="Code">
						<t:template><Text text="{Code}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Tomador" width="16rem" sortProperty="TakerName">
						<t:template><Text text="{TakerName}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Emissão" width="7rem" sortProperty="IssueDate">
						<t:template><Text text="{ path: 'IssueDate', targetType: 'any', formatter: '.dateText' }" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Vencimento" width="7rem" sortProperty="DueDate">
						<t:template><Text text="{ path: 'DueDate', targetType: 'any', formatter: '.dateText' }" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Total" width="9rem" hAlign="End" sortProperty="TotalAmount">
						<t:template><Text text="{ path: 'TotalAmount', targetType: 'any', formatter: 'formatter.formatBrl' }" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Qtd CT-e" width="6rem" hAlign="End">
						<t:template><Text text="{Items/$count}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Situação" width="9rem">
						<t:template>
							<ObjectStatus
								text="{ path: 'Status', targetType: 'any', formatter: '.statusText' }"
								state="{ path: 'Status', targetType: 'any', formatter: '.statusState' }"/>
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</f:content>
	</f:DynamicPage>
</mvc:View>
