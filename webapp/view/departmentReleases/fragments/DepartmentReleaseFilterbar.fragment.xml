<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
>
<fb:FilterBar id="departmentReleaseFb" search=".onSearch" showClearOnFB="true" clear=".onClearFilters">
  <fb:filterGroupItems>
    <fb:FilterGroupItem name="status" label="Status Financeiro" groupName="GroupStatus" visibleInFilterBar="true">
      <fb:control>
        <MultiComboBox width="100%" selectedKeys="{filter>/PaymentReleaseStatus}">
          <core:Item key="Pending" text="Pendente"/>
          <core:Item key="UnderReview" text="Em análise"/>
          <core:Item key="IncompleteDocuments" text="Documentação incompleta"/>
          <core:Item key="Approved" text="Aprovado"/>
          <core:Item key="PreApproved" text="Pré-aprovado"/>
        </MultiComboBox>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="businessPartners" label="Fornecedor" groupName="GroupFornecedor" visibleInFilterBar="true">
      <fb:control>
        <Input
          showClearIcon="true"
          showValueHelp="true"
          valueHelpRequest=".openSuppliersValueHelp"
          value="{filter>/CardCode}"/>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="creationDateFrom" label="Emissão de" groupName="GroupCreationDateFrom" visibleInFilterBar="true">
      <fb:control>
        <DatePicker
          value="{
            path: 'filter>/CreationDateFrom',
            type: 'sap.ui.model.type.String'
          }"
          displayFormat="dd/MM/yyyy"
          valueFormat="yyyy-MM-dd"/>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="creationDateTo" label="Emissão até" groupName="GroupCreationDateTo" visibleInFilterBar="true">
      <fb:control>
        <DatePicker
          value="{
            path: 'filter>/CreationDateTo',
            type: 'sap.ui.model.type.String'
          }"
          displayFormat="dd/MM/yyyy"
          valueFormat="yyyy-MM-dd"/>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="releaseBoard" label="Lib. Diretoria" groupName="GroupReleaseBoard" visibleInFilterBar="true" visible="{perm>/Board}">
      <fb:control>
        <Select width="100%" selectedKey="{filter>/Release/Board}">
          <core:Item key="ALL" text="Todos"/>
          <core:Item key="YES" text="Sim"/>
          <core:Item key="NO" text="Não"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="releaseStock" label="Lib. Estoque" groupName="GroupReleaseStock" visibleInFilterBar="true" visible="{perm>/Stock}">
      <fb:control>
        <Select width="100%" selectedKey="{filter>/Release/Stock}">
          <core:Item key="ALL" text="Todos"/>
          <core:Item key="YES" text="Sim"/>
          <core:Item key="NO" text="Não"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="releaseLegal" label="Lib. Jurídico" groupName="GroupReleaseLegal" visibleInFilterBar="true" visible="{perm>/Legal}">
      <fb:control>
        <Select width="100%" selectedKey="{filter>/Release/Legal}">
          <core:Item key="ALL" text="Todos"/>
          <core:Item key="YES" text="Sim"/>
          <core:Item key="NO" text="Não"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="releaseFiscal" label="Lib. Fiscal" groupName="GroupReleaseFiscal" visibleInFilterBar="true" visible="{perm>/Fiscal}">
      <fb:control>
        <Select width="100%" selectedKey="{filter>/Release/Fiscal}">
          <core:Item key="ALL" text="Todos"/>
          <core:Item key="YES" text="Sim"/>
          <core:Item key="NO" text="Não"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="releaseRoyalties" label="Lib. Royalties" groupName="GroupReleaseRoyalties" visibleInFilterBar="true" visible="{perm>/Royalties}">
      <fb:control>
        <Select width="100%" selectedKey="{filter>/Release/Royalties}">
          <core:Item key="ALL" text="Todos"/>
          <core:Item key="YES" text="Sim"/>
          <core:Item key="NO" text="Não"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="releaseFinancial" label="Lib. Financeiro" groupName="GroupReleaseFinancial" visibleInFilterBar="true" visible="{perm>/Financial}">
      <fb:control>
        <Select width="100%" selectedKey="{filter>/Release/Financial}">
          <core:Item key="ALL" text="Todos"/>
          <core:Item key="YES" text="Sim"/>
          <core:Item key="NO" text="Não"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
    <fb:FilterGroupItem name="releaseStore" label="Lib. Loja" groupName="GroupReleaseStore" visibleInFilterBar="true" visible="{perm>/Store}">
      <fb:control>
        <Select width="100%" selectedKey="{filter>/Release/Store}">
          <core:Item key="ALL" text="Todos"/>
          <core:Item key="YES" text="Sim"/>
          <core:Item key="NO" text="Não"/>
        </Select>
      </fb:control>
    </fb:FilterGroupItem>
  </fb:filterGroupItems>
</fb:FilterBar>
</core:FragmentDefinition>
