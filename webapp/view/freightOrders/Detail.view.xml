<mvc:View
	controllerName="siagrob1.controller.freightOrders.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:uxap="sap.uxap"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<uxap:ObjectPageLayout showFooter="false" toggleHeaderOnTitleClick="true" preserveHeaderStateOnScroll="false"
		busy="{ui>/busy}" busyIndicatorDelay="0">
		<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
				<uxap:navigationActions>
					<Button icon="sap-icon://decline" type="Transparent" tooltip="Voltar à lista" press=".onBack"/>
				</uxap:navigationActions>
				<uxap:expandedHeading>
					<Title text="Ordem de frete {doc>/Code}"/>
				</uxap:expandedHeading>
				<uxap:snappedHeading>
					<Title text="Ordem de frete {doc>/Code}"/>
				</uxap:snappedHeading>
				<uxap:actions>
					<Button text="Editar" type="Emphasized" icon="sap-icon://edit" press=".onEdit" visible="{act>/edit}"/>
					<Button text="Emitir CT-e" type="Success" icon="sap-icon://shipping-status" press=".onCreateCte" visible="{act>/createCte}"/>
					<Button text="Encerrar" icon="sap-icon://complete" press=".onClose" visible="{act>/close}"/>
					<Button text="Cancelar" type="Reject" icon="sap-icon://cancel" press=".onCancelOrder" visible="{act>/cancel}"/>
				</uxap:actions>
			</uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>

		<uxap:headerContent>
			<HBox wrap="Wrap">
				<ObjectStatus class="sapUiMediumMarginEnd" text="{ path: 'doc>/Status', formatter: '.statusText' }"
					state="{ path: 'doc>/Status', formatter: '.statusState' }"/>
				<ObjectAttribute class="sapUiMediumMarginEnd" title="Contratado (t)" text="{ path: 'doc>/ContractedWeightKg', formatter: '.tonsText' }"/>
				<ObjectAttribute class="sapUiMediumMarginEnd" title="Transportado (t)" text="{ path: 'doc>/TransportedWeightKg', formatter: '.tonsText' }"/>
				<ObjectAttribute title="Saldo (t)"
					text="{ parts: [ 'doc>/ContractedWeightKg', 'doc>/TransportedWeightKg' ], formatter: '.balanceTonsText' }"/>
			</HBox>
		</uxap:headerContent>

		<uxap:sections>
			<uxap:ObjectPageSection title="Dados">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<f:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanL="4" labelSpanM="4" columnsL="2" columnsM="1"
							singleContainerFullSize="false">
							<f:content>
								<core:Title text="Identificação"/>
								<Label text="Filial"/>
								<Text text="{doc>/BranchCode}"/>
								<Label text="Data"/>
								<Text text="{ path: 'doc>/OrderDate', formatter: '.dateText' }"/>
								<Label text="Vigência"/>
								<Text text="{ path: 'doc>/ValidFrom', formatter: '.dateText' } a { path: 'doc>/ValidTo', formatter: '.dateText' }"/>
								<Label text="Encerrada manualmente" visible="{= ${doc>/ClosedManually} === true }"/>
								<Text text="Sim" visible="{= ${doc>/ClosedManually} === true }"/>
								<Label text="Criada por"/>
								<Text text="{doc>/CreatedBy}"/>

								<core:Title text="Participantes"/>
								<Label text="Tomador"/>
								<Text text="{doc>/TakerName}"/>
								<Label text="Remetente"/>
								<Text text="{doc>/SenderName}"/>
								<Label text="Destinatário"/>
								<Text text="{doc>/RecipientName}"/>

								<core:Title text="Rota e carga"/>
								<Label text="Origem → destino"/>
								<Text text="{doc>/StartMunicipalityName}/{doc>/StartState} → {doc>/EndMunicipalityName}/{doc>/EndState}"/>
								<Label text="Produto"/>
								<Text text="{doc>/ItemCode} - {doc>/ItemName}"/>

								<core:Title text="Preço e cobrança"/>
								<Label text="Método / preço"/>
								<Text text="{ path: 'doc>/PriceMethod', formatter: '.priceMethodText' } - { path: 'doc>/UnitPrice', formatter: 'formatter.formatBrl' }"/>
								<Label text="Condição de pagamento"/>
								<Text text="{doc>/PaymentConditionCode}"/>
								<Label text="Natureza"/>
								<Text text="{doc>/UsageCode}"/>
								<Label text="Observação"/>
								<Text text="{doc>/Observation}"/>
							</f:content>
						</f:SimpleForm>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>

			<uxap:ObjectPageSection title="CT-e">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
						<Table items="{ctes>/}" class="sapUiSizeCompact" noDataText="Nenhum CT-e vinculado.">
							<columns>
								<Column width="9rem"><Text text="Número/Série"/></Column>
								<Column width="10rem"><Text text="Emissão"/></Column>
								<Column width="9rem" hAlign="End"><Text text="Peso (t)"/></Column>
								<Column width="9rem" hAlign="End"><Text text="Valor"/></Column>
								<Column><Text text="Situação"/></Column>
							</columns>
							<items>
								<ColumnListItem type="Navigation" press=".onOpenCte">
									<cells>
										<Text text="{= ${ctes>Number} ? ${ctes>Number} + ' / ' + ${ctes>Series} : '(rascunho) / ' + ${ctes>Series} }"/>
										<Text text="{ path: 'ctes>IssuedAt', formatter: 'formatter.formatDateTime' }"/>
										<Text text="{ path: 'ctes>weightKg', formatter: '.tonsText' }"/>
										<Text text="{ path: 'ctes>ServiceTotal', formatter: 'formatter.formatBrl' }"/>
										<Text text="{ path: 'ctes>Status', formatter: '.cteStatusText' }"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
		</uxap:sections>
	</uxap:ObjectPageLayout>
</mvc:View>
