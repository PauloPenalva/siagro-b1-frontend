
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:t="sap.ui.table"
	xmlns:l="sap.ui.layout"
>
	<Dialog id="billingDialog" title="Faturamento" class="sapUiSizeCompact">
		<f:SimpleForm
			id="shipmentBillingSalesContractsForm"
			busy="{ui>/busy}"
			busyIndicatorDelay="0"
			class="sapUiSizeCompact"
			editable="true"
			layout="GridLayout"
			labelSpanXL="4"
			labelSpanL="3"
			labelSpanM="4"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="0"
			emptySpanL="4"
			emptySpanM="0"
			emptySpanS="0"
			columnsXL="2"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="true"
		>
			<f:content>
				<core:Title text="Dados do Embarque" />
        <Label text="Filial"/>
        <Select 
          editable="false"
          forceSelection="false"
          required="true"
          selectedKey="{viewModel>/BranchCode}"
          items="{
            path: '/Branchs',
            sorter: { 
              path: 'Code'
            }
          }"
          >
          <core:ListItem key="{Code}" text="{ShortName}" additionalText="{Code}"/>
        </Select>
        <Label text="Emissao" />
        <DatePicker
            value="{
              path: 'viewModel>/InvoiceDate',
              type: 'sap.ui.model.odata.type.DateTimeOffset',
              constraints: { precision: 7 },
              formatOptions: {
                pattern: 'dd/MM/yyyy'
              }
            }"
            editable="{ui>/editable}"
            required="true"
            liveChange=".validateField"
        />
				<Label text="Produto" />
				<Input
					value="{viewModel>/ItemCode}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Descricao" />
				<Input
					value="{viewModel>/ItemName}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Qtd.Embarcada" />
				<Input
					value="{
						path: 'viewModel>/Volume',
						type: 'sap.ui.model.type.Float',
						formatOptions: {
								decimals: 3 ,
								decimalSeparator: ',',
								groupingEnabled: true,
								groupingSeparator: '.'
						}}"
					editable="false"
					textAlign="End"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<!-- <Label text="Peso Balanca" />
				<Input id="grossWeightLimit"
					value="{
            path: 'viewModel>/GrossWeightLimit',
            type: 'sap.ui.model.type.Float',
            formatOptions: {
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
            }}"
					editable="true"
					textAlign="End"
					required="true"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input> -->
				<Label
					text="Tipo Frete"
				/>
				<Select
					forceSelection="false"
          required="true"
					selectedKey="{viewModel>/FreightTerms}"
				>
					<core:Item
						key="Cif"
						text="CIF"
					/>
					<core:Item
						key="Fob"
						text="FOB"
					/>
				</Select>
        

        <Label text="Inf.Ad.Nota Fiscal" />
				<TextArea value="{
									path: 'viewModel>/TaxPayerComments',
									type: 'sap.ui.model.odata.type.String'
							}" rows="8" cols="80" editable="true" />


				<core:Title />

        <Label text="Endereço Entrega" />
        <Input
          showValueHelp="true"
          valueHelpOnly="true"
          required="true"
          valueHelpRequest=".openCostumersValueHelp"
          value="{viewModel>/DeliveryCardCode}"
          >
          <layoutData>
            <l:GridData span="XL3 L3 M3 S8" />
          </layoutData>
          <customData>
            <core:CustomData key="descriptionProperty" value="DeliveryCardName:CardName" />
          </customData>
        </Input>
        <Input value="{viewModel>/DeliveryCardName}" editable="false" />

        <Label text="Transportadora" />
        <Input
          showValueHelp="true"
          valueHelpOnly="true"
          valueHelpRequest=".openSuppliersValueHelp"
          value="{viewModel>/TruckingCompanyCode}"
          >
          <layoutData>
            <l:GridData span="XL3 L3 M3 S8" />
          </layoutData>
          <customData>
            <core:CustomData key="descriptionProperty" value="TruckingCompanyName:CardName" />
          </customData>
        </Input>
        <Input value="{viewModel>/TruckingCompanyName}" editable="false" />
        
        
				<Label text="Motorista" />
				<Input
					value="{viewModel>/TruckDriverCode}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Placa" />
				<Input
					value="{viewModel>/TruckCode}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<!-- <Label text="Placa Carreta 1" />
				<Input
					value="{fatura>/PlacaCarreta1}"
					editable="true"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Placa Carreta 2" />
				<Input
					value="{fatura>/PlacaCarreta2}"
					editable="true"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input> -->

				<!-- <Label text="NF Bal+Compl ?" />
				<Select
					forceSelection="true"
					selectedKey="{viewModel>/ComplementInvoice}"
				>
					<core:Item
						key="No"
						text="NAO"
					/>
					<core:Item
						key="Yes"
						text="SIM"
					/>
				</Select> -->

				<Label text="Frete p/Tonelada"/>
				<Input value="{
          path: 'viewModel>/FreightCost',
          type: 'sap.ui.model.type.Float',
          formatOptions: {
              decimals: 2,
              decimalSeparator: ',',
              groupingEnabled: true,
              groupingSeparator: '.'
          }}"  
          editable="true" 
          textAlign="End" 
          required="{= ${path: 'viewModel>/FreightTerms', targetType: 'any'}==='Cif' ? true : false }">
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>
        
       
			</f:content>
		</f:SimpleForm>

		<t:Table
			id="shipmentBillingSalesContractsTable"
			busyIndicatorDelay="0"
			selectionBehavior="Row"
			class="sapUiSizeCondensed"
			enableBusyIndicator="true"
			alternateRowColors="true"
			selectionMode="Single"
			visibleRowCountMode="Fixed"
			visibleRowCount="6"
			rows="{
				path: 'releases>/'
			}"
		>
			<t:toolbar>
				<Toolbar>
					<Title text="Liberações de Entrega de Venda Disponíveis" />
					<ToolbarSpacer />
				</Toolbar>
			</t:toolbar>
			<t:columns>
        <t:Column width="6rem" sortProperty="BranchShortName">
					<Label text="Filial" />
					<t:template>
						<Text text="{releases>BranchShortName}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="6rem" sortProperty="SalesContractCode">
					<Label text="Contrato" />
					<t:template>
						<Text text="{releases>SalesContractCode}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="10rem" sortProperty="Complement">
					<Label text="Compl." />
					<t:template>
						<Text text="{releases>Complement}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column sortProperty="CardCode" width="5rem">
					<Label text="Cliente" />
					<t:template>
						<Text text="{releases>CardCode}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column sortProperty="CardName" width="25rem">
					<Label text="Razao Social" />
					<t:template>
						<Text text="{releases>CardName}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="25rem">
					<Label text="Nome Fantasia" />
					<t:template>
						<Text text="{releases>CardFName}" wrapping="false" />
					</t:template>
				</t:Column>
				<t:Column width="15rem">
					<Label text="Armazém" />
					<t:template>
						<Text text="({releases>DeliveryLocationCode}) {releases>DeliveryLocationName}" wrapping="false" />
					</t:template>
				</t:Column>
				<t:Column width="8rem" hAlign="End" sortProperty="Price">
					<Label text="Preço Unit." />
					<t:template>
						<ObjectNumber
							number="{
                path: 'releases>Price',
                type: 'sap.ui.model.type.Float',
                formatOptions: { decimals: 8, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
						/>
					</t:template>
				</t:Column>
				<t:Column width="8rem" hAlign="End" sortProperty="AvailableQuantity">
					<Label text="Saldo" />
					<t:template>
						<Text
							text="{
							path: 'releases>AvailableQuantity',
              type: 'sap.ui.model.type.Float',
							formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }}"
							wrapping="false"
						/>
					</t:template>
				</t:Column>
				<t:Column width="3rem">
					<Label text="Um" />
					<t:template>
						<Text text="{releases>UnitOfMeasureCode}" wrapping="false"/>
					</t:template>
				</t:Column>
			</t:columns>
		</t:Table>

		<buttons>
			<Button
				text="Fechar"
				press=".closeBillingDialog"
				type="Transparent"
			/>
			<Button
				text="Confirmar"
				press=".saveBillingDialog"
				type="Emphasized"
			/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
