
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:t="sap.ui.table"
	xmlns:l="sap.ui.layout"
>
	<Dialog id="billingDialog" title="Faturamento" class="sapUiSizeCompact">
		<f:SimpleForm
			id="shipmentBillingSalesContractsForm"
			busy="{ui>/busy}"
			busyIndicatorDelay="0"
			class="sapUiSizeCompact"
			editable="true"
			layout="GridLayout"
			labelSpanXL="4"
			labelSpanL="3"
			labelSpanM="4"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="0"
			emptySpanL="4"
			emptySpanM="0"
			emptySpanS="0"
			columnsXL="2"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="true"
		>
			<f:content>
				<core:Title text="Dados do Embarque" />
        <Label text="Filial"/>
        <Select 
          editable="false"
          forceSelection="false"
          required="true"
          selectedKey="{billing>/BranchCode}"
          items="{billingBranches>/}"
          >
          <core:ListItem key="{billingBranches>Code}" text="{billingBranches>ShortName}" additionalText="{billingBranches>Code}"/>
        </Select>
        <Label text="Emissao" />
        <DatePicker
            value="{
              path: 'billing>/InvoiceDate',
              type: 'sap.ui.model.odata.type.DateTimeOffset',
              constraints: { precision: 7 },
              formatOptions: {
                pattern: 'dd/MM/yyyy'
              }
            }"
            editable="true"
            required="true"
            liveChange=".validateField"
        />
				<Label text="Produto" />
				<Input
					value="{billing>/ItemCode}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Descricao" />
				<Input
					value="{billing>/ItemName}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Carga" />
				<Input value="{billing>/ShipmentLoadCode}" editable="false">
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Saldo da Carga" />
				<Input
					value="{
						path: 'billing>/AvailableQuantity',
						type: 'sap.ui.model.type.Float',
						formatOptions: {
								decimals: 3 ,
								decimalSeparator: ',',
								groupingEnabled: true,
								groupingSeparator: '.'
						}}"
					editable="false"
					textAlign="End"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<!-- Editavel agora: a carga pode ser faturada em partes. O tipo continua Float e o
				     payload leva NUMERO - Edm.Decimal em string devolve 400 sem nomear o campo. -->
				<Label text="Qtd. a Faturar" />
				<Input
					value="{
						path: 'billing>/Volume',
						type: 'sap.ui.model.type.Float',
						formatOptions: {
								decimals: 3 ,
								decimalSeparator: ',',
								groupingEnabled: true,
								groupingSeparator: '.'
						}}"
					editable="true"
					required="true"
					textAlign="End"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<!-- <Label text="Peso Balanca" />
				<Input id="grossWeightLimit"
					value="{
            path: 'billing>/GrossWeightLimit',
            type: 'sap.ui.model.type.Float',
            formatOptions: {
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
            }}"
					editable="true"
					textAlign="End"
					required="true"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input> -->
				<Label
					text="Tipo Frete"
				/>
				<Select
					forceSelection="false"
          required="true"
					selectedKey="{billing>/FreightTerms}"
				>
					<core:Item
						key="Cif"
						text="CIF"
					/>
					<core:Item
						key="Fob"
						text="FOB"
					/>
					<core:Item
						key="Ter"
						text="TER"
					/>
				</Select>
				<Label text="Tipo de documento" visible="{= ${billing>/TaxLocked} === true }" />
				<Select
					visible="{= ${billing>/TaxLocked} === true }"
					forceSelection="false"
					selectedKey="{billing>/TaxDocumentKind}"
				>
					<core:Item key="Nfe" text="NF-e (eletrônica)" />
					<core:Item key="Other" text="Outro (papel/talão…)" />
				</Select>
        

        <Label text="Inf.Ad.Nota Fiscal" />
				<TextArea value="{
									path: 'billing>/TaxPayerComments',
									type: 'sap.ui.model.odata.type.String'
							}" rows="8" cols="80" editable="true" />


				<core:Title />

        <Label text="Endereço Entrega" />
        <Input
          showValueHelp="true"
          valueHelpOnly="true"
          required="true"
          valueHelpRequest=".openCostumersValueHelp"
          value="{billing>/DeliveryCardCode}"
          >
          <layoutData>
            <l:GridData span="XL3 L3 M3 S8" />
          </layoutData>
          <customData>
            <core:CustomData key="descriptionProperty" value="DeliveryCardName:CardName" />
          </customData>
        </Input>
        <Input value="{billing>/DeliveryCardName}" editable="false" />

        <!-- A transportadora vem da CARGA e não é escolhida aqui: o backend recusa faturar
             com transportadora diferente da da carga. Sem value help, portanto — para trocá-la
             o usuário edita a carga. -->
        <Label text="Transportadora" />
        <Input value="{billing>/TruckingCompanyCode}" editable="false">
          <layoutData>
            <l:GridData span="XL3 L3 M3 S8" />
          </layoutData>
        </Input>
        <Input value="{billing>/TruckingCompanyName}" editable="false" />
        
        
				<Label text="Motorista" />
				<Input
					value="{billing>/TruckDriverCode}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>
				<Input value="{billing>/TruckDriverName}" editable="false" />

				<Label text="Placa" />
				<Input
					value="{billing>/TruckCode}"
					editable="false"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<!-- <Label text="Placa Carreta 1" />
				<Input
					value="{fatura>/PlacaCarreta1}"
					editable="true"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>

				<Label text="Placa Carreta 2" />
				<Input
					value="{fatura>/PlacaCarreta2}"
					editable="true"
				>
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input> -->

				<!-- <Label text="NF Bal+Compl ?" />
				<Select
					forceSelection="true"
					selectedKey="{billing>/ComplementInvoice}"
				>
					<core:Item
						key="No"
						text="NAO"
					/>
					<core:Item
						key="Yes"
						text="SIM"
					/>
				</Select> -->

				<Label text="Frete p/Tonelada"/>
				<Input value="{
          path: 'billing>/FreightCost',
          type: 'sap.ui.model.type.Float',
          formatOptions: {
              decimals: 2,
              decimalSeparator: ',',
              groupingEnabled: true,
              groupingSeparator: '.'
          }}"  
          editable="true" 
          textAlign="End" 
          required="{= ${path: 'billing>/FreightTerms', targetType: 'any'}==='Cif' ? true : false }">
					<layoutData>
						<l:GridData span="XL2 L1 M3 S4" />
					</layoutData>
				</Input>
        
       
			</f:content>
		</f:SimpleForm>

		<t:Table
			id="shipmentBillingSalesContractsTable"
			busyIndicatorDelay="0"
			selectionBehavior="Row"
			class="sapUiSizeCondensed"
			enableBusyIndicator="true"
			alternateRowColors="true"
			selectionMode="Single"
			visibleRowCountMode="Fixed"
			visibleRowCount="6"
			rows="{
				path: 'billingReleases>/'
			}"
		>
			<t:toolbar>
				<Toolbar>
					<Title text="Liberações de Entrega de Venda Disponíveis" />
					<ToolbarSpacer />
				</Toolbar>
			</t:toolbar>
			<t:columns>
        <t:Column width="6rem" sortProperty="BranchShortName">
					<Label text="Filial" />
					<t:template>
						<Text text="{billingReleases>BranchShortName}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="6rem" sortProperty="SalesContractCode">
					<Label text="Contrato" />
					<t:template>
						<Text text="{billingReleases>SalesContractCode}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="10rem" sortProperty="Complement">
					<Label text="Compl." />
					<t:template>
						<Text text="{billingReleases>Complement}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="8rem" sortProperty="StandardCashFlowDate">
					<Label text="Prev. Pagto." />
					<t:template>
						<Text
							text="{
								path: 'billingReleases>StandardCashFlowDate',
								formatter: '.formatter.formatDate'
							}"
							wrapping="false"
						/>
					</t:template>
				</t:Column>
				<t:Column width="9rem" hAlign="End" sortProperty="SalesContractFreightCostStandard">
					<Label text="Frete Standard" />
					<t:template>
						<ObjectNumber
							textAlign="End"
							number="{
								path: 'billingReleases>SalesContractFreightCostStandard',
								type: 'sap.ui.model.type.Float',
								formatOptions: { decimals: 8, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
							}"
							unit="{billingReleases>SalesContractFreightUmCode}"
						/>
					</t:template>
				</t:Column>
				<t:Column sortProperty="CardCode" width="5rem">
					<Label text="Cliente" />
					<t:template>
						<Text text="{billingReleases>CardCode}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column sortProperty="CardName" width="25rem">
					<Label text="Razao Social" />
					<t:template>
						<Text text="{billingReleases>CardName}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="25rem">
					<Label text="Nome Fantasia" />
					<t:template>
						<Text text="{billingReleases>CardFName}" wrapping="false" />
					</t:template>
				</t:Column>
				<t:Column width="15rem">
					<Label text="Armazém" />
					<t:template>
						<Text text="({billingReleases>DeliveryLocationCode}) {billingReleases>DeliveryLocationName}" wrapping="false" />
					</t:template>
				</t:Column>
				<t:Column width="8rem" hAlign="End" sortProperty="Price">
					<Label text="Preço Unit." />
					<t:template>
						<ObjectNumber
							number="{
                parts: [{path: 'billingReleases>CommercialPrice'}, {path: 'billingReleases>Price'}],
                formatter: '.formatter.formatCommercialOrKgPrice'
              }"
							unit="{
                parts: [{path: 'billingReleases>CommercialUnitOfMeasureCode'}, {path: 'billingReleases>UnitOfMeasureCode'}],
                formatter: '.formatter.formatCommercialOrKgUnit'
              }"
						/>
					</t:template>
				</t:Column>
				<t:Column width="8rem" hAlign="End" sortProperty="AvailableQuantity">
					<Label text="Saldo" />
					<t:template>
						<Text
							text="{
							path: 'billingReleases>AvailableQuantity',
              type: 'sap.ui.model.type.Float',
							formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }}"
							wrapping="false"
						/>
					</t:template>
				</t:Column>
				<t:Column width="3rem">
					<Label text="Um" />
					<t:template>
						<Text text="{billingReleases>UnitOfMeasureCode}" wrapping="false"/>
					</t:template>
				</t:Column>
				<t:Column width="10rem" hAlign="End" sortProperty="SalesContractAvailableVolume">
					<Label text="Saldo Contrato" />
					<t:template>
						<!-- Negativo em vermelho para o usuario ver o que esta fazendo: o faturamento
						     aceita, mas ele decide com o numero a vista. -->
						<ObjectNumber
							textAlign="End"
							state="{= ${billingReleases>SalesContractAvailableVolume} &lt; 0 ? 'Error' : 'None' }"
							number="{
								path: 'billingReleases>SalesContractAvailableVolume',
								type: 'sap.ui.model.type.Float',
								formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
							}"/>
					</t:template>
				</t:Column>
				<t:Column width="9rem">
					<Label text="Situação Contrato" />
					<t:template>
						<Text
							wrapping="false"
							text="{
								path: 'billingReleases>SalesContractStatus',
								targetType: 'any',
								formatter: '.formatter.formatContractStatus'
							}"/>
					</t:template>
				</t:Column>
			</t:columns>
		</t:Table>

		<buttons>
			<Button
				text="Fechar"
				press=".closeBillingDialog"
				type="Transparent"
			/>
			<Button
				text="Confirmar"
				press=".saveBillingDialog"
				type="Emphasized"
			/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>
