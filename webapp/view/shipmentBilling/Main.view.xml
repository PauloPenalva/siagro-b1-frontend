<mvc:View
	controllerName="siagrob1.controller.shipmentBilling.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
  xmlns:f="sap.f"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">
  <f:DynamicPage busyIndicatorDelay="0" busy="{ui>/busy}">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="Faturamento de Expedição"/>
        </f:heading>
			</f:DynamicPageTitle>
    </f:title>
		<f:content>
      <!-- Lista CARGAS, não romaneios: o agrupamento deixou de existir só no instante do
           faturamento e virou documento próprio, com saldo. Seleção Single porque uma nota
           consome de UMA carga — a aglutinação já foi decidida na Montagem. -->
      <t:Table
				id="shipmentBillingTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
        rows="{
					path: '/ShipmentLoads',
          sorter: [ { path: 'RowId' } ],
          parameters: { $select: 'BranchCode' }
				}"
			>
				<t:extension>
					<OverflowToolbar >
            <Title text="Cargas Montadas" />
						<ToolbarSpacer />
						<Button type="Emphasized" text="Faturar" press=".openBillingDialog"/>
            <SearchField width="30%" placeholder="Pesquisar carga ou placa..." search=".onSearch" />
					</OverflowToolbar>
				</t:extension>
				<t:columns>
          <t:Column label="Key" visible="false" width="10rem">
						<t:template>
							<Text text="{Key}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column label="Filial" sortProperty="Branch/ShortName" width="5rem">
						<t:template>
							<Text text="{Branch/ShortName}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column label="Status" sortProperty="Status" hAlign="Center" width="10rem">
						<t:template>
							<ObjectStatus
                inverted="true"
                state="{
                  path: 'Status',
                  targetType: 'any',
                  formatter: '.formatter.stateShipmentLoadStatus'
                }"
                text="{
                  path: 'Status',
                  targetType: 'any',
                  formatter: '.formatter.formatShipmentLoadStatus'
                }"/>
						</t:template>
					</t:Column>
          <t:Column label="Carga" sortProperty="Code" width="8rem">
						<t:template>
							<Text text="{Code}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column label="Data" sortProperty="LoadDate" width="8rem">
						<t:template>
              <Text
                wrapping="false"
                text="{
                  path: 'LoadDate',
                  targetType: 'any',
                  formatter: '.formatter.formatDate'
                }"/>
						</t:template>
					</t:Column>
          <t:Column label="Veículo" sortProperty="TruckCode" width="6rem">
						<t:template>
              <Text text="{TruckCode}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column label="Motorista" width="6rem">
						<t:template>
              <Text text="{TruckDriverCode}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column label="Produto" sortProperty="ItemCode" width="15rem">
						<t:template>
              <Text text="({ItemCode}) {ItemName}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column label="Armazem" sortProperty="WarehouseCode" width="15rem">
						<t:template>
              <Text text="({WarehouseCode}) {WarehouseName}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column label="Qtd. Total" sortProperty="TotalQuantity" hAlign="End" width="8rem">
						<t:template>
              <ObjectNumber
                textAlign="End"
                number="{
                  path: 'TotalQuantity',
                  type: 'sap.ui.model.type.Float',
                  formatOptions:{ decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
                }"
                unit="{UnitOfMeasureCode}"/>
						</t:template>
					</t:Column>
          <t:Column label="Qtd. Faturada" sortProperty="InvoicedQuantity" hAlign="End" width="8rem">
						<t:template>
              <ObjectNumber
                textAlign="End"
                number="{
                  path: 'InvoicedQuantity',
                  type: 'sap.ui.model.type.Float',
                  formatOptions:{ decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
                }"
                unit="{UnitOfMeasureCode}"/>
						</t:template>
					</t:Column>
          <t:Column label="Saldo" hAlign="End" width="8rem">
						<t:template>
              <ObjectNumber
                textAlign="End"
                emphasized="true"
                number="{
                  path: 'AvailableQuantity',
                  type: 'sap.ui.model.type.Float',
                  formatOptions:{ decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
                }"
                unit="{UnitOfMeasureCode}"/>
						</t:template>
					</t:Column>
				</t:columns>

			</t:Table>

    </f:content>

  </f:DynamicPage>

</mvc:View>
