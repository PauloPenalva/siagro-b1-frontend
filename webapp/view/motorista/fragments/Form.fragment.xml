<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="formMotorista"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Dados do Motorista"
              emphasized="true"
          />
          <Label text="CPF" />
          <!-- O CPF é o código do motorista: o CT-e e o MDF-e o leem daqui. O backend tira a máscara. -->
          <Input
              id="cpfInput"
              value="{Code}"
              required="true"
              maxLength="14"
              placeholder="000.000.000-00"
          />
          <Label text="Nome" />
          <Input
              value="{Name}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Documento (RG/CNH)" />
          <Input
              value="{Document}"
              editable="true"
              maxLength="100"
          />
          <Label text="Telefone" />
          <Input
              value="{Phone}"
              editable="true"
              maxLength="100"
          />
          <Label text="Inativo" />
          <CheckBox selected="{Inactive}" />

          <core:Title text="CNH" />
          <Label text="Número da CNH" />
          <Input value="{LicenseNumber}" maxLength="11" type="Number" />
          <Label text="Categoria" />
          <Select selectedKey="{LicenseCategory}" forceSelection="false" change=".onNullableSelectChange">
            <core:Item key="" text="" />
            <core:Item key="A" text="A" />
            <core:Item key="B" text="B" />
            <core:Item key="C" text="C" />
            <core:Item key="D" text="D" />
            <core:Item key="E" text="E" />
            <core:Item key="AB" text="AB" />
            <core:Item key="AC" text="AC" />
            <core:Item key="AD" text="AD" />
            <core:Item key="AE" text="AE" />
          </Select>
          <Label text="Validade da CNH" />
          <DatePicker
              value="{ path: 'LicenseExpiresOn', type: 'sap.ui.model.odata.type.Date' }"
              valueState="{ path: 'LicenseExpiresOn', targetType: 'any', formatter: 'formatter.licenseState' }"
              valueStateText="CNH vencida ou a vencer em até 30 dias." />
        </f:content>
        <core:Title />
        <core:Title />
    </f:SimpleForm>
</core:FragmentDefinition>
