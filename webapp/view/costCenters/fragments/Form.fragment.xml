<core:FragmentDefinition
    core:require="{
        StringType: 'sap/ui/model/type/String'
    }"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="costCentersForm"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Dados do Centro de Custo"
              emphasized="true"
          />
          <Label text="Codigo" />
          <Input
              value="{Code}"
              required="true"
              maxLength="10"
          />
          <Label text="Nome" />
          <Input
              value="{Name}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Dimensão" visible="{dims>/items/0/Active}" />
          <Select
            forceSelection="false"
            selectedKey="{path: 'DimensionNumber', mode: 'OneWay'}"
            change=".onDimensionChange"
            visible="{dims>/items/0/Active}"
            items="{
              path: 'dims>/items',
              filters: [{ path: 'Active', operator: 'EQ', value1: true }]
            }">
            <core:Item
              key="{ path: 'dims>Number', type: 'StringType' }"
              text="{dims>Name}" />
          </Select>
          <Label text="Inativo ?" />
          <CheckBox
            selected="{Inactive}"
          />
        </f:content>
        <core:Title />
        <core:Title />
    </f:SimpleForm>
</core:FragmentDefinition>
