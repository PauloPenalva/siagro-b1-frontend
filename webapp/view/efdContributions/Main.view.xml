<mvc:View
	controllerName="siagrob1.controller.efdContributions.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="EFD Contribuições (PIS/COFINS)" showNavButton="true" navButtonPress=".onNavBack" busyIndicatorDelay="0" busy="{ui>/busy}">
		<content>
			<f:Form id="efdContributionsForm" editable="true">
				<f:layout>
					<f:ColumnLayout columnsM="1" columnsL="2" columnsXL="2"/>
				</f:layout>
				<f:formContainers>
					<f:FormContainer title="Período">
						<f:formElements>
							<f:FormElement label="Filial">
								<f:fields>
									<Input id="branchInput" required="true" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".openBranchsValueHelp" value="{params>/BranchCode}" change=".onParamsChanged">
										<layoutData>
											<f:ColumnElementData cellsLarge="4" cellsSmall="4"/>
										</layoutData>
										<customData>
											<core:CustomData key="descriptionProperty" value="BranchName:ShortName"/>
										</customData>
									</Input>
									<Input value="{params>/BranchName}" editable="false"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Mês">
								<DatePicker id="monthPicker" required="true" value="{params>/Month}" valueFormat="yyyy-MM-dd" displayFormat="MM/yyyy" change=".onParamsChanged"/>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
					<f:FormContainer title="Finalidade">
						<f:formElements>
							<f:FormElement label="Finalidade">
								<Select selectedKey="{params>/Purpose}" change=".onParamsChanged">
									<core:Item key="0" text="Original"/>
									<core:Item key="1" text="Retificadora"/>
								</Select>
							</f:FormElement>
							<f:FormElement label="Nº do recibo anterior" visible="{= ${params>/Purpose} === '1' }">
								<Input id="previousReceiptInput" value="{params>/PreviousReceiptNumber}" maxLength="41" required="true" change=".onParamsChanged"/>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>

			<MessageStrip
				visible="{check>/checked}"
				class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom"
				showIcon="true"
				type="{= ${check>/blockingCount} &gt; 0 ? 'Error' : ${check>/warningCount} &gt; 0 ? 'Warning' : 'Success' }"
				text="{= ${check>/blockingCount} &gt; 0 ? ${check>/blockingCount} + ' inconsistência(s) bloqueante(s): corrija antes de gerar o arquivo.' : ${check>/warningCount} &gt; 0 ? 'Sem bloqueios; ' + ${check>/warningCount} + ' aviso(s).' : 'Nenhuma inconsistência encontrada.' }"/>

			<HBox class="sapUiSmallMargin" wrap="Wrap" visible="{check>/checked}">
				<VBox class="sapUiMediumMarginEnd">
					<Title text="PIS" level="H4"/>
					<ObjectNumber state="Error" unit="Devido" emphasized="true" number="{ path: 'check>/totals/pisDue', formatter: 'formatter.formatDecimal2' }"/>
					<ObjectNumber state="Success" unit="Crédito descontado" emphasized="true" number="{ path: 'check>/totals/pisCredit', formatter: 'formatter.formatDecimal2' }"/>
					<ObjectNumber emphasized="true" unit="A recolher" number="{ path: 'check>/totals/pisPayable', formatter: 'formatter.formatDecimal2' }"/>
				</VBox>
				<VBox class="sapUiMediumMarginEnd">
					<Title text="COFINS" level="H4"/>
					<ObjectNumber state="Error" unit="Devido" emphasized="true" number="{ path: 'check>/totals/cofinsDue', formatter: 'formatter.formatDecimal2' }"/>
					<ObjectNumber state="Success" unit="Crédito descontado" emphasized="true" number="{ path: 'check>/totals/cofinsCredit', formatter: 'formatter.formatDecimal2' }"/>
					<ObjectNumber emphasized="true" unit="A recolher" number="{ path: 'check>/totals/cofinsPayable', formatter: 'formatter.formatDecimal2' }"/>
				</VBox>
			</HBox>

			<Table id="issuesTable" items="{check>/issues}" visible="{check>/checked}" class="sapUiSizeCondensed sapUiSmallMarginBeginEnd" width="auto" noDataText="Nenhuma inconsistência." growing="true" growingThreshold="100">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="Inconsistências"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column width="8rem"><Text text="Gravidade"/></Column>
					<Column width="14rem"><Text text="Referência"/></Column>
					<Column><Text text="Mensagem"/></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectStatus text="{= ${check>blocking} ? 'Bloqueante' : 'Aviso' }" state="{= ${check>blocking} ? 'Error' : 'Warning' }"/>
							<Text text="{check>reference}"/>
							<Text text="{check>message}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer/>
				<Button text="Verificar" icon="sap-icon://inspect" press=".onCheck"/>
				<Button text="Gerar arquivo" type="Emphasized" icon="sap-icon://download" press=".onGenerate"
					enabled="{= ${check>/checked} &amp;&amp; ${check>/blockingCount} === 0 }"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
