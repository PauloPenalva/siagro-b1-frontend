<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="formBranchs"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Dados da Filial"
              emphasized="true"
          />
          <Label text="Codigo" />
          <Input
              value="{Code}"
              required="true"
              maxLength="11"
          />
          <Label text="Nome" />
          <Input
              value="{BranchName}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Nome Curto" />
          <Input
              value="{ShortName}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="CNPJ" />
          <Input
              value="{TaxId}"
              editable="true"
              maxLength="14"
          />
          <Label text="UF" />
          <Input
              value="{StateCode}"
              editable="true"
              required="true"
              showValueHelp="true"
              valueHelpOnly="true"
              valueHelpRequest=".openStatesAbbreviationValueHelp"
              maxLength="2"
          />
          <!-- NF-e STANDALONE: ocultos em SAPB1, onde a emissão é do SAP. Com a chave ligada o
               servidor exige CRT e UF. Sem item vazio de propósito: o enum não aceita "" e
               desligar a chave dispensa o CRT. -->
          <Label text="Regime tributário (CRT)" visible="{ui>/standalone}" />
          <Select
            visible="{ui>/standalone}"
            selectedKey="{ path: 'TaxRegime', targetType: 'any' }"
            forceSelection="false">
            <core:ListItem key="SimplesNacional" text="1 - Simples Nacional" />
            <core:ListItem key="SimplesNacionalExcess" text="2 - Simples Nacional, excesso de sublimite" />
            <core:ListItem key="Normal" text="3 - Regime normal" />
            <core:ListItem key="Mei" text="4 - MEI" />
          </Select>
          <Label text="Emite NF-e pelo Siagro ?" visible="{ui>/standalone}" />
          <CheckBox selected="{IssuesNfe}" visible="{ui>/standalone}" />
        </f:content>
        <core:Title />
        <core:Title />
    </f:SimpleForm>
</core:FragmentDefinition>
