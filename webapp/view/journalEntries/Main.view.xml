<mvc:View
	controllerName="siagrob1.controller.journalEntries.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">

	<Page title="Lançamentos Contábeis" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<OverflowToolbar class="sapUiSmallMarginBeginEnd">
				<Label text="De" />
				<DatePicker width="9rem" value="{filter>/DateFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" />
				<Label text="Até" />
				<DatePicker width="9rem" value="{filter>/DateTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" />
				<Label text="Lote" />
				<Input width="6rem" value="{filter>/Batch}" maxLength="6" />
				<Label text="Origem" />
				<Select width="10rem" selectedKey="{filter>/Origin}">
					<core:Item key="" text="Todas" />
					<core:Item key="Manual" text="Manual" />
					<core:Item key="StandardPosting" text="Lançamento padrão" />
					<core:Item key="ResultClosing" text="Apuração" />
					<core:Item key="Reversal" text="Estorno" />
				</Select>
				<Label text="Filial" />
				<Input width="7rem" value="{filter>/BranchCode}" showValueHelp="true" valueHelpOnly="true" showClearIcon="true"
					valueHelpRequest=".openBranchsValueHelp" />
				<Button text="Filtrar" icon="sap-icon://filter" type="Emphasized" press=".onRefresh" />
			</OverflowToolbar>
			<t:Table
				id="journalEntriesTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/JournalEntries',
					parameters: { $expand: 'Lines($select=LineNumber,EntryType,Amount,History)' },
					sorter: [ { path: 'PostingDate', descending: true }, { path: 'DocEntry', descending: true } ],
					suspended: true
				}">
				<t:columns>
					<t:Column label="Data" width="7rem" hAlign="Center">
						<t:template><Text text="{ path: 'PostingDate', type: 'sap.ui.model.odata.type.Date', formatOptions: { pattern: 'dd/MM/yyyy' } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Lote/Doc" width="8rem">
						<t:template><Link text="{Batch}/{DocumentNumber}" press=".onOpen" /></t:template>
					</t:Column>
					<t:Column label="Filial" width="5rem">
						<t:template><Text text="{BranchCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Origem" width="9rem">
						<t:template><Text text="{ path: 'Origin', targetType: 'any', formatter: '.originText' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="LP" width="4rem">
						<t:template><Text text="{StandardPostingCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Histórico">
						<t:template><Text text="{ path: 'Lines', targetType: 'any', formatter: '.firstHistory' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Valor" width="9rem" hAlign="End">
						<t:template><Text text="{ path: 'Lines', targetType: 'any', formatter: '.totalDebit' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Estorno" width="8rem">
						<t:template>
							<ObjectStatus
								text="{= ${ReversedByDocEntry} ? 'Estornado' : ${ReversalOfDocEntry} ? 'É estorno' : '' }"
								state="{= ${ReversedByDocEntry} ? 'Warning' : 'Information' }" />
						</t:template>
					</t:Column>
					<t:Column label="Incluído por" width="8rem">
						<t:template><Text text="{CreatedBy}" wrapping="false" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
