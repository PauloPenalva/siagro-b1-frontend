<mvc:View
	controllerName="siagrob1.controller.journalEntries.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:t="sap.ui.table">

	<Page title="Lançamento {doc>/Batch}/{doc>/DocumentNumber}" showNavButton="true" navButtonPress=".onNavBack" busyIndicatorDelay="0">
		<content>
			<f:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsL="3" columnsXL="3" labelSpanL="4" labelSpanXL="4">
				<f:content>
					<core:Title text="Documento" />
					<Label text="Data" />
					<Text text="{ path: 'doc>/PostingDate', formatter: '.dateText' }" />
					<Label text="Lote / Sublote / Doc" />
					<Text text="{doc>/Batch} / {doc>/SubBatch} / {doc>/DocumentNumber}" />
					<Label text="Filial" />
					<Text text="{doc>/BranchCode}" />
					<core:Title text="Origem" />
					<Label text="Origem" />
					<Text text="{ path: 'doc>/Origin', formatter: '.originText' }" />
					<Label text="Lançamento padrão" />
					<Text text="{doc>/StandardPostingCode}" />
					<Label text="Documento de origem" />
					<Text text="{doc>/SourceDocumentType} {doc>/SourceDocumentKey} {doc>/SourceEvent}" />
					<core:Title text="Controle" />
					<Label text="Incluído por" />
					<Text text="{doc>/CreatedBy}" />
					<Label text="Estorno" />
					<HBox>
						<Link text="Estornado pelo doc. {doc>/ReversedByDocEntry}" visible="{= !!${doc>/ReversedByDocEntry} }" press=".onOpenReversedBy" />
						<Link text="Estorna o doc. {doc>/ReversalOfDocEntry}" visible="{= !!${doc>/ReversalOfDocEntry} }" press=".onOpenReversalOf" />
					</HBox>
					<Label text="Observação" />
					<Text text="{doc>/Comments}" />
				</f:content>
			</f:SimpleForm>
			<t:Table
				id="journalEntryLinesTable"
				selectionMode="None"
				class="sapUiSizeCondensed sapUiSmallMarginBeginEnd"
				visibleRowCountMode="Auto"
				minAutoRowCount="5"
				alternateRowColors="true"
				rows="{ path: 'doc>/Lines' }">
				<t:columns>
					<t:Column label="Linha" width="4rem" hAlign="End">
						<t:template><Text text="{doc>LineNumber}" /></t:template>
					</t:Column>
					<t:Column label="Tipo" width="9rem">
						<t:template><Text text="{ path: 'doc>EntryType', formatter: '.entryTypeText' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Débito" width="8rem">
						<t:template><Text text="{doc>DebitAccountCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Crédito" width="8rem">
						<t:template><Text text="{doc>CreditAccountCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Valor" width="9rem" hAlign="End">
						<t:template><Text text="{ path: 'doc>Amount', formatter: '.formatMoney' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Histórico">
						<t:template><Text text="{doc>History}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="C.Custo D" width="6rem">
						<t:template><Text text="{doc>DebitCostCenterCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="C.Custo C" width="6rem">
						<t:template><Text text="{doc>CreditCostCenterCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Item D" width="6rem">
						<t:template><Text text="{doc>DebitAccountingItemCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Item C" width="6rem">
						<t:template><Text text="{doc>CreditAccountingItemCode}" wrapping="false" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer />
				<Button text="Estornar" icon="sap-icon://undo" type="Reject"
					enabled="{= !${doc>/ReversedByDocEntry} &amp;&amp; !${doc>/ReversalOfDocEntry} }" press=".onReverse" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
