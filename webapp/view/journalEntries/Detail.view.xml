<mvc:View
	controllerName="siagrob1.controller.journalEntries.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:t="sap.ui.table">

	<Page title="Lançamento {Batch}/{DocumentNumber}" showNavButton="true" navButtonPress=".onNavBack" busyIndicatorDelay="0">
		<content>
			<f:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsL="3" columnsXL="3" labelSpanL="4" labelSpanXL="4">
				<f:content>
					<core:Title text="Documento" />
					<Label text="Data" />
					<Text text="{ path: 'PostingDate', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { precision: 7 }, formatOptions: { pattern: 'dd/MM/yyyy', UTC: true } }" />
					<Label text="Lote / Sublote / Doc" />
					<Text text="{Batch} / {SubBatch} / {DocumentNumber}" />
					<Label text="Filial" />
					<Text text="{BranchCode}" />
					<core:Title text="Origem" />
					<Label text="Origem" />
					<Text text="{ path: 'Origin', targetType: 'any', formatter: '.originText' }" />
					<Label text="Lançamento padrão" />
					<Text text="{StandardPostingCode}" />
					<Label text="Documento de origem" />
					<Text text="{SourceDocumentType} {SourceDocumentKey} {SourceEvent}" />
					<core:Title text="Controle" />
					<Label text="Incluído por" />
					<Text text="{CreatedBy}" />
					<Label text="Estorno" />
					<HBox>
						<Link text="Estornado pelo doc. {ReversedByDocEntry}" visible="{= !!${ReversedByDocEntry} }" press=".onOpenReversedBy" />
						<Link text="Estorna o doc. {ReversalOfDocEntry}" visible="{= !!${ReversalOfDocEntry} }" press=".onOpenReversalOf" />
					</HBox>
					<Label text="Observação" />
					<Text text="{Comments}" />
				</f:content>
			</f:SimpleForm>
			<t:Table
				id="journalEntryLinesTable"
				selectionMode="None"
				class="sapUiSizeCondensed sapUiSmallMarginBeginEnd"
				visibleRowCountMode="Auto"
				minAutoRowCount="5"
				alternateRowColors="true"
				rows="{ path: 'Lines', sorter: { path: 'LineNumber' } }">
				<t:columns>
					<t:Column label="Linha" width="4rem" hAlign="End">
						<t:template><Text text="{LineNumber}" /></t:template>
					</t:Column>
					<t:Column label="Tipo" width="9rem">
						<t:template><Text text="{ path: 'EntryType', targetType: 'any', formatter: '.entryTypeText' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Débito" width="8rem">
						<t:template><Text text="{DebitAccountCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Crédito" width="8rem">
						<t:template><Text text="{CreditAccountCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Valor" width="9rem" hAlign="End">
						<t:template><Text text="{ path: 'Amount', targetType: 'any', formatter: '.formatMoney' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Histórico">
						<t:template><Text text="{History}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="C.Custo D" width="6rem">
						<t:template><Text text="{DebitCostCenterCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="C.Custo C" width="6rem">
						<t:template><Text text="{CreditCostCenterCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Item D" width="6rem">
						<t:template><Text text="{DebitAccountingItemCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Item C" width="6rem">
						<t:template><Text text="{CreditAccountingItemCode}" wrapping="false" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer />
				<Button text="Estornar" icon="sap-icon://undo" type="Reject"
					enabled="{= !${ReversedByDocEntry} &amp;&amp; !${ReversalOfDocEntry} }" press=".onReverse" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
