<mvc:View
	controllerName="siagrob1.controller.managementViews.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:t="sap.ui.table">

	<Page title="Visão Gerencial" showNavButton="true" navButtonPress=".onNavBack" busyIndicatorDelay="0">
		<content>
			<MessageStrip
				text="Estrutura da DRE e do Balanço. Linhas Contas somam as contas analíticas da faixa; Total soma as linhas filhas; Fórmula soma ou subtrai outras linhas (ex.: 01 - 02). Preencha as faixas conforme o seu plano de contas."
				type="Information" showIcon="true" class="sapUiSmallMargin" />
			<t:Table selectionMode="None" class="sapUiSizeCondensed" visibleRowCountMode="Auto" alternateRowColors="true" rows="{mv>/Rows}">
				<t:columns>
					<t:Column label="Código" width="8rem"><t:template><Link text="{mv>Code}" press=".onOpen" /></t:template></t:Column>
					<t:Column label="Nome"><t:template><Text text="{mv>Name}" wrapping="false" /></t:template></t:Column>
					<t:Column label="Tipo" width="8rem"><t:template><Text text="{mv>TypeText}" /></t:template></t:Column>
					<t:Column label="Linhas" width="6rem" hAlign="End"><t:template><Text text="{mv>LineCount}" /></t:template></t:Column>
					<t:Column label="Faixas a preencher" width="10rem" hAlign="End">
						<t:template><ObjectStatus text="{mv>EmptyRanges}" state="{= ${mv>EmptyRanges} > 0 ? 'Warning' : 'Success' }" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Nova visão" type="Emphasized" icon="sap-icon://add" press=".onNew" />
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
