<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
<!-- TODO Task 6: substituir por AccountingAssignmentFields (Centro de Custo, Item Contábil, Rateio, Conta Contábil).
     Enquanto isso só a conta contábil, que continua existindo. Visível só em STANDALONE. -->
<f:FormElement label="Conta contábil" visible="{= ${sessionModel>/erp} === 'STANDALONE' }">
  <f:fields>
    <Input
      editable="{ui>/editable}"
      value="{LedgerAccountCode}"
      showValueHelp="true"
      valueHelpOnly="true"
      valueHelpRequest=".openPostingLedgerAccountsValueHelp" />
  </f:fields>
</f:FormElement>
</core:FragmentDefinition>
