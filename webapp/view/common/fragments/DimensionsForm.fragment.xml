<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
<!-- Seção "Dimensões gerenciais" autônoma: envolve DimensionFields num f:Form.
     Para telas que não são Form (SimpleForm, diálogos). Oculta em SAPB1. TODO Task 6: substituir. -->
<f:Form editable="true" visible="{= ${sessionModel>/erp} === 'STANDALONE' }">
  <f:layout>
    <f:ColumnLayout columnsM="2" columnsL="3" columnsXL="3" />
  </f:layout>
  <f:formContainers>
    <f:FormContainer title="Dimensões gerenciais">
      <f:formElements>
        <core:Fragment fragmentName="siagrob1.view.common.fragments.DimensionFields" type="XML" />
      </f:formElements>
    </f:FormContainer>
  </f:formContainers>
</f:Form>
</core:FragmentDefinition>
