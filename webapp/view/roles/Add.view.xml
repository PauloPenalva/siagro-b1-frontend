<mvc:View
	controllerName="siagrob1.controller.roles.Add"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.ui.layout.form"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Função">
		<content>
      <core:Fragment fragmentName="siagrob1.view.roles.fragments.Form" type="XML" />
      <IconTabBar expandable="false">
        <items>
          <IconTabFilter text="Menus" >
            <content>
              <core:Fragment fragmentName="siagrob1.view.roles.fragments.Menus" type="XML" />
            </content>
          </IconTabFilter>
          <IconTabFilter text="Permissões" >
            <content>
              <core:Fragment fragmentName="siagrob1.view.roles.fragments.Permissions" type="XML" />
            </content>
          </IconTabFilter>
        </items>
      </IconTabBar>
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="Cancelar" press=".onCancel"  />
				<Button text="Salvar" type="Emphasized" press=".onSave"/>
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
