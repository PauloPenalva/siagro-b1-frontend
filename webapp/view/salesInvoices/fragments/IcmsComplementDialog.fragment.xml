<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog
		core:require="{ Float: 'sap/ui/model/type/Float' }"
		title="Complementar ICMS"
		contentWidth="64rem"
		class="sapUiSizeCompact"
		busy="{icmsComplement>/busy}"
		busyIndicatorDelay="0">
		<content>
			<!-- Uma linha por item da venda, base e ICMS zerados. Item deixado com os dois zerados fica de fora do
			     complemento. O mínimo zero do tipo Float marca em vermelho o valor negativo, e o Confirmar recusa. -->
			<Table items="{icmsComplement>/rows}">
				<columns>
					<Column><Text text="Produto" /></Column>
					<Column><Text text="Descrição" /></Column>
					<Column hAlign="End"><Text text="Quantidade" /></Column>
					<Column hAlign="End"><Text text="Valor" /></Column>
					<Column hAlign="End" width="11rem"><Text text="Base ICMS" /></Column>
					<Column hAlign="End" width="11rem"><Text text="ICMS" /></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{icmsComplement>ItemCode}" />
							<Text text="{icmsComplement>ItemName}" />
							<Text text="{ path: 'icmsComplement>Quantity', type: 'Float', formatOptions: { minFractionDigits: 3, maxFractionDigits: 3 } }" />
							<Text text="{ path: 'icmsComplement>Total', type: 'Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" />
							<Input
								textAlign="End"
								value="{ path: 'icmsComplement>IcmsBase', type: 'Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 }, constraints: { minimum: 0 } }" />
							<Input
								textAlign="End"
								value="{ path: 'icmsComplement>IcmsValue', type: 'Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 }, constraints: { minimum: 0 } }" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<beginButton>
			<Button text="Complementar ICMS" type="Emphasized" press=".onConfirmIcmsComplement" />
		</beginButton>
		<endButton>
			<Button text="Cancelar" press=".onCloseIcmsComplement" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
