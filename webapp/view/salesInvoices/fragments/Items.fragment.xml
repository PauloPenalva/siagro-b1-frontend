<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    core:require="{ DoubleType: 'sap/ui/model/odata/type/Double', charges: 'siagrob1/helpers/InvoiceChargeTotalsHelpers' }"
>
  <t:Table
    id="tableSalesInvoicesItems"
    class="sapUiSizeCondensed"
    alternateRowColors="true"
    enableBusyIndicator="true"
    enableSelectAll="false"
    selectionBehavior="Row"
    selectionMode="Single"
    busyIndicatorDelay="0"
    rows="{Items}"
    visible="true"
    >
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Itens do Documento de Saída" />
          <ToolbarSpacer />
          <Button
            visible="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            text="Incluir"
            type="Transparent"
            icon="sap-icon://add"
            press=".onAddItem"
          />
          <Button
            visible="{ui>/editable}"
            text="Remover"
            type="Transparent"
            icon="sap-icon://delete"
            press=".onRemoveItem"
          />
          <Button
            text="Fiscal"
            type="Transparent"
            icon="sap-icon://official-service"
            press=".onOpenItemFiscal"
          />
          <ToolbarSpacer />
          <!-- Total geral do documento (itens + frete + seguro + outras despesas − desconto). Somado no cliente pelo mesmo motivo do total da linha: GrandTotal é [NotMapped] e não existe antes de salvar. -->
          <!-- IBS/CBS: informativo em 2026, fora do total do documento. Só com a tributação
               STANDALONE ativa; vem do servidor (NotMapped), então aparece depois de gravar. -->
          <ObjectNumber
            visible="{= ${ui>/taxLocked} === true }"
            class="sapUiSmallMarginEnd"
            number="{
              path: 'TotalInvoiceIbsCbs',
              type: 'sap.ui.model.odata.type.Decimal',
              constraints: { precision: 18, scale: 2 },
              formatOptions: { decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
            }"
            unit="IBS/CBS"
            state="None"
          />
          <ObjectNumber
            id="salesInvoiceDocumentTotal"
            number="{ui>/documentTotal}"
            unit="Total do Documento"
            emphasized="true"
            state="None"
          />
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <t:Column label="Produto">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            width="10rem"
            required="true"
            value="{ItemCode}" 
            showValueHelp="true" 
            valueHelpOnly="true" 
            valueHelpRequest=".openItemValueHelp">
              <customData>
                <core:CustomData key="descriptionProperty" value="ItemName" />
              </customData>
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="Descricao">
        <t:template>
          <Text text="{ItemName}" />
        </t:template>
      </t:Column>
      <t:Column label="Quantidade">
        <t:template>
          <Input
              required="true"
              editable="{ui>/editable}"
              change=".onItemAmountChange"
              value="{
                path: 'Quantity',
                type: 'sap.ui.model.odata.type.Double',
                formatOptions: {
                    decimals: 0,
                    decimalSeparator: ',',
                    groupingEnabled: true,
                    groupingSeparator: '.'
                }
              }"
          />
        </t:template>
      </t:Column>
      <!-- GAC-1171 (rateio): quanto da linha já voltou em devolução confirmada. Só no Detalhe: na
           inclusão e na edição o contexto é JSON e a coluna não existe. -->
      <t:Column label="Qtd. Devolvida" hAlign="End" visible="{= !${ui>/editable} }">
        <t:template>
          <ObjectNumber
            textAlign="End"
            number="{ path: 'ReturnedQuantity', type: 'sap.ui.model.type.Float', formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' } }"/>
        </t:template>
      </t:Column>
       <t:Column label="Und.Med.">
        <t:template>
          <Input 
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            required="true"
            value="{UnitOfMeasureCode}" 
            showValueHelp="true" 
            valueHelpOnly="true" 
            valueHelpRequest=".openUnitsOfMeasureValueHelp">
            <layoutData>
                <l:GridData span="XL3 L3 M3 S4" />
            </layoutData>
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="Valor Unitário">
        <t:template>
          <Input
              required="true"
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
              change=".onItemAmountChange"
              value="{
                path: 'UnitPrice',
                type: 'sap.ui.model.odata.type.Double',
                formatOptions: {
                    decimals: 8,
                    decimalSeparator: ',',
                    groupingEnabled: true,
                    groupingSeparator: '.'
                }
              }"
          />
        </t:template>
      </t:Column>
      <!-- Frete, seguro, desconto e outras despesas da linha (spec 2026-10-05 §10). Campo de ESCRITA de decimal usa
           `Double`, nunca `Decimal` (o backend recusa Edm.Decimal em string). Editáveis também na devolução Pendente
           (vêm da venda na proporção do que volta). -->
      <t:Column label="Frete" hAlign="End" width="8rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'FreightValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Seguro" hAlign="End" width="8rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'InsuranceValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Desconto" hAlign="End" width="8rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'DiscountValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Outras despesas" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'OtherExpensesValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Total">
        <t:template>
          <!-- Total geral da linha (itens + frete + seguro + outras despesas − desconto), calculado no cliente: `GrandTotal`
               é [NotMapped] e só existe depois que o servidor responde. `targetType: 'any'` em cada parte é obrigatório —
               sem ele o binding composto entrega texto. -->
          <Text
              text="{
                parts: [
                  { path: 'Quantity', targetType: 'any' },
                  { path: 'UnitPrice', targetType: 'any' },
                  { path: 'FreightValue', targetType: 'any' },
                  { path: 'InsuranceValue', targetType: 'any' },
                  { path: 'DiscountValue', targetType: 'any' },
                  { path: 'OtherExpensesValue', targetType: 'any' }
                ],
                formatter: 'charges.formatLineGrandTotal'
              }"
          />
        </t:template>
      </t:Column>
      <!-- Duas colunas para o mesmo dado, uma visível de cada vez.
           O item guarda SalesContractKey (GUID) e lê o código por navegação
           (SalesContract/Code), que é somente leitura: não dá para um Input escrever
           nele. Então a escolha do contrato só aparece onde há linha nova para
           preencher (inclusão), e o resto das telas continua com o texto navegado.
           `canPickContract` PRECISA ser inicializado como false nas outras telas —
           binding indefinido faz `visible` valer true. -->
      <t:Column label="Contrato" visible="{= !${ui>/canPickContract} }">
        <t:template>
          <Text text="{SalesContract/Code}" />
        </t:template>
      </t:Column>
      <t:Column label="Contrato" visible="{ui>/canPickContract}">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openSalesContractValueHelp" />
        </t:template>
      </t:Column>
      <!-- Natureza de operação por LINHA, como no SAP. O Input mostra o nome desnormalizado
           (UsageName) e o value help grava também o UsageCode, que é quem vale para o
           servidor — mesmo desenho do contrato. -->
      <t:Column label="Natureza de Operação" width="14rem">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            required="true"
            value="{UsageName}"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openUsageValueHelp" />
        </t:template>
      </t:Column>
      <t:Column label="CFOP" width="6rem">
        <t:template>
          <!-- Resolvido da natureza de operação na gravação. Somente leitura: o documento
               emitido não muda se o cadastro mudar depois. -->
          <Text text="{Cfop}" />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
