<mvc:View
	controllerName="siagrob1.controller.salesInvoices.openReconciliation.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
  xmlns:f="sap.f"
  xmlns:mdc="sap.ui.mdc"
  xmlns:fb="sap.ui.comp.filterbar"
  xmlns:vm="sap.ui.fl.variants"
  xmlns:svm="sap.ui.comp.smartvariants"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">
  <f:DynamicPage busyIndicatorDelay="0" busy="{ui>/busy}">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <Title text="Conferencia de entregas - Estorno"/>
        </f:heading>
			</f:DynamicPageTitle>
    </f:title>
    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <f:content>
          <core:Fragment fragmentName="siagrob1.view.salesInvoices.fragments.ReconciliationFilterbar" type="XML" />
        </f:content>
      </f:DynamicPageHeader>
    </f:header>
		<f:content>
      <!--
        Sem $filter estático no binding: quem monta o filtro é o applyFilters do controller,
        a partir da filterbar. O escopo fixo da tela (documento normal e confirmado, entrega
        JÁ encerrada) virou a constante SCOPE de lá e continua entrando em toda requisição.
      -->
      <t:Table
				id="tableSalesInvoicesOpenReconciliation"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
        rows="{
					path: '/SalesInvoicesItems',
          sorter: [
            { path: 'SalesInvoice/RowId' }
          ]
				}"
			>
				<t:extension>
					<OverflowToolbar >
            <Title text="Itens do Documento de Saída (Encerrados)" />
						<ToolbarSpacer />
						<Button type="Emphasized" text="Salvar" press=".onSave"/>
            <Button type="Transparent" text="Cancelar Digitação" press=".onCancel"/>
						<!-- <Button type="Transparent" text="Exportar Excel" press=".onExcel"/> -->
					</OverflowToolbar>
				</t:extension>
				<t:columns>
          <t:Column
						label="Key"
            visible="false"
            width="10rem"
            >
						<t:template>
							<Text text="{Key}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column 
            filterProperty="SalesInvoice/Branch/ShortName"
            width="6rem"
            sortProperty="SalesInvoice/Branch/ShortName"
          >
            <Label text="Filial" />
            <t:template>
              <Text
                text="{SalesInvoice/Branch/ShortName}"
                wrapping="false"
              />
            </t:template>
          </t:Column>
          <t:Column
						label="Numero"
						sortProperty="SalesInvoice/InvoiceNumber"
            hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Text text="{SalesInvoice/InvoiceNumber}" />
						</t:template>
					</t:Column>
          <t:Column
						label="Emissão"
						sortProperty="SalesInvoice/InvoiceDate"
            hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Text text="{
                path: 'SalesInvoice/InvoiceDate',
                targetType: 'any',
                formatter: '.formatter.formatDate'
              }" />
						</t:template>
					</t:Column>
          <t:Column
						label="Nota Fiscal"
						sortProperty="SalesInvoice/TaxDocumentNumber"
            hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Text text="{SalesInvoice/TaxDocumentNumber}" />
						</t:template>
					</t:Column>
          <t:Column
						label="Placa"
						sortProperty="SalesInvoice/TruckCode"
            hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Text text="{SalesInvoice/TruckCode}" />
						</t:template>
					</t:Column>
          <t:Column
						label="Transportadora"
						sortProperty="SalesInvoice/TruckingCompanyName"
            hAlign="Center"
            width="12rem"
            >
						<t:template>
							<Text text="{SalesInvoice/TruckingCompanyName}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column
						label="Nome Cliente"
						sortProperty="SalesInvoice/CardName"
            hAlign="Center"
            width="10rem"
            >
						<t:template>
							<Text text="{SalesInvoice/CardName}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column
						label="Contrato"
						sortProperty="SalesContract/Code"
            hAlign="Center"
            width="8rem"
            >
						<t:template>
							<Text text="{SalesContract/Code}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column
						label="Produto"
						sortProperty="ItemName"
            hAlign="Center"
            width="10rem"
						>
						<t:template>
							<Text text="{ItemName}" />
						</t:template>
					</t:Column>
          <t:Column
						label="Quantidade"
						hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Text text="{Quantity}" />
						</t:template>
					</t:Column>
          <t:Column
						label="Un.Med"
						hAlign="Center"
            width="5rem"
						>
						<t:template>
							<Text text="{UnitOfMeasureCode}" />
						</t:template>
					</t:Column>
          <t:Column
						label="Qtd.Entregue"
						hAlign="Center"
            width="7rem"
						>
						<t:template>
							<!-- Somente leitura: nesta tela a única ação é reabrir a entrega (Status). -->
							<!-- Sem type="Number": o <input type="number"> nativo apaga valor com separador pt-BR. -->
							<Input
                editable="false"
                value="{
                  path: 'DeliveredQuantity',
                  type: 'sap.ui.model.odata.type.Double',
                  formatOptions:{
                    minFractionDigits: 0,
                    maxFractionDigits: 3,
                    decimalSeparator: ',',
                    groupingEnabled: true,
                    groupingSeparator: '.'
                  }
                }"
                textAlign="End"/>
						</t:template>
					</t:Column>
          <t:Column
						label="Diferença"
						hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Text text="{
                parts: [
                  { path: 'DeliveredQuantity', targetType: 'any' },
                  { path: 'Quantity', targetType: 'any' },
                  { path: 'DeliveryStatus', targetType: 'any' }
                ],
                formatter: '.formatter.formatDeliveryDifference'
              }" />
						</t:template>
					</t:Column>
          <t:Column
						label="Desconto"
						hAlign="Center"
            width="7rem"
						>
						<t:template>
							<!-- Somente leitura: ver comentário na coluna Qtd.Entregue. -->
							<!-- Sem type="Number": o <input type="number"> nativo apaga valor com separador pt-BR. -->
							<Input
                editable="false"
                value="{
                  path: 'QuantityLoss',
                  type: 'sap.ui.model.odata.type.Double',
                  formatOptions:{
                    minFractionDigits: 0,
                    maxFractionDigits: 3,
                    decimalSeparator: ',',
                    groupingEnabled: true,
                    groupingSeparator: '.'
                  }
                }"
                textAlign="End"
              />
						</t:template>
					</t:Column>
          <t:Column
						label="Peso Líquido"
						hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Text text="{
                parts: [
                  { path: 'DeliveredQuantity', targetType: 'any' },
                  { path: 'QuantityLoss', targetType: 'any' }
                ],
                formatter: '.formatter.formatNetQuantity'
              }" />
						</t:template>
					</t:Column>
          <t:Column
						label="Status"
						hAlign="Center"
            width="7rem"
						>
						<t:template>
							<Select 
                forceSelection="false"
                selectedKey="{
                  path: 'DeliveryStatus',
                  targetType: 'any'
                }"
              >
                <core:ListItem key="Open" text="Aberto" />
                <core:ListItem key="Closed" text="Encerrado" />
              </Select>
						</t:template>
					</t:Column>

          <t:Column
						label="Últ. Atualização"
						sortProperty="UpdatedAt"
            hAlign="Center"
            width="10rem"
						>
						<t:template>
							<!-- Carimbo da CONFERÊNCIA, não de qualquer PATCH no item: em branco
							     enquanto a entrega nunca foi conferida. -->
							<Text wrapping="false" text="{
                path: 'UpdatedAt',
                targetType: 'any',
                formatter: '.formatter.formatDateTime'
              }" />
						</t:template>
					</t:Column>
          <t:Column
						label="Usuário"
						sortProperty="UpdatedBy"
            hAlign="Center"
            width="9rem"
						>
						<t:template>
							<Text text="{UpdatedBy}" wrapping="false"/>
						</t:template>
					</t:Column>
          <t:Column
						label="Log"
            hAlign="Center"
            width="4rem"
						>
						<t:template>
							<!-- Abre o log da PRÓPRIA linha: o handler usa o contexto do botão,
							     não a linha selecionada (clicar no ícone não seleciona a linha). -->
							<Button
                icon="sap-icon://history"
                type="Transparent"
                tooltip="Log de modificações"
                press=".onOpenItemChangeLogs"
              />
						</t:template>
					</t:Column>

				</t:columns>

			</t:Table>

    </f:content>
  
  </f:DynamicPage>

</mvc:View>
