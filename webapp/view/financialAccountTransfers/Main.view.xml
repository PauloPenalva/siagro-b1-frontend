<mvc:View
	controllerName="siagrob1.controller.financialAccountTransfers.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<f:DynamicPage busyIndicatorDelay="0" busy="{ui>/busy}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Transferências entre Contas"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<fb:FilterBar id="transfersFilterBar" search=".onSearch" showClearOnFB="false" useToolbar="false" showGoOnFB="true">
						<fb:filterGroupItems>
							<fb:FilterGroupItem name="from" label="De" groupName="main" visibleInFilterBar="true">
								<fb:control>
									<DatePicker value="{filter>/DateFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="to" label="Até" groupName="main" visibleInFilterBar="true">
								<fb:control>
									<DatePicker value="{filter>/DateTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy"/>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="account" label="Conta (origem ou destino)" groupName="main" visibleInFilterBar="true">
								<fb:control>
									<Input
										value="{filter>/AccountCode}"
										showValueHelp="true"
										valueHelpRequest=".openAccountValueHelp"/>
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<t:Table
				id="transfersTable"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				alternateRowColors="true"
				noData="Nenhuma transferência no período.">
				<t:extension>
					<OverflowToolbar>
						<Title text="Transferências"/>
						<ToolbarSpacer/>
						<Button type="Emphasized" icon="sap-icon://add" text="Transferir" press=".onTransfer"/>
						<Button type="Transparent" text="Excluir" press=".onDeleteTransfer"/>
						<Button type="Transparent" text="Atualizar" press=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="Data" width="7rem" hAlign="Center">
						<t:template>
							<Text text="{path: 'TransferDate', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: {precision: 7}, formatOptions: {pattern: 'dd/MM/yyyy'}}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Conta origem" width="10rem">
						<t:template><Text text="{FromAccountCode}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Conta destino" width="10rem">
						<t:template><Text text="{ToAccountCode}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Valor" width="10rem" hAlign="End">
						<t:template><Text text="{ path: 'Amount', formatter: 'formatter.formatDecimal2' }" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Descrição" width="20rem">
						<t:template><Text text="{Description}" wrapping="false"/></t:template>
					</t:Column>
					<t:Column label="Observação" width="20rem">
						<t:template><Text text="{Notes}" wrapping="false"/></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</f:content>
	</f:DynamicPage>

</mvc:View>
