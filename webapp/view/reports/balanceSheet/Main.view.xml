<mvc:View
	controllerName="siagrob1.controller.reports.balanceSheet.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<Page title="Balanço Patrimonial" busyIndicatorDelay="0" busy="{ui>/busy}">
		<form:Form editable="true">
			<form:layout>
				<form:ColumnLayout columnsM="1" columnsL="1" columnsXL="2"/>
			</form:layout>
			<form:formContainers>
				<form:FormContainer title="Filtros">
					<form:formElements>
						<form:FormElement label="Data-base">
							<form:fields><DatePicker value="{params>/DateTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" required="true" /></form:fields>
						</form:FormElement>
						<form:FormElement label="Comparar com">
							<form:fields><DatePicker value="{params>/CompareDate}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" placeholder="Sem comparativo" /></form:fields>
						</form:FormElement>
						<form:FormElement label="Filial">
							<form:fields>
								<Input value="{params>/BranchCode}" placeholder="Todas" showValueHelp="true" valueHelpOnly="true"
									showClearIcon="true" valueHelpRequest=".openBranchsValueHelp" />
							</form:fields>
						</form:FormElement>
					</form:formElements>
				</form:FormContainer>
				<form:FormContainer title="Apresentação">
					<form:formElements>
						<form:FormElement label="Visão gerencial">
							<form:fields>
								<Select selectedKey="{params>/ViewCode}" items="{views>/Items}" forceSelection="true">
									<core:Item key="{views>Code}" text="{views>Name}" />
								</Select>
							</form:fields>
						</form:FormElement>
					</form:formElements>
				</form:FormContainer>
			</form:formContainers>
		</form:Form>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer/>
				<Button text="Excel" icon="sap-icon://excel-attachment" press=".onExportExcel"/>
				<Button text="Imprimir" type="Emphasized" icon="sap-icon://print" press=".onPrintReport"/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
