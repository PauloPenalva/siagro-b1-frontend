<mvc:View
	controllerName="siagrob1.controller.armazem.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page
		showHeader="true"
		title="Armazéns"
		id="pageArmazens">
		<content>
			<t:Table
				id="tableArmazens"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				noData="Nenhum armazém. Marque 'Armazém' no cadastro do Parceiro de Negócio."
				rows="{
					path: '/Warehouses'
				}"
			>
				<t:extension>
					<OverflowToolbar >
						<ToolbarSpacer />
						<SearchField placeholder="Pesquisar..." width="30%" search=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column
						label="Código"
						sortProperty="Code"
						filterProperty="Code"
            width="5rem"
						>
						<t:template>
							<Text text="{Code}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column
						label="Nome"
						sortProperty="Name"
						filterProperty="Name"
						>
						<t:template>
							<Text text="{Name}" />
						</t:template>
					</t:Column>
          <t:Column
						label="CNPJ"
						sortProperty="TaxId"
						filterProperty="TaxId"
						>
						<t:template>
							<Text text="{
                parts: ['TaxId'],
                formatter: '.formatter.formatCnpj'
              }" />
						</t:template>
					</t:Column>
					<t:Column label="Cidade/UF" sortProperty="City" filterProperty="City">
						<t:template>
							<Text text="{= ${City} ? ${City} + '/' + ${State} : '' }" wrapping="false" />
						</t:template>
					</t:Column>
				</t:columns>

			</t:Table>
		</content>
    <footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Complemento" icon="sap-icon://add-product" press=".onComplement"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
