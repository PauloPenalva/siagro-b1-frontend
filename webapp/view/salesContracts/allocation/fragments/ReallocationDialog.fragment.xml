<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
<Dialog id="salesReallocationDlg" title="Realocar Entrega para Outro Contrato" contentHeight="520px" contentWidth="900px">
  <content>
    <VBox class="sapUiSmallMargin">
     <HBox>
       <Label text="Cliente:" class="sapUiTinyMarginEnd" />
       <Text text="{SalesContract/CardName} ({SalesContract/CardCode})" class="sapUiLargeMarginEnd"/>
       <Label text="Produto:" class="sapUiTinyMarginEnd" />
       <Text text="{SalesInvoiceItem/ItemName} ({SalesInvoiceItem/ItemCode})" class="sapUiLargeMarginEnd"/>
     </HBox>
     <HBox>
       <Label text="Contrato de Origem:" class="sapUiTinyMarginEnd" />
       <Text text="{SalesContract/Code}" class="sapUiLargeMarginEnd"/>
       <Label text="Nota Fiscal:" class="sapUiTinyMarginEnd" />
       <Text text="{SalesInvoiceItem/SalesInvoice/TaxDocumentNumber}" class="sapUiLargeMarginEnd"/>
       <Label text="Preço NF:" class="sapUiTinyMarginEnd" />
       <Text text="{
          path: 'InvoiceUnitPrice',
          type: 'sap.ui.model.type.Float',
          formatOptions: { decimals: 7, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
       }" class="sapUiLargeMarginEnd"/>
     </HBox>
     <HBox>
       <Label text="Volume desta linha:" class="sapUiTinyMarginEnd" />
       <ObjectNumber number="{
          path: 'Volume',
          type: 'sap.ui.model.type.Float',
          formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
       }" unit="{SalesInvoiceItem/UnitOfMeasureCode}" class="sapUiLargeMarginEnd"/>
     </HBox>
    </VBox>
    <t:Table
      id="salesReallocationTargetTable"
      busyIndicatorDelay="0"
      selectionMode="Single"
      selectionBehavior="Row"
      class="sapUiSizeCondensed"
      visibleRowCountMode="Fixed"
      enableBusyIndicator="true"
      alternateRowColors="false"
      rows="{viewModel>/}"
    >
      <t:extension>
        <OverflowToolbar >
          <Title text="Contratos de Destino Disponíveis" />
          <ToolbarSpacer />
        </OverflowToolbar>
      </t:extension>
      <t:columns>
        <t:Column label="Filial" width="5rem">
          <t:template>
            <Text text="{viewModel>BranchShortName}" wrapping="false"/>
          </t:template>
        </t:Column>
        <t:Column label="Contrato" width="9rem">
          <t:template>
            <Text text="{viewModel>SalesContractCode}" wrapping="false"/>
          </t:template>
        </t:Column>
        <t:Column label="Liberação" width="7rem">
          <t:template>
            <Text text="{viewModel>RowId}" wrapping="false"/>
          </t:template>
        </t:Column>
        <t:Column label="Local de Entrega" width="11rem">
          <t:template>
            <Text text="{viewModel>DeliveryLocationName}" wrapping="false"/>
          </t:template>
        </t:Column>
        <t:Column label="Preço Ctr." hAlign="End" width="9rem">
          <t:template>
          <Text
            wrapping="false"
            text="{
              path: 'viewModel>Price',
              type: 'sap.ui.model.type.Float',
              formatOptions:{ decimals: 7, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
            }"
          />
          </t:template>
        </t:Column>
        <t:Column label="Saldo Liberação" hAlign="End" width="10rem">
          <t:template>
          <Text
            wrapping="false"
            text="{
              path: 'viewModel>AvailableQuantity',
              type: 'sap.ui.model.type.Float',
              formatOptions:{ decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
            }"
          />
          </t:template>
        </t:Column>
        <t:Column label="Volume a Realocar" hAlign="End" width="11rem">
          <t:template>
            <Input
              value="{
                path: 'viewModel>ReallocationVolume',
                type: 'sap.ui.model.type.Float',
                formatOptions:{ decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
            />
          </t:template>
        </t:Column>
      </t:columns>
    </t:Table>
  </content>
  <footer>
    <OverflowToolbar >
      <ToolbarSpacer />
      <Button text="Confirmar" type="Emphasized" press=".onConfirmReallocation"/>
      <Button text="Fechar" press=".onCloseReallocation"/>
    </OverflowToolbar>
  </footer>
</Dialog>
</core:FragmentDefinition>
