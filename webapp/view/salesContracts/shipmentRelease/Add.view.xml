<mvc:View
	controllerName="siagrob1.controller.salesContracts.shipmentRelease.Add"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
  xmlns:uxap="sap.uxap"
  xmlns:form="sap.ui.layout.form"
  xmlns:l="sap.ui.layout"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

  <uxap:ObjectPageLayout
    showFooter="true"
    toggleHeaderOnTitleClick="true"
		preserveHeaderStateOnScroll="false"
    busy="{ui>/busy}"
    busyIndicatorDelay="0"
	>
   	<uxap:headerTitle>
			<uxap:ObjectPageDynamicHeaderTitle>
        <uxap:expandedHeading>
           <Title text="Solicitar Liberação de Entrega de Contrato de Venda"/>
          </uxap:expandedHeading>
          <uxap:snappedHeading>
           <Title text="Solicitar Liberação de Entrega de Contrato de Venda"/>
         </uxap:snappedHeading>
      </uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>
    <uxap:headerContent>
      <!--
        Dados do contrato selecionado. O contexto da view é a liberação transiente
        (só tem SalesContractKey), então esta subárvore é ligada ao contrato pelo
        controller em `newRouteMatched`.
      -->
      <HBox id="salesShipmentReleaseContractHeader" wrap="Wrap">
        <VBox class="sapUiSmallMarginEnd">
          <ObjectIdentifier title="{Code}" text="{Complement}"/>
          <ObjectAttribute title="Filial" text="{Branch/ShortName}"/>
          <ObjectAttribute title="Safra" text="{HarvestSeasonCode}"/>
        </VBox>
        <VBox class="sapUiSmallMarginEnd">
          <ObjectAttribute title="Cliente" text="({CardCode}) {CardName}"/>
          <ObjectAttribute title="Produto" text="({ItemCode}) {ItemName}"/>
        </VBox>
        <VBox class="sapUiSmallMarginEnd">
          <ObjectAttribute title="Limite de entrega" text="{
            path: 'DeliveryEndDate',
            targetType: 'any',
            formatter: '.formatter.formatDate'
          }"/>
          <ObjectAttribute title="Prev.Pagto." text="{
            path: 'StandardCashFlowDate',
            targetType: 'any',
            formatter: '.formatter.formatDate'
          }"/>
        </VBox>
        <VBox>
          <ObjectAttribute title="Saldo a liberar"/>
          <ObjectNumber
            emphasized="true"
            number="{
              path: 'PhysicalAvailableToRelease',
              type: 'sap.ui.model.type.Float',
              formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
            }"
            unit="{UnitOfMeasureCode}"/>
          <ObjectAttribute title="Quantidade do contrato"/>
          <ObjectNumber
            emphasized="false"
            number="{
              path: 'TotalVolume',
              type: 'sap.ui.model.type.Float',
              formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
            }"
            unit="{UnitOfMeasureCode}"/>
        </VBox>
      </HBox>
    </uxap:headerContent>
    <uxap:sections>
      <uxap:ObjectPageSection titleUppercase="false" title="Dados da Liberação">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
            <uxap:blocks>
              <form:SimpleForm
                id="formSalesContractRequestShipmentRelease"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="3"
                columnsL="2"
                columnsM="2"
                singleContainerFullSize="true"
                busyIndicatorDelay="0">
                <form:content>
                  <core:Title />
                  <Label text="Quantidade"/>
                  <Input
                    required="true"
                    editable="{ui>/editable}"
                    value="{
                      path: 'ReleasedQuantity',
                      type: 'sap.ui.model.odata.type.Double',
                      formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
                    }"
                  />
                  <Label text="Local de entrega" />
                  <Input
                    editable="{ui>/editable}"
                    required="true"
                    value="{DeliveryLocationCode}"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".openSalesContractDeliveryLocationsValueHelp">
                    <customData>
                      <core:CustomData key="descriptionProperty" value="DeliveryLocationName:CardName" />
                    </customData>
                    <layoutData>
                        <l:GridData span="XL3 L3 M3 S4" />
                    </layoutData>
                  </Input>
                  <Input value="{DeliveryLocationName}" editable="false" />
                  <core:Title />
                </form:content>
              </form:SimpleForm>
            </uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
    </uxap:sections>
    <uxap:footer>
      <OverflowToolbar>
				<ToolbarSpacer />
				<Button text="Fechar" press=".onCancel"  />
				<Button text="Confirmar" type="Emphasized" press=".onSave"/>
			</OverflowToolbar>
    </uxap:footer>
  </uxap:ObjectPageLayout>
</mvc:View>
