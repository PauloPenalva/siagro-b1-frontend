<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
>
<fb:FilterBar search=".onSearch" showClearOnFB="true" clear=".onClearFilters">
  <fb:filterGroupItems>
      <fb:FilterGroupItem name="code" label="Contrato" groupName="GroupCode" visibleInFilterBar="true">
        <fb:control>
            <Input showClearIcon="true" value="{filter>/Code}"/>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="cardName" label="Cliente" groupName="GroupCustomer" visibleInFilterBar="true">
        <fb:control>
            <Input showClearIcon="true" value="{filter>/CardName}"/>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="itemName" label="Produto" groupName="GroupItem" visibleInFilterBar="true">
        <fb:control>
            <Input showClearIcon="true" value="{filter>/ItemName}"/>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="deliveryEndDateFrom" label="Limite Entrega de" groupName="GroupDeliveryEndDateFrom" visibleInFilterBar="true">
        <fb:control>
           <DatePicker value="{ path: 'filter>/DeliveryEndDateFrom', type: 'sap.ui.model.type.String' }" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd"/>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="deliveryEndDateTo" label="Limite Entrega até" groupName="GroupDeliveryEndDateTo" visibleInFilterBar="true">
        <fb:control>
           <DatePicker value="{ path: 'filter>/DeliveryEndDateTo', type: 'sap.ui.model.type.String' }" displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd"/>
        </fb:control>
      </fb:FilterGroupItem>
      <fb:FilterGroupItem name="marketType" label="Tipo de Mercado" groupName="GroupMarketType" visibleInFilterBar="true">
        <fb:control>
            <Select
              forceSelection="false"
              selectedKey="{ path: 'filter>/MarketType', type: 'sap.ui.model.type.String' }"
            >
              <core:ListItem key="Internal" text="Interno"/>
              <core:ListItem key="External" text="Exportação"/>
            </Select>
        </fb:control>
      </fb:FilterGroupItem>
    </fb:filterGroupItems>
  </fb:FilterBar>
</core:FragmentDefinition>
