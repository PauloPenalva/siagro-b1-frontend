<mvc:View
	controllerName="siagrob1.controller.salesContracts.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.ui.layout.form"
  xmlns:uxap="sap.uxap"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

  <uxap:ObjectPageLayout
    showFooter="true"
    toggleHeaderOnTitleClick="true"
		preserveHeaderStateOnScroll="false"
    busy="{ui>/busy}"
    busyIndicatorDelay="0"
	>
   	<uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
         <uxap:expandedHeading>
           <Title text="Contrato de Venda"/>
          </uxap:expandedHeading>
          <uxap:snappedHeading>
           <Title text="Contrato de Venda"/>
         </uxap:snappedHeading>
        <uxap:actions>
          <Button visible="{= ${path: 'Status', targetType: 'any'}==='Draft' &amp;&amp; !${ui>/readonly} }" enabled="{= ${path: 'Status', targetType: 'any'}==='Draft' ? true : false }" text="Editar" type="Emphasized" press=".onEdit"/>
          <Button visible="{= ${path: 'Status', targetType: 'any'}==='InApproval' &amp;&amp; !${ui>/readonly} }" text="Retirar da Aprovação" type="Transparent" press=".onWithdrawApproval"/>
          <Button visible="{= ${path: 'Status', targetType: 'any'}==='Approved' &amp;&amp; !${ui>/readonly} }" text="Retirar da Aprovação" type="Transparent" press=".onWithdrawApproval"/>
          <Button visible="{= ${path: 'Status', targetType: 'any'}==='Draft' &amp;&amp; !${ui>/readonly} }" text="Enviar para Aprovação" type="Transparent" press=".onSendToApproval"/>
          <Button visible="{= ${path: 'Status', targetType: 'any'}==='Approved' &amp;&amp; !${ui>/readonly} }" text="Recalcular Saldo" type="Transparent" press=".onRecalculateBalance"/>
          <Button visible="{= ${path: 'Status', targetType: 'any'}==='Approved' &amp;&amp; !${ui>/readonly} }" text="Encerrar" type="Transparent" press=".onCloseContract"/>
          <Button visible="{= ${path: 'Status', targetType: 'any'}==='Finished' &amp;&amp; !${ui>/readonly} }" text="Reabrir" type="Transparent" press=".onReopenContract"/>
          <!-- Sem binding de Status: assinatura vale em qualquer status do contrato. -->
          <Button visible="{= !${ui>/readonly} }" text="Assinatura" type="Transparent" icon="sap-icon://signature" press=".onOpenSignatureStatusDialog"/>
        </uxap:actions>
      </uxap:ObjectPageDynamicHeaderTitle>
		</uxap:headerTitle>

    <uxap:headerContent>
      <HBox class="sapUiTinyMarginBottom">
        <ObjectIdentifier title="{Code}" class="sapUiMediumMarginEnd sapUiTinyMarginBottom"/>
        <ObjectStatus
          state="{
            path: 'Status',
            targetType: 'any',
            formatter: '.formatter.stateContractStatus'
          }"
          inverted="true" 
          text="{
            path: 'Status',
            formatter: '.formatter.formatContractStatus',
            targetType: 'any'
          }" />
        <!-- Contrato nunca marcado fica em branco: "não informado" é estado legítimo. -->
        <ObjectStatus
          class="sapUiMediumMarginBegin"
          state="{
            path: 'SignatureStatus',
            targetType: 'any',
            formatter: '.formatter.stateSignatureStatus'
          }"
          text="{
            path: 'SignatureStatus',
            targetType: 'any',
            formatter: '.formatter.formatSignatureStatus'
          }" />
      </HBox>
      <HBox>
        <VBox class="sapUiTinyMarginBottom sapUiMediumMarginEnd">
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Volume Negociado:" class="sapUiMediumMarginEnd" />
            <ObjectNumber number="{
              path: 'TotalVolume',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions:{
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" unit="{UnitOfMeasureCode}"  />
          </HBox>
        </VBox>
        <VBox class="sapUiTinyMarginBottom sapUiMediumMarginEnd">
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Total Fixado:" class="sapUiMediumMarginEnd" />
            <!--
              Ligado a viewModel>/TotalPrice (carregado de SalesContractsGetTotals, que faz
              Include das fixações) e não ao TotalPrice do contexto OData: o computed soma as
              fixações Confirmed e voltaria 0 sem a navegação carregada. JSON model usa
              sap.ui.model.type.Float, não Edm.Double.
            -->
            <ObjectNumber number="{
              path: 'viewModel>/TotalPrice',
              type: 'sap.ui.model.type.Float',
              formatOptions:{
                decimals: 2,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" unit="{
              path: 'StandardCurrency',
              targetType: 'any',
              formatter: '.formatter.formatCurrency'
            }"  />
          </HBox>
        </VBox>
        <VBox class="sapUiTinyMarginBottom sapUiMediumMarginEnd">
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Saldo" class="sapUiMediumMarginEnd" />
            <ObjectNumber
              number="{
                path: 'AvaiableVolume',
                type: 'sap.ui.model.odata.type.Double',
                formatOptions:{
                  decimals: 2,
                  decimalSeparator: ',',
                  groupingEnabled: true,
                  groupingSeparator: '.'
                }
              }"
              unit="{UnitOfMeasureCode}" />
          </HBox>
        </VBox>
        <VBox class="sapUiTinyMarginBottom sapUiMediumMarginEnd">
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Aguardando Liberação:" class="sapUiMediumMarginEnd" />
            <ObjectNumber number="{
              path: 'TotalAvailableToRelease',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions:{
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" unit="{UnitOfMeasureCode}"  />
          </HBox>
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Liberado para embarque:" class="sapUiMediumMarginEnd" />
            <ObjectNumber number="{
              path: 'TotalShipmentReleases',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions:{
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" unit="{UnitOfMeasureCode}"  />
          </HBox>
        </VBox>
        <VBox class="sapUiTinyMarginBottom sapUiMediumMarginEnd">
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Total Entregue:" class="sapUiMediumMarginEnd" />
            <ObjectNumber number="{
              path: 'invoicesModel>/totals/TotalDelivered',
              type: 'sap.ui.model.type.Float',
              formatOptions:{
                decimals: 2,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" unit="{
              path: 'StandardCurrency',
              targetType: 'any',
              formatter: '.formatter.formatCurrency'
            }" />
          </HBox>
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Total Invoices:" class="sapUiMediumMarginEnd" />
            <ObjectNumber number="{
              path: 'invoicesModel>/totals/TotalInvoices',
              type: 'sap.ui.model.type.Float',
              formatOptions:{
                decimals: 2,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" unit="{
              path: 'StandardCurrency',
              targetType: 'any',
              formatter: '.formatter.formatCurrency'
            }" />
          </HBox>
          <HBox class="sapUiTinyMarginBottom">
            <Text text="Diferença:" class="sapUiMediumMarginEnd" />
            <ObjectNumber
              number="{
                path: 'invoicesModel>/totals/TotalDifference',
                type: 'sap.ui.model.type.Float',
                formatOptions:{
                  decimals: 2,
                  decimalSeparator: ',',
                  groupingEnabled: true,
                  groupingSeparator: '.'
                }
              }"
              unit="{
                path: 'StandardCurrency',
                targetType: 'any',
                formatter: '.formatter.formatCurrency'
              }"
              state="{
                path: 'invoicesModel>/totals/TotalDifference',
                targetType: 'any',
                formatter: '.formatter.formatPriceDifferenceState'
              }" />
          </HBox>
        </VBox>
      </HBox>
   	</uxap:headerContent>
    
    <uxap:sections>
      <uxap:ObjectPageSection titleUppercase="false" title="Dados do Contrato">
				<uxap:subSections>
					<uxap:ObjectPageSubSection title=" " titleUppercase="false">
						<core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractForm" type="XML" />
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Locais de Entrega">
        <uxap:subSections>
          <uxap:ObjectPageSubSection>
            <uxap:blocks>
              <core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractDeliveryLocations" type="XML" />
            </uxap:blocks>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Fixações de Preço">
				<uxap:subSections>
					<uxap:ObjectPageSubSection titleUppercase="false">
						 <core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractPriceFixations" type="XML" />
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Liberações de Entrega">
				<uxap:subSections>
					<uxap:ObjectPageSubSection titleUppercase="false">
						 <core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractShipmentReleases" type="XML" />
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
       <uxap:ObjectPageSection titleUppercase="false" title="Entregas">
				<uxap:subSections>
					<uxap:ObjectPageSubSection titleUppercase="false">
						 <core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractAllocations" type="XML" />
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Anexos">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
            <uxap:blocks>
              <core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractAttachments" type="XML" />
            </uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Comentários">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
            <uxap:blocks>
              <core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractComments" type="XML" />
            </uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Log de Alterações">
				<uxap:subSections>
					<uxap:ObjectPageSubSection>
            <uxap:blocks>
              <core:Fragment fragmentName="siagrob1.view.salesContracts.fragments.SalesContractChangeLogs" type="XML" />
            </uxap:blocks>
					</uxap:ObjectPageSubSection>
				</uxap:subSections>
			</uxap:ObjectPageSection>
    </uxap:sections>
  </uxap:ObjectPageLayout>

</mvc:View>
