<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
  <t:Table
    id="salesContractDeliveryLocationsTable"
    class="sapUiSizeCondensed"
    alternateRowColors="true"
    enableBusyIndicator="true"
    enableSelectAll="false"
    selectionBehavior="Row"
    selectionMode="Single"
    busyIndicatorDelay="0"
    rows="{
      path: 'DeliveryLocations',
      parameters: { '$$ownRequest': true }
    }"
    visible="true"
    >
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Locais de Entrega do Contrato" />
          <ToolbarSpacer />
          <Button
            visible="{ui>/postApprovalEditable}"
            text="Incluir"
            type="Transparent"
            icon="sap-icon://add"
            press=".onAddDeliveryLocation"
          />
          <Button
            visible="{ui>/postApprovalEditable}"
            text="Remover"
            type="Transparent"
            icon="sap-icon://delete"
            press=".onRemoveDeliveryLocation"
          />
          <!--
            Só no Detail: Add/Edit gravam pelo Salvar da tela. O update group é diferido,
            então sem isto as linhas incluídas aqui ficariam pendentes para sempre.
          -->
          <Button
            visible="{ui>/postApprovalSaveVisible}"
            text="Salvar"
            type="Emphasized"
            icon="sap-icon://save"
            press=".onSaveDeliveryLocations"
          />
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <t:Column label="Codigo">
        <t:template>
          <Input
            editable="{ui>/postApprovalEditable}"
            required="true"
            value="{CardCode}"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openCostumersValueHelp">
            <customData>
              <core:CustomData key="descriptionProperty" value="CardName" />
            </customData>
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="Nome">
        <t:template>
          <Text text="{CardName}" />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
