<mvc:View
    controllerName="siagrob1.controller.shippingTransaction.SelectShipmentRelease"
    displayBlock="true"
    height="100%"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:uxap="sap.uxap"
    core:require="{
      formatter: 'siagrob1/model/formatter'
    }">
    <uxap:ObjectPageLayout
        showFooter="true"
        toggleHeaderOnTitleClick="true"
        preserveHeaderStateOnScroll="false"
        busy="{ui>/busy}"
        busyIndicatorDelay="0"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
              <uxap:breadcrumbs>
                <Breadcrumbs separatorStyle="GreaterThan" currentLocationText="Seleção de Liberação">
                  <Link text="Expedição de Grãos" press=".onCancel" />
                </Breadcrumbs>
              </uxap:breadcrumbs>
              <uxap:expandedHeading>
                  <Title text="Expedição de Grãos" />
              </uxap:expandedHeading>
              <uxap:snappedHeading>
                  <Title text="Expedição de Grãos" />
              </uxap:snappedHeading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:sections>
            <uxap:ObjectPageSection
                titleUppercase="false"
                title="Selecionar Liberação de Embarque"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection class="sapUxAPObjectPageSubSectionFitContainer">
                        <uxap:blocks>
                            <!-- GAC-1225: sap.ui.table.Table para o usuário redimensionar e reordenar as
                                 colunas (o Saldo ficava atrás da barra de rolagem). Largura e ordem são
                                 gravadas por usuário pelo TableLayoutService, sem código nesta tela. -->
                            <t:Table
                                id="tableSelectShipmentRelease"
                                class="sapUiSizeCondensed"
                                alternateRowColors="true"
                                selectionMode="Single"
                                selectionBehavior="Row"
                                enableSelectAll="false"
                                rows="{
                                  path: 'contracts>/'
                                }"
                            >
                                <t:rowMode>
                                    <rowmodes:Auto minRowCount="8" />
                                </t:rowMode>
                                <t:extension>
                                    <OverflowToolbar>
                                        <content>
                                            <Title
                                                text="Liberações"
                                                level="H2"
                                            />
                                            <ToolbarSpacer />
                                        </content>
                                    </OverflowToolbar>
                                </t:extension>
                                <t:columns>
                                <t:Column label="Obs." width="3rem">
                                    <t:template>
                                        <core:Icon tooltip="{contracts>Notes}" src="sap-icon://information" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Filial" width="7rem" sortProperty="BranchShortName" filterProperty="BranchShortName">
                                    <t:template>
                                        <Text text="{contracts>BranchShortName}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Contrato" width="7rem" sortProperty="PurchaseContractCode" filterProperty="PurchaseContractCode">
                                    <t:template>
                                        <ObjectIdentifier title="{contracts>PurchaseContractCode}" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Prev. Pagto." width="7rem" sortProperty="StandardCashFlowDate" filterProperty="StandardCashFlowDate">
                                    <t:template>
                                        <Text
                                            text="{ path: 'contracts>StandardCashFlowDate', formatter: 'formatter.formatDate' }"
                                            wrapping="false"
                                        />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Origem" width="7rem" sortProperty="Origin" filterProperty="Origin">
                                    <t:template>
                                        <!-- Origem: 0 Compra, 1 Transferência, 2 Devolução, 3 Transbordo (GAC-1181). Devolução em
                                             Warning de propósito: é mercadoria que VOLTOU, e reembarcá-la
                                             é uma decisão diferente de embarcar compra nova. -->
                                        <ObjectStatus
                                            text="{ path: 'contracts>Origin', formatter: 'formatter.releaseOriginText' }"
                                            state="{ path: 'contracts>Origin', formatter: 'formatter.releaseOriginState' }"
                                        />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Item" width="4rem" sortProperty="RowId" filterProperty="RowId">
                                    <t:template>
                                        <Text text="{contracts>RowId}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Fornecedor" minWidth="200" sortProperty="FName" filterProperty="FName">
                                    <t:template>
                                        <Text text="{contracts>FName}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="CNPJ" width="9.5rem" sortProperty="TaxId" filterProperty="TaxId">
                                    <t:template>
                                        <Text text="{contracts>TaxId}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Municipio" width="9rem" sortProperty="City" filterProperty="City">
                                    <t:template>
                                        <Text text="{contracts>City}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Uf" width="3.5rem" sortProperty="State" filterProperty="State">
                                    <t:template>
                                        <Text text="{contracts>State}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Armazem" width="6rem" sortProperty="DeliveryLocationCode" filterProperty="DeliveryLocationCode">
                                    <t:template>
                                        <Text text="{contracts>DeliveryLocationCode}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Produto" width="8rem" sortProperty="ItemName" filterProperty="ItemName">
                                    <t:template>
                                        <Text text="{contracts>ItemName}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Saldo" width="10rem" sortProperty="AvailableQuantity" filterProperty="AvailableQuantity" hAlign="End">
                                    <t:template>
                                        <ObjectNumber
                                            number="{
                                              path: 'contracts>AvailableQuantity',
                                              type: 'sap.ui.model.type.Float',
                                              formatOptions: {
                                                decimals: 3,
                                                decimalSeparator: ',',
                                                groupingEnabled: true,
                                                groupingSeparator: '.'
                                              }
                                            }"
                                            unit="{contracts>UnitOfMeasureCode}"
                                        />
                                    </t:template>
                                </t:Column>
                                </t:columns>
                            </t:Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
        <uxap:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Voltar"
                    press=".onCancel"
                />
               <Button
                    text="Incluir Expedicao"
                    icon="sap-icon://add"
                    press=".onCreateShippingTransaction"
                    type="Emphasized"
                />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
   
</mvc:View>
