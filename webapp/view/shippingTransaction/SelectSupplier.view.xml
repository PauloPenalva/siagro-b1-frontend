<mvc:View
    controllerName="siagrob1.controller.shippingTransaction.SelectSupplier"
    displayBlock="true"
    height="100%"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:uxap="sap.uxap"
    core:require="{
      formatter: 'siagrob1/model/formatter'
    }">
    <uxap:ObjectPageLayout
        showFooter="true"
        toggleHeaderOnTitleClick="true"
        preserveHeaderStateOnScroll="false"
        busy="{ui>/busy}"
        busyIndicatorDelay="0"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
              <uxap:breadcrumbs>
                <Breadcrumbs separatorStyle="GreaterThan" currentLocationText="Seleção de Fornecedor">
                  <Link text="Expedição de Grãos" press=".onCancel" />
                </Breadcrumbs>
              </uxap:breadcrumbs>
              <uxap:expandedHeading>
                  <Title text="Expedição de Grãos" />
              </uxap:expandedHeading>
              <uxap:snappedHeading>
                  <Title text="Expedição de Grãos" />
              </uxap:snappedHeading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:sections>
            <uxap:ObjectPageSection
                titleUppercase="false"
                title="Selecionar Fornecedor"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection class="sapUxAPObjectPageSubSectionFitContainer">
                        <uxap:blocks>
                           <!-- GAC-1224: uma linha por fornecedor + previsão de pagamento, somando as
                                liberações com saldo do armazém. A liberação em si é escolhida na tela
                                seguinte, já filtrada pelo grupo marcado aqui. -->
                            <!-- GAC-1225: sap.ui.table.Table para o usuário redimensionar e reordenar as
                                 colunas (o Saldo ficava atrás da barra de rolagem). Largura e ordem são
                                 gravadas por usuário pelo TableLayoutService, sem código nesta tela. -->
                            <t:Table
                                id="tableSelectShippingSupplier"
                                class="sapUiSizeCondensed"
                                alternateRowColors="true"
                                selectionMode="Single"
                                selectionBehavior="Row"
                                enableSelectAll="false"
                                noDataText="Nenhuma liberação com saldo neste armazém."
                                rows="{
                                  path: 'suppliers>/'
                                }"
                            >
                                <t:rowMode>
                                    <rowmodes:Auto minRowCount="8" />
                                </t:rowMode>
                                <t:extension>
                                    <OverflowToolbar>
                                        <content>
                                            <Title
                                                text="Fornecedores"
                                                level="H2"
                                            />
                                            <ToolbarSpacer />
                                        </content>
                                    </OverflowToolbar>
                                </t:extension>
                                <t:columns>
                                <t:Column label="Fornecedor" minWidth="200" sortProperty="FName" filterProperty="FName">
                                    <t:template>
                                        <ObjectIdentifier title="{suppliers>FName}" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="CNPJ" width="9.5rem" sortProperty="TaxId" filterProperty="TaxId">
                                    <t:template>
                                        <Text text="{suppliers>TaxId}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Municipio" width="10rem" sortProperty="City" filterProperty="City">
                                    <t:template>
                                        <Text text="{suppliers>City}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Uf" width="3.5rem" sortProperty="State" filterProperty="State">
                                    <t:template>
                                        <Text text="{suppliers>State}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Prev. Pagto." width="7rem" sortProperty="StandardCashFlowDate" filterProperty="StandardCashFlowDate">
                                    <t:template>
                                        <Text
                                            text="{ path: 'suppliers>StandardCashFlowDate', formatter: 'formatter.formatDate' }"
                                            wrapping="false"
                                        />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Liberações" width="7rem" sortProperty="ReleaseCount" filterProperty="ReleaseCount" hAlign="End">
                                    <t:template>
                                        <Text text="{suppliers>ReleaseCount}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Saldo" width="10rem" sortProperty="AvailableQuantity" filterProperty="AvailableQuantity" hAlign="End">
                                    <t:template>
                                        <ObjectNumber
                                            number="{
                                              path: 'suppliers>AvailableQuantity',
                                              type: 'sap.ui.model.type.Float',
                                              formatOptions: {
                                                decimals: 3,
                                                decimalSeparator: ',',
                                                groupingEnabled: true,
                                                groupingSeparator: '.'
                                              }
                                            }"
                                            unit="{suppliers>UnitOfMeasureCode}"
                                        />
                                    </t:template>
                                </t:Column>
                                </t:columns>
                            </t:Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
        <uxap:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Voltar"
                    press=".onCancel"
                />
                <Button
                    text="Selecionar"
                    press=".onSelectSupplier"
                    type="Emphasized"
                />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
