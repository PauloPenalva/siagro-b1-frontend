<mvc:View
    controllerName="siagrob1.controller.shippingTransaction.Main"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:f="sap.f"
    xmlns:mdc="sap.ui.mdc"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:vm="sap.ui.fl.variants"
    xmlns:svm="sap.ui.comp.smartvariants"
    xmlns:uxap="sap.uxap"
    core:require="{
    formatter: 'siagrob1/model/formatter'
  }"
>
    <uxap:ObjectPageLayout
        showFooter="true"
        toggleHeaderOnTitleClick="true"
        preserveHeaderStateOnScroll="false"
        busy="{ui>/busy}"
        busyIndicatorDelay="0"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
              <uxap:breadcrumbs>
                <Breadcrumbs separatorStyle="GreaterThan" currentLocationText="Expedição de Grãos"/>
              </uxap:breadcrumbs>
              <uxap:expandedHeading>
                  <Title text="Expedição de Grãos" />
              </uxap:expandedHeading>
              <uxap:snappedHeading>
                  <Title text="Expedição de Grãos" />
              </uxap:snappedHeading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:headerContent>
            <fb:FilterBar
                search="onSearch"
                showRestoreButton="false"
                filterBarExpanded="true"
            >
                <fb:filterGroupItems>
                    <fb:FilterGroupItem
                        name="items"
                        label="Produto"
                        groupName="GroupItem"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <Input
                                showClearIcon="true"
                                showValueHelp="true"
                                valueHelpRequest=".openItemValueHelp"
                                value="{filter>/ItemCode}"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </uxap:headerContent>
        <uxap:sections>
            <uxap:ObjectPageSection
                titleUppercase="false"
                title="Seleção de Armazém"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection class="sapUxAPObjectPageSubSectionFitContainer">
                        <uxap:blocks>
                            <!-- GAC-1225: sap.ui.table.Table para o usuário redimensionar e reordenar as
                                 colunas (o Saldo ficava atrás da barra de rolagem). Largura e ordem são
                                 gravadas por usuário pelo TableLayoutService, sem código nesta tela. -->
                            <t:Table
                                id="tableShipmentReleasesBalance"
                                class="sapUiSizeCondensed"
                                alternateRowColors="true"
                                selectionMode="Single"
                                selectionBehavior="Row"
                                enableSelectAll="false"
                                rows="{
                                  path: 'balance>/'
                                }"
                            >
                                <t:rowMode>
                                    <rowmodes:Auto minRowCount="8" />
                                </t:rowMode>
                                <t:extension>
                                    <OverflowToolbar>
                                        <content>
                                            <Title
                                                text="Seleção de Armazém para Expedição"
                                                level="H2"
                                            />
                                            <ToolbarSpacer />
                                            <SearchField
                                                placeholder="Pesquisar..."
                                                width="30%"
                                                search=".onFilter"
                                            />
                                        </content>
                                    </OverflowToolbar>
                                </t:extension>
                                <t:columns>
                                <t:Column label="Obs." width="3rem">
                                    <t:template>
                                        <core:Icon tooltip="{balance>Notes}" src="sap-icon://information" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Armazem" minWidth="160" sortProperty="DeliveryLocationName" filterProperty="DeliveryLocationName">
                                    <t:template>
                                        <ObjectIdentifier title="{balance>DeliveryLocationName}" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Nome Fantasia" minWidth="160" sortProperty="FName" filterProperty="FName">
                                    <t:template>
                                        <Text text="{balance>FName}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Codigo" width="6rem" sortProperty="DeliveryLocationCode" filterProperty="DeliveryLocationCode">
                                    <t:template>
                                        <Text text="{balance>DeliveryLocationCode}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="CNPJ" width="9.5rem" sortProperty="TaxId" filterProperty="TaxId">
                                    <t:template>
                                        <Text text="{balance>TaxId}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Municipio" width="9rem" sortProperty="City" filterProperty="City">
                                    <t:template>
                                        <Text text="{balance>City}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Estado" width="4rem" sortProperty="State" filterProperty="State">
                                    <t:template>
                                        <Text text="{balance>State}" wrapping="false" />
                                    </t:template>
                                </t:Column>
                                <t:Column label="Saldo" width="10rem" sortProperty="AvailableQuantity" filterProperty="AvailableQuantity" hAlign="End">
                                    <t:template>
                                        <ObjectNumber
                                            number="{
                                              path: 'balance>AvailableQuantity',
                                              type: 'sap.ui.model.type.Float',
                                              formatOptions: {
                                                decimals: 3,
                                                decimalSeparator: ',',
                                                groupingEnabled: true,
                                                groupingSeparator: '.'
                                              }
                                            }"
                                            unit="{balance>UnitOfMeasureCode}"
                                        />
                                    </t:template>
                                </t:Column>
                                </t:columns>
                            </t:Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
        <uxap:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Selecionar Contrato"
                    icon="sap-icon://add"
                    press=".selectShipmentRelease"
                    type="Emphasized"
                />
            </OverflowToolbar>
        </uxap:footer>
    </uxap:ObjectPageLayout>
</mvc:View>
