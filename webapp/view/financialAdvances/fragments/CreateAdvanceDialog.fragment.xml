<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
<Dialog id="createAdvanceDialog" title="Novo adiantamento">
  <content>
    <VBox class="sapUiSmallMargin" width="520px">
      <MessageStrip type="Information" showIcon="true" class="sapUiSmallMarginBottom"
        text="O adiantamento é incluído já pago: a baixa é gravada na conta e na data do pagamento, e o valor fica disponível para compensar títulos do contrato ou, sem contrato, do mesmo parceiro, direção e moeda."/>
      <f:Form editable="true">
        <f:layout>
          <f:ColumnLayout columnsM="1" columnsL="1" columnsXL="1"/>
        </f:layout>
        <f:formContainers>
          <f:FormContainer>
            <f:formElements>
              <f:FormElement label="Vínculo">
                <f:fields>
                  <Select selectedKey="{viewModel>/advanceDialog/link}" change=".onAdvanceLinkChange">
                    <core:ListItem key="With" text="Com contrato"/>
                    <core:ListItem key="Without" text="Sem contrato"/>
                  </Select>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Direção" visible="{= ${viewModel>/advanceDialog/link} === 'Without' }">
                <f:fields>
                  <Select selectedKey="{viewModel>/advanceDialog/direction}">
                    <core:ListItem key="Payable" text="A pagar"/>
                    <core:ListItem key="Receivable" text="A receber"/>
                  </Select>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Parceiro" visible="{= ${viewModel>/advanceDialog/link} === 'Without' }">
                <f:fields>
                  <Input
                    value="{viewModel>/advanceDialog/cardCode}"
                    required="true"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".openAdvancePartnerValueHelp"/>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Filial" visible="{= ${viewModel>/advanceDialog/link} === 'Without' }">
                <f:fields>
                  <Input
                    value="{viewModel>/advanceDialog/branchCode}"
                    required="true"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".openBranchsValueHelp"/>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Tipo de contrato" visible="{= ${viewModel>/advanceDialog/link} === 'With' }">
                <f:fields>
                  <Select selectedKey="{viewModel>/advanceDialog/contractType}" change=".onAdvanceContractTypeChange">
                    <core:ListItem key="Purchase" text="Compra (a pagar)"/>
                    <core:ListItem key="Sales" text="Venda (a receber)"/>
                  </Select>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Contrato" visible="{= ${viewModel>/advanceDialog/link} === 'With' }">
                <f:fields>
                  <Input
                    value="{viewModel>/advanceDialog/contractCode}"
                    required="true"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".openAdvanceContractValueHelp"/>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Valor">
                <f:fields>
                  <Input
                    value="{path: 'viewModel>/advanceDialog/amount', type: 'sap.ui.model.odata.type.Double'}"
                    required="true"/>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Vencimento">
                <f:fields>
                  <DatePicker
                    value="{viewModel>/advanceDialog/dueDate}"
                    required="true"
                    displayFormat="dd/MM/yyyy"
                    valueFormat="yyyy-MM-dd"/>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Conta do pagamento">
                <f:fields>
                  <Input
                    value="{viewModel>/advanceDialog/financialAccountCode}"
                    required="true"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    valueHelpRequest=".openAdvanceAccountValueHelp"/>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Data do pagamento">
                <f:fields>
                  <DatePicker
                    value="{viewModel>/advanceDialog/paymentDate}"
                    required="true"
                    displayFormat="dd/MM/yyyy"
                    valueFormat="yyyy-MM-dd"/>
                </f:fields>
              </f:FormElement>
              <f:FormElement label="Observação">
                <f:fields>
                  <TextArea value="{viewModel>/advanceDialog/comments}" rows="3" width="100%" maxLength="500"/>
                </f:fields>
              </f:FormElement>
              <!-- Dimensões: o diálogo tem modelo padrão próprio e ui próprio, ver onCreateAdvance. -->
              <core:Fragment fragmentName="siagrob1.view.common.fragments.DimensionFields" type="XML"/>
            </f:formElements>
          </f:FormContainer>
        </f:formContainers>
      </f:Form>
    </VBox>
  </content>
  <footer>
    <OverflowToolbar>
      <ToolbarSpacer />
      <Button text="Incluir" type="Emphasized" press=".onConfirmCreateAdvance"/>
      <Button text="Fechar" press=".onCloseAdvanceDialog"/>
    </OverflowToolbar>
  </footer>
</Dialog>
</core:FragmentDefinition>
