<mvc:View
	controllerName="siagrob1.controller.fiscalKardex.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Kardex Fiscal" busyIndicatorDelay="0" busy="{ui>/busy}" enableScrolling="false">
		<subHeader>
			<OverflowToolbar>
				<Label text="Filial" required="true" labelFor="branchInput"/>
				<Input id="branchInput" width="8rem" showValueHelp="true" valueHelpOnly="true" valueHelpRequest=".openBranchsValueHelp" value="{params>/BranchCode}">
					<customData>
						<core:CustomData key="descriptionProperty" value="BranchName:ShortName"/>
					</customData>
				</Input>
				<Input width="14rem" value="{params>/BranchName}" editable="false"/>
				<Label text="Produto" labelFor="itemInput"/>
				<Input id="itemInput" width="10rem" showValueHelp="true" valueHelpOnly="true" showClearIcon="true" valueHelpRequest=".openItemValueHelp" value="{params>/ItemCode}"/>
				<Label text="De" required="true" labelFor="fromDate"/>
				<DatePicker id="fromDate" width="9rem" value="{params>/FromDate}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" required="true"/>
				<Label text="Até" required="true" labelFor="toDate"/>
				<DatePicker id="toDate" width="9rem" value="{params>/ToDate}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" required="true"/>
				<Button type="Emphasized" icon="sap-icon://search" text="Consultar" press=".onSearch"/>
			</OverflowToolbar>
		</subHeader>
		<content>
			<t:Table id="kardexTable" rows="{kardex>/rows}" selectionMode="None" class="sapUiSizeCondensed" visibleRowCountMode="Auto" alternateRowColors="false" noData="{= ${kardex>/searched} ? 'Nenhum registro no período.' : 'Informe a filial e o período e consulte.' }">
				<t:rowSettingsTemplate>
					<t:RowSettings highlight="{= ${kardex>rowType} !== 'line' ? 'Information' : (${kardex>warning} ? 'Warning' : 'None') }"/>
				</t:rowSettingsTemplate>
				<t:extension>
					<OverflowToolbar>
						<Title text="{= ${kardex>/rows}.length } linha(s)"/>
						<ToolbarSpacer/>
						<Button type="Transparent" icon="sap-icon://excel-attachment" text="Exportar Excel" press=".onExport"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="Produto" width="8rem"><t:template><Text text="{kardex>itemCode}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Descrição" width="16rem"><t:template><Text text="{kardex>itemName}" wrapping="false"/></t:template></t:Column>
					<t:Column label="UM" width="4rem"><t:template><Text text="{kardex>unitOfMeasureCode}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Data" width="7rem" hAlign="Center"><t:template><Text text="{ path: 'kardex>date', formatter: 'formatter.formatDate' }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Dir." width="3.5rem"><t:template><Text text="{kardex>direction}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Tipo" width="12rem"><t:template><Text text="{kardex>kind}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Nº interno" width="7rem"><t:template><Text text="{kardex>internalNumber}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Documento" width="8rem"><t:template><Text text="{kardex>documentNumber}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Parceiro" width="16rem"><t:template><Text text="{kardex>partner}" wrapping="false"/></t:template></t:Column>
					<t:Column label="CFOP" width="5rem"><t:template><Text text="{kardex>cfop}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Natureza de operação" width="16rem"><t:template><Text text="{kardex>usageName}" wrapping="false"/></t:template></t:Column>
					<t:Column label="Qtd. entrada" width="8rem" hAlign="End"><t:template><Text text="{ path: 'kardex>quantityIn', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 3, maxFractionDigits: 3 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Qtd. saída" width="8rem" hAlign="End"><t:template><Text text="{ path: 'kardex>quantityOut', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 3, maxFractionDigits: 3 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Custo unitário" width="9rem" hAlign="End"><t:template><Text text="{ path: 'kardex>unitCost', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 6, maxFractionDigits: 6 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Valor entrada" width="9rem" hAlign="End"><t:template><Text text="{ path: 'kardex>valueIn', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Valor saída" width="9rem" hAlign="End"><t:template><Text text="{ path: 'kardex>valueOut', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Saldo qtd." width="9rem" hAlign="End"><t:template><Text text="{ path: 'kardex>balanceQuantity', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 3, maxFractionDigits: 3 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Saldo valor" width="10rem" hAlign="End"><t:template><Text text="{ path: 'kardex>balanceValue', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Valor da nota" width="9rem" hAlign="End"><t:template><Text text="{ path: 'kardex>invoiceValue', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" wrapping="false"/></t:template></t:Column>
					<t:Column label="Alerta" width="24rem"><t:template><Text text="{kardex>warning}" wrapping="false"/></t:template></t:Column>
				</t:columns>
			</t:Table>
		</content>
	</Page>

</mvc:View>
