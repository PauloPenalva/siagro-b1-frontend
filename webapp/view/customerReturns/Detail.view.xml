<mvc:View
	controllerName="siagrob1.controller.customerReturns.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:uxap="sap.uxap"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

  <uxap:ObjectPageLayout
    showFooter="true"
    toggleHeaderOnTitleClick="true"
    preserveHeaderStateOnScroll="false"
    busy="{ui>/busy}"
    busyIndicatorDelay="0"
  >
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:expandedHeading>
          <Title text="Devolução de Cliente"/>
        </uxap:expandedHeading>
        <uxap:snappedHeading>
          <Title text="Devolução de Cliente"/>
        </uxap:snappedHeading>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <uxap:headerContent>
      <HBox class="sapUiTinyMarginBottom">
        <ObjectIdentifier title="{DocumentNumber}" text="{CardName}" class="sapUiMediumMarginEnd"/>
        <ObjectStatus
          state="{
            path: 'Status',
            targetType: 'any',
            formatter: 'formatter.stateCustomerReturnStatus'
          }"
          inverted="true"
          text="{
            path: 'Status',
            targetType: 'any',
            formatter: 'formatter.formatCustomerReturnStatus'
          }" />
      </HBox>
    </uxap:headerContent>

    <uxap:sections>
      <uxap:ObjectPageSection titleUppercase="false" title="Dados da Devolução">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.customerReturns.fragments.Form" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Itens Devolvidos">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.customerReturns.fragments.Items" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>
    <uxap:footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button text="Voltar" press=".onNavBack" />
      </OverflowToolbar>
    </uxap:footer>
  </uxap:ObjectPageLayout>

</mvc:View>
