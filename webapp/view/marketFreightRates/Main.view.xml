<mvc:View
	controllerName="siagrob1.controller.marketFreightRates.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:rowmodes="sap.ui.table.rowmodes"
	xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar">

	<f:DynamicPage busyIndicatorDelay="0" busy="{ui>/busy}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>marketFreightRatesTitle}" />
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<fb:FilterBar id="freightRatesFb" search=".onSearch" showClearOnFB="true" clear=".onClearFilters">
						<fb:filterGroupItems>
							<fb:FilterGroupItem name="municipality" label="{i18n>marketFilterMunicipality}" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<Input value="{filter>/MunicipalityName}" showClearIcon="true" />
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="destination" label="{i18n>marketColDestination}" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<Select forceSelection="false" selectedKey="{filter>/DestinationId}" items="{ path: 'lookup>/destinations', templateShareable: false }">
										<core:Item key="{lookup>Id}" text="{lookup>Name}" />
									</Select>
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="validFrom" label="{i18n>marketFilterValidFrom}" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<DatePicker core:require="{ StringType: 'sap/ui/model/type/String' }" value="{ path: 'filter>/ValidFrom', type: 'StringType' }"
										displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd" />
								</fb:control>
							</fb:FilterGroupItem>
							<fb:FilterGroupItem name="validTo" label="{i18n>marketFilterValidTo}" groupName="G" visibleInFilterBar="true">
								<fb:control>
									<DatePicker core:require="{ StringType: 'sap/ui/model/type/String' }" value="{ path: 'filter>/ValidTo', type: 'StringType' }"
										displayFormat="dd/MM/yyyy" valueFormat="yyyy-MM-dd" />
								</fb:control>
							</fb:FilterGroupItem>
						</fb:filterGroupItems>
					</fb:FilterBar>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox fitContainer="true" renderType="Bare">
				<MessageStrip text="{i18n>marketFreightRateHint}" type="Information" showIcon="true" class="sapUiTinyMarginBottom" />
				<t:Table
					id="tableMarketFreightRates"
					core:require="{ Double: 'sap/ui/model/odata/type/Double', EdmDate: 'sap/ui/model/odata/type/Date', market: 'siagrob1/helpers/MarketPricingHelpers' }"
					busyIndicatorDelay="0"
					selectionMode="Single"
					selectionBehavior="Row"
					class="sapUiSizeCondensed"
					enableBusyIndicator="true"
					alternateRowColors="true"
					rows="{
						path: '/MarketFreightRates',
						parameters: { $expand: 'Destination,Municipality' },
						sorter: [{ path: 'Municipality/Name' }, { path: 'ValidFrom', descending: true }]
					}">
					<t:layoutData><FlexItemData growFactor="1" baseSize="0" /></t:layoutData>
					<t:rowMode>
						<rowmodes:Auto />
					</t:rowMode>
					<t:columns>
						<t:Column label="{i18n>marketColMunicipality}" sortProperty="Municipality/Name">
							<t:template>
								<Text text="{ parts: ['Municipality/Name', 'Municipality/StateAbbreviation'], formatter: 'market.municipalityLabel' }" wrapping="false" />
							</t:template>
						</t:Column>
						<t:Column label="{i18n>marketColDestination}" sortProperty="Destination/Name" width="14rem">
							<t:template><Text text="{Destination/Name}" wrapping="false" /></t:template>
						</t:Column>
						<t:Column label="{i18n>marketColRatePerTon}" hAlign="End" sortProperty="RatePerTon" width="8rem">
							<t:template>
								<Text text="{ path: 'RatePerTon', type: 'Double', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }" wrapping="false" />
							</t:template>
						</t:Column>
						<t:Column label="{i18n>marketColValidFrom}" sortProperty="ValidFrom" width="10rem">
							<t:template>
								<Text text="{ path: 'ValidFrom', type: 'EdmDate', formatOptions: { pattern: 'dd/MM/yyyy' } }" wrapping="false" />
							</t:template>
						</t:Column>
						<t:Column label="{i18n>marketColCreatedBy}" sortProperty="CreatedBy" width="12rem">
							<t:template><Text text="{CreatedBy}" wrapping="false" /></t:template>
						</t:Column>
					</t:columns>
				</t:Table>
			</VBox>
		</f:content>
		<f:footer>
			<OverflowToolbar>
				<Button text="{i18n>commonRefresh}" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="{i18n>commonAdd}" icon="sap-icon://add" type="Emphasized" press=".onCreate" visible="{view>/canManage}" />
				<Button text="{i18n>commonEdit}" icon="sap-icon://edit" press=".onEdit" visible="{view>/canManage}" />
				<Button text="{i18n>commonDelete}" icon="sap-icon://delete" press=".onDelete" visible="{view>/canManage}" />
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>
