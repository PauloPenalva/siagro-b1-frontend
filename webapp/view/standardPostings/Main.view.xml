<mvc:View
	controllerName="siagrob1.controller.standardPostings.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:t="sap.ui.table">

	<Page title="Lançamento Padrão" showNavButton="true" navButtonPress=".onNavBack" busyIndicatorDelay="0">
		<content>
			<MessageStrip
				text="Cada código roda num evento do sistema. Sem configuração ou inativo, o evento não contabiliza. Configurado com erro (conta inexistente, sintética, bloqueada), a operação é recusada."
				type="Information" showIcon="true" class="sapUiSmallMargin" />
			<t:Table
				id="standardPostingsTable"
				selectionMode="None"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				alternateRowColors="true"
				rows="{lp>/Rows}">
				<t:columns>
					<t:Column label="Código" width="6rem">
						<t:template><Link text="{lp>Code}" press=".onOpen" /></t:template>
					</t:Column>
					<t:Column label="Descrição">
						<t:template><Text text="{lp>Description}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Evento" width="14rem">
						<t:template><Text text="{lp>ContextText}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Estorna" width="6rem">
						<t:template><Text text="{lp>Reverses}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Sequências" width="7rem" hAlign="End">
						<t:template><Text text="{lp>LineCount}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Situação" width="9rem">
						<t:template>
							<ObjectStatus text="{lp>StatusText}"
								state="{= ${lp>StatusText} === 'Ativo' ? 'Success' : ${lp>StatusText} === 'Inativo' ? 'Warning' : 'None' }" />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
