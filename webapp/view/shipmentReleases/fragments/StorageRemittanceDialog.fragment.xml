<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
	<Dialog title="Emitir remessa para depósito" contentWidth="32rem">
		<f:Form editable="true">
			<f:layout>
				<f:ColumnLayout columnsM="1" columnsL="1" columnsXL="1"/>
			</f:layout>
			<f:formContainers>
				<f:FormContainer>
					<f:formElements>
						<f:FormElement label="Armazém">
							<f:fields>
								<HBox>
									<Text text="{DeliveryLocationCode}" class="sapUiTinyMarginEnd"/>
									<Text text="{DeliveryLocationName}"/>
								</HBox>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Natureza">
							<f:fields>
								<Input
									value="{remittance>/dialog/usageName}"
									required="true"
									showValueHelp="true"
									valueHelpOnly="true"
									valueHelpRequest=".onRemittanceUsageValueHelp"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Quantidade">
							<f:fields>
								<Text text="{
									path: 'ReleasedQuantity',
									type: 'sap.ui.model.type.Float',
									formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
								}"/>
							</f:fields>
						</f:FormElement>
						<f:FormElement label="Preço unitário">
							<f:fields>
								<Input
									value="{
										path: 'remittance>/dialog/unitPrice',
										type: 'sap.ui.model.type.Float',
										formatOptions: { decimalSeparator: ',', groupingSeparator: '.', groupingEnabled: true, maxFractionDigits: 6 }
									}"
									required="true"
									parseError=".onRemittancePriceValidationError"
									validationError=".onRemittancePriceValidationError"
									validationSuccess=".onRemittancePriceValidationSuccess"/>
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
		<beginButton>
			<Button text="Emitir" type="Emphasized" press=".onConfirmRemittance"/>
		</beginButton>
		<endButton>
			<Button text="Cancelar" press=".onCancelRemittance"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
