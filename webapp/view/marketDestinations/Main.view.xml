<mvc:View
	controllerName="siagrob1.controller.marketDestinations.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:t="sap.ui.table"
	xmlns:rowmodes="sap.ui.table.rowmodes">

	<Page title="{i18n>marketDestinationsTitle}" busy="{ui>/busy}" busyIndicatorDelay="0">
		<content>
			<t:Table
				id="tableMarketDestinations"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{ path: '/MarketDestinations', sorter: [{ path: 'Name' }] }">
				<t:rowMode>
					<rowmodes:Auto />
				</t:rowMode>
				<t:columns>
					<t:Column label="{i18n>marketColDestination}" sortProperty="Name">
						<t:template><Text text="{Name}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="{i18n>marketFieldActive}" width="6rem" hAlign="Center">
						<t:template><CheckBox selected="{Active}" editable="false" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="{i18n>commonRefresh}" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="{i18n>commonAdd}" icon="sap-icon://add" type="Emphasized" press=".onCreate" visible="{view>/canManage}" />
				<Button text="{i18n>commonEdit}" icon="sap-icon://edit" press=".onEdit" visible="{view>/canManage}" />
				<Button text="{i18n>commonDelete}" icon="sap-icon://delete" press=".onDelete" visible="{view>/canManage}" />
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
