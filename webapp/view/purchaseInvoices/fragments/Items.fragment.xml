<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    core:require="{
      formatter: 'siagrob1/model/formatter', DoubleType: 'sap/ui/model/odata/type/Double', charges: 'siagrob1/helpers/InvoiceChargeTotalsHelpers'
    }"
>
  <t:Table
    id="tablePurchaseInvoiceItems"
    class="sapUiSizeCondensed"
    alternateRowColors="true"
    enableBusyIndicator="true"
    enableSelectAll="false"
    selectionBehavior="Row"
    selectionMode="Single"
    busyIndicatorDelay="0"
    visibleRowCountMode="Auto"
    rows="{Items}"
    >
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Itens" />
          <Button text="Tributos do item" icon="sap-icon://simulate" press=".onOpenItemFiscal" visible="{= ${ui>/taxMode} === true }" />
          <ToolbarSpacer />
          <ObjectNumber
            number="{ui>/documentTotal}"
            unit="Total geral"
            emphasized="true"
            state="None" />
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <!-- `showValueHelp` liga em `{ui>/editable}`, e não em "true": este fragmento é o MESMO do
           Detail, onde a grade é read-only e o botão do diálogo não pode aparecer. -->
      <!-- `.openLineItemValueHelp`, não o genérico `.openItemValueHelp`: aqui a troca de produto
           também precisa desamarrar o contrato da linha (coluna "Contrato" abaixo). -->
      <t:Column label="Produto" width="10rem">
        <t:template>
          <Input
            value="{ItemCode}"
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            valueHelpOnly="true"
            valueHelpRequest=".openLineItemValueHelp">
            <customData>
              <core:CustomData key="descriptionProperty" value="ItemName" />
            </customData>
          </Input>
        </t:template>
      </t:Column>
      <!-- Consequência do produto escolhido, nunca digitada: quem preenche é o gatilho do value
           help. O que veio do XML continua exibido intacto até o operador trocar o produto. -->
      <t:Column label="Descrição">
        <t:template>
          <Input value="{ItemName}" editable="false" />
        </t:template>
      </t:Column>
      <!-- Natureza da linha (própria e terceiro Normal na filial que calcula tributos): só naturezas de Entrada. Na devolução de compra vem da natureza de
           devolução da linha comprada e não muda. -->
      <t:Column label="Natureza" width="14rem" visible="{= ${ui>/taxMode} === true }">
        <t:template>
          <!-- ui5lint-disable no-deprecated-api -->
          <Input
            value="{UsageName}"
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            valueHelpOnly="true"
            valueHelpRequest=".openPurchaseUsageValueHelp" />
          <!-- ui5lint-enable no-deprecated-api -->
        </t:template>
      </t:Column>
      <t:Column label="CFOP" width="6rem" visible="{= ${ui>/taxMode} === true }">
        <t:template>
          <Text text="{Cfop}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="UM" width="6rem">
        <t:template>
          <Input
            value="{UnitOfMeasureCode}"
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            valueHelpOnly="true"
            valueHelpRequest=".openUnitsOfMeasureValueHelp" />
        </t:template>
      </t:Column>
      <!-- Campo de ESCRITA de decimal usa `Double`, e não `Decimal`, seguindo o documento de
           saída. Não é preciosismo: `Decimal` faz parse para STRING, e o leitor OData deste
           backend recusa Edm.Decimal em string — o POST volta 400 "The entity field is required",
           sem dizer qual campo. `Double` faz parse para número e passa.
           Só vale para binding que GRAVA; os de exibição abaixo podem continuar com `Decimal`. -->
      <t:Column label="Quantidade" width="10rem" hAlign="End">
        <t:template>
          <Input
            editable="{ui>/editable}"
            change=".onItemAmountChange"
            value="{
              path: 'Quantity',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions: {
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" />
        </t:template>
      </t:Column>
      <t:Column label="Preço Unitário" width="11rem" hAlign="End">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true }"
            change=".onItemAmountChange"
            value="{
              path: 'UnitPrice',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions: {
                decimals: 8,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" />
        </t:template>
      </t:Column>
      <!-- Frete, seguro, desconto e outras despesas da linha (spec 2026-10-05 §10). Campo de ESCRITA de decimal usa
           `Double`, nunca `Decimal` (o backend recusa Edm.Decimal em string). Editáveis também na devolução Pendente
           (vêm da venda na proporção do que volta). -->
      <t:Column label="Frete" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'FreightValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Seguro" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'InsuranceValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Desconto" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'DiscountValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Outras despesas" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{ui>/editable}"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'OtherExpensesValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Total" width="10rem" hAlign="End">
        <t:template>
          <!-- Total geral da linha (itens + frete + seguro + outras despesas − desconto), calculado no cliente: GrandTotal é [NotMapped]. targetType 'any' em cada parte: sem ele o binding composto entrega texto e a soma vira NaN. -->
          <Text
              text="{
                parts: [
                  { path: 'Quantity', targetType: 'any' },
                  { path: 'UnitPrice', targetType: 'any' },
                  { path: 'FreightValue', targetType: 'any' },
                  { path: 'InsuranceValue', targetType: 'any' },
                  { path: 'DiscountValue', targetType: 'any' },
                  { path: 'OtherExpensesValue', targetType: 'any' }
                ],
                formatter: 'charges.formatLineGrandTotal'
              }"
          />
        </t:template>
      </t:Column>

      <!-- A amarração fiscal, só relevante no tipo Normal: o campo mostra o CÓDIGO do contrato e o
           value help grava a CHAVE. OneWay é obrigatório porque o campo exibe uma NAVEGAÇÃO — em
           linha ainda não amarrada `PurchaseContract` é null, e no modo TwoWay o setValue tentaria
           escrever dentro do null. Mesmo desenho da coluna "NF de Origem" abaixo. -->
      <t:Column label="Contrato" width="12rem"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Normal' }">
        <t:template>
          <Input
            editable="{ui>/editable}"
            value="{path: 'PurchaseContract/Code', mode: 'OneWay'}"
            showValueHelp="{ui>/editable}"
            valueHelpOnly="true"
            valueHelpRequest=".openContractValueHelp" />
        </t:template>
      </t:Column>

      <!-- A AMARRAÇÃO, só relevante no tipo Devolução: manual, porque o XML da NF-e não diz
           qual linha veio de qual origem. O Input mostra a NF de origem e o value help grava
           a chave da linha. -->
      <t:Column label="NF de Origem" width="12rem" visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' &amp;&amp; ${IsNfeReturn} !== true }">
        <t:template>
          <!-- OneWay é obrigatório: o campo exibe uma NAVEGAÇÃO, e quem grava é o
               `SalesInvoiceItemKey` da linha. No modo padrão (TwoWay) o `setValue` do value help
               tenta escrever em `SalesInvoiceItem/SalesInvoice/InvoiceNumber` — e numa linha ainda
               não amarrada `SalesInvoiceItem` é null, então escolher a origem estourava
               "Cannot set properties of null (setting 'SalesInvoice')". -->
          <Input
            editable="{ui>/editable}"
            value="{path: 'SalesInvoiceItem/SalesInvoice/InvoiceNumber', mode: 'OneWay'}"
            showValueHelp="{ui>/editable}"
            valueHelpOnly="true"
            valueHelpRequest=".openOriginItemValueHelp" />
        </t:template>
      </t:Column>

      <t:Column label="Quebra Apurada" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' &amp;&amp; ${IsNfeReturn} !== true }">
        <t:template>
          <!-- Faturado − líquido recebido: é o volume que o fator efetivo já devolveu ao
               contrato, e o número que o fiscal precisa espelhar. -->
          <Text text="{
            path: 'AssessedShortage',
            type: 'sap.ui.model.odata.type.Decimal',
            constraints: { precision: 18, scale: 3 },
            formatOptions: {
              decimalSeparator: ',',
              groupingEnabled: true,
              groupingSeparator: '.'
            }
          }" />
        </t:template>
      </t:Column>

      <t:Column label="Diferença" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' &amp;&amp; ${IsNfeReturn} !== true }">
        <t:template>
          <ObjectStatus
            text="{
              path: 'Difference',
              type: 'sap.ui.model.odata.type.Decimal',
              constraints: { precision: 18, scale: 3 },
              formatOptions: {
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }"
            state="{
              path: 'Difference',
              targetType: 'any',
              formatter: 'formatter.stateInvoiceDifference'
            }" />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
