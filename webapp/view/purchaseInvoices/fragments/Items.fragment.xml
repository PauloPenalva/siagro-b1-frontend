<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    core:require="{
      formatter: 'siagrob1/model/formatter'
    }"
>
  <t:Table
    id="tablePurchaseInvoiceItems"
    class="sapUiSizeCondensed"
    alternateRowColors="true"
    enableBusyIndicator="true"
    enableSelectAll="false"
    selectionBehavior="Row"
    selectionMode="Single"
    busyIndicatorDelay="0"
    visibleRowCountMode="Auto"
    rows="{Items}"
    >
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Itens" />
          <ToolbarSpacer />
          <ObjectNumber
            number="{ui>/totalItems}"
            unit="Total dos itens"
            emphasized="true"
            state="None" />
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <t:Column label="Produto" width="10rem">
        <t:template>
          <Input value="{ItemCode}" editable="{ui>/editable}" />
        </t:template>
      </t:Column>
      <t:Column label="Descrição">
        <t:template>
          <Input value="{ItemName}" editable="{ui>/editable}" />
        </t:template>
      </t:Column>
      <t:Column label="UM" width="6rem">
        <t:template>
          <Input value="{UnitOfMeasureCode}" editable="{ui>/editable}" maxLength="4" />
        </t:template>
      </t:Column>
      <!-- Campo de ESCRITA de decimal usa `Double`, e não `Decimal`, seguindo o documento de
           saída. Não é preciosismo: `Decimal` faz parse para STRING, e o leitor OData deste
           backend recusa Edm.Decimal em string — o POST volta 400 "The entity field is required",
           sem dizer qual campo. `Double` faz parse para número e passa.
           Só vale para binding que GRAVA; os de exibição abaixo podem continuar com `Decimal`. -->
      <t:Column label="Quantidade" width="10rem" hAlign="End">
        <t:template>
          <Input
            editable="{ui>/editable}"
            value="{
              path: 'Quantity',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions: {
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" />
        </t:template>
      </t:Column>
      <t:Column label="Preço Unitário" width="11rem" hAlign="End">
        <t:template>
          <Input
            editable="{ui>/editable}"
            value="{
              path: 'UnitPrice',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions: {
                decimals: 8,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" />
        </t:template>
      </t:Column>
      <t:Column label="Total" width="10rem" hAlign="End">
        <t:template>
          <Text text="{
            path: 'Total',
            type: 'sap.ui.model.odata.type.Decimal',
            constraints: { precision: 18, scale: 2 },
            formatOptions: {
              decimalSeparator: ',',
              groupingEnabled: true,
              groupingSeparator: '.'
            }
          }" />
        </t:template>
      </t:Column>

      <!-- A AMARRAÇÃO, só relevante no tipo Devolução: manual, porque o XML da NF-e não diz
           qual linha veio de qual origem. O Input mostra a NF de origem e o value help grava
           a chave da linha. -->
      <t:Column label="NF de Origem" width="12rem" visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' }">
        <t:template>
          <!-- OneWay é obrigatório: o campo exibe uma NAVEGAÇÃO, e quem grava é o
               `SalesInvoiceItemKey` da linha. No modo padrão (TwoWay) o `setValue` do value help
               tenta escrever em `SalesInvoiceItem/SalesInvoice/InvoiceNumber` — e numa linha ainda
               não amarrada `SalesInvoiceItem` é null, então escolher a origem estourava
               "Cannot set properties of null (setting 'SalesInvoice')". -->
          <Input
            editable="{ui>/editable}"
            value="{path: 'SalesInvoiceItem/SalesInvoice/InvoiceNumber', mode: 'OneWay'}"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openOriginItemValueHelp" />
        </t:template>
      </t:Column>

      <t:Column label="Quebra Apurada" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' }">
        <t:template>
          <!-- Faturado − líquido recebido: é o volume que o fator efetivo já devolveu ao
               contrato, e o número que o fiscal precisa espelhar. -->
          <Text text="{
            path: 'AssessedShortage',
            type: 'sap.ui.model.odata.type.Decimal',
            constraints: { precision: 18, scale: 3 },
            formatOptions: {
              decimalSeparator: ',',
              groupingEnabled: true,
              groupingSeparator: '.'
            }
          }" />
        </t:template>
      </t:Column>

      <t:Column label="Diferença" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' }">
        <t:template>
          <ObjectStatus
            text="{
              path: 'Difference',
              type: 'sap.ui.model.odata.type.Decimal',
              constraints: { precision: 18, scale: 3 },
              formatOptions: {
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }"
            state="{
              path: 'Difference',
              targetType: 'any',
              formatter: 'formatter.stateInvoiceDifference'
            }" />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
