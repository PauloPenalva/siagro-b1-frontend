<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    core:require="{
      formatter: 'siagrob1/model/formatter', DoubleType: 'sap/ui/model/odata/type/Double', charges: 'siagrob1/helpers/InvoiceChargeTotalsHelpers', draft: 'siagrob1/helpers/PurchaseInvoiceDraftHelpers'
    }"
>
  <t:Table
    id="tablePurchaseInvoiceItems"
    class="sapUiSizeCondensed"
    alternateRowColors="true"
    enableBusyIndicator="true"
    enableSelectAll="false"
    selectionBehavior="Row"
    selectionMode="Single"
    busyIndicatorDelay="0"
    visibleRowCountMode="Auto"
    rows="{Items}"
    >
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Itens" />
          <Button text="Tributos do item" icon="sap-icon://simulate" press=".onOpenItemFiscal" visible="{= ${ui>/taxMode} === true || ${dims>/items/0/Active} === true }" />
          <ToolbarSpacer />
          <ObjectNumber
            number="{ui>/documentTotal}"
            unit="Total geral"
            emphasized="true"
            state="None" />
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <!-- `showValueHelp` liga em `{ui>/editable}` (e em `{ui>/isCounterNote}`), e não em "true": este fragmento é
           o MESMO do Detail, onde a grade é read-only e o botão do diálogo não pode aparecer. Na contra-nota as linhas
           vêm da escrituração do produtor e também ficam somente leitura. -->
      <!-- `.openLineItemValueHelp`, não o genérico `.openItemValueHelp`: aqui a troca de produto
           também precisa desamarrar o contrato da linha (coluna "Contrato" abaixo). -->
      <t:Column label="Produto" width="10rem">
        <t:template>
          <Input
            value="{ItemCode}"
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true &amp;&amp; !${path: 'ComplementedItemKey', targetType: 'any'} }"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true &amp;&amp; !${path: 'ComplementedItemKey', targetType: 'any'} }"
            valueHelpOnly="true"
            valueHelpRequest=".openLineItemValueHelp">
            <customData>
              <core:CustomData key="descriptionProperty" value="ItemName" />
            </customData>
          </Input>
        </t:template>
      </t:Column>
      <!-- Consequência do produto escolhido, nunca digitada: quem preenche é o gatilho do value
           help. O que veio do XML continua exibido intacto até o operador trocar o produto. -->
      <t:Column label="Descrição">
        <t:template>
          <Input value="{ItemName}" editable="false" />
        </t:template>
      </t:Column>
      <!-- Natureza da linha (própria e terceiro Normal na filial que calcula tributos): só naturezas de Entrada. Na devolução de compra vem da natureza de
           devolução da linha comprada e não muda. -->
      <t:Column label="Natureza" width="14rem" visible="{= ${ui>/taxMode} === true || ${path: 'InvoiceType', targetType: 'any'} === 'ValueComplement' || ${path: 'InvoiceType', targetType: 'any'} === 'IcmsComplement' || (${path: 'InvoiceType', targetType: 'any'} === 'Normal' &amp;&amp; ${ui>/hasOtherPurchaseUsages} === true) }">
        <t:template>
          <!-- ui5lint-disable no-deprecated-api -->
          <Input
            value="{UsageName}"
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true &amp;&amp; !${path: 'ComplementedItemKey', targetType: 'any'} }"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true &amp;&amp; !${path: 'ComplementedItemKey', targetType: 'any'} }"
            valueHelpOnly="true"
            valueHelpRequest=".openPurchaseUsageValueHelp" />
          <!-- ui5lint-enable no-deprecated-api -->
        </t:template>
      </t:Column>
      <t:Column label="CFOP" width="6rem" visible="{= ${ui>/taxMode} === true }">
        <t:template>
          <Text text="{Cfop}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="UM" width="6rem">
        <t:template>
          <Input
            value="{UnitOfMeasureCode}"
            required="{= ${ui>/valueComplement} !== true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true }"
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true &amp;&amp; !${path: 'ComplementedItemKey', targetType: 'any'} }"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true &amp;&amp; !${path: 'ComplementedItemKey', targetType: 'any'} }"
            valueHelpOnly="true"
            valueHelpRequest=".openUnitsOfMeasureValueHelp" />
        </t:template>
      </t:Column>
      <!-- Campo de ESCRITA de decimal usa `Double`, e não `Decimal`, seguindo o documento de
           saída. Não é preciosismo: `Decimal` faz parse para STRING, e o leitor OData deste
           backend recusa Edm.Decimal em string — o POST volta 400 "The entity field is required",
           sem dizer qual campo. `Double` faz parse para número e passa.
           Só vale para binding que GRAVA; os de exibição abaixo podem continuar com `Decimal`. -->
      <t:Column label="Quantidade" width="10rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} !== 'ValueComplement' &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} !== 'IcmsComplement' }">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
            change=".onItemAmountChange"
            value="{
              path: 'Quantity',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions: {
                decimals: 3,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" />
        </t:template>
      </t:Column>
      <t:Column label="Preço Unitário" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} !== 'ValueComplement' &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} !== 'IcmsComplement' }">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/isCounterNote} !== true }"
            change=".onItemAmountChange"
            value="{
              path: 'UnitPrice',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions: {
                decimals: 8,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" />
        </t:template>
      </t:Column>
      <!-- Complemento de valor (spec 2026-10-13 D11): a linha não tem quantidade nem preço, só o valor. Escrita de decimal
           em Double, como frete e seguro. -->
      <t:Column label="Valor do complemento" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'ValueComplement' }">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true }"
            change=".onItemAmountChange"
            value="{
              path: 'ComplementAmount',
              type: 'sap.ui.model.odata.type.Double',
              formatOptions: {
                decimals: 2,
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }" />
        </t:template>
      </t:Column>
      <!-- Complemento de ICMS (spec 2026-10-17 D4): o operador informa a base e o valor do ICMS da linha; o motor não
           calcula. Escrita de decimal em Double. Fora do complemento de ICMS as colunas somem. -->
      <t:Column label="Base ICMS" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'IcmsComplement' }">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true }"
            textAlign="End"
            value="{
              path: 'IcmsBase',
              type: 'DoubleType',
              formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
            }" />
        </t:template>
      </t:Column>
      <t:Column label="ICMS" width="10rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'IcmsComplement' }">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true }"
            textAlign="End"
            value="{
              path: 'IcmsValue',
              type: 'DoubleType',
              formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
            }" />
        </t:template>
      </t:Column>
      <!-- Frete, seguro, desconto e outras despesas da linha (spec 2026-10-05 §10). Campo de ESCRITA de decimal usa
           `Double`, nunca `Decimal` (o backend recusa Edm.Decimal em string). Editáveis também na devolução Pendente
           (vêm da venda na proporção do que volta). -->
      <t:Column label="Frete" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'FreightValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Seguro" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'InsuranceValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Desconto" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'DiscountValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Outras despesas" hAlign="End" width="9rem">
        <t:template>
          <Input
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
              textAlign="End"
              change=".onItemAmountChange"
              value="{
                path: 'OtherExpensesValue',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }"
          />
        </t:template>
      </t:Column>
      <t:Column label="Total" width="10rem" hAlign="End">
        <t:template>
          <!-- Total geral da linha (itens + frete + seguro + outras despesas − desconto), calculado no cliente: GrandTotal é [NotMapped]. targetType 'any' em cada parte: sem ele o binding composto entrega texto e a soma vira NaN. -->
          <Text
              text="{
                parts: [
                  { path: 'Quantity', targetType: 'any' },
                  { path: 'UnitPrice', targetType: 'any' },
                  { path: 'FreightValue', targetType: 'any' },
                  { path: 'InsuranceValue', targetType: 'any' },
                  { path: 'DiscountValue', targetType: 'any' },
                  { path: 'OtherExpensesValue', targetType: 'any' },
                  { path: 'ComplementAmount', targetType: 'any' }
                ],
                formatter: 'charges.formatLineGrandTotal'
              }"
          />
        </t:template>
      </t:Column>

      <!-- Linha de "outra compra" (natureza sem contrato que gera título): a célula trava e o value help some; o servidor
           recusa contrato nessa linha. O produto dela vem de /ActiveItems() (openLineItemValueHelp). -->
      <!-- A amarração fiscal (Normal, Complemento de valor e Devolução — a devolução digitada à mão precisa informá-lo para nascer o título PurchaseReturn): o campo mostra o CÓDIGO do contrato e o
           value help grava a CHAVE. OneWay é obrigatório porque o campo exibe uma NAVEGAÇÃO — em
           linha ainda não amarrada `PurchaseContract` é null, e no modo TwoWay o setValue tentaria
           escrever dentro do null. Mesmo desenho da coluna "NF de Origem" abaixo. -->
      <t:Column label="Contrato" width="12rem"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Normal' || ${path: 'InvoiceType', targetType: 'any'} === 'ValueComplement' || ${path: 'InvoiceType', targetType: 'any'} === 'IcmsComplement' || ${path: 'InvoiceType', targetType: 'any'} === 'Return' }">
        <t:template>
          <!-- O código escolhido na tela (ui>/contractCodes) vale mais que a NAVEGAÇÃO: a linha nova do complemento
               próprio não tem a navegação, e ela fica velha quando o contrato é trocado (draft.formatContractCode).
               Complemento próprio (D5): travado quando o item original tem contrato (herdado), editável pelo value help
               de sempre quando não tem (draft.isLineContractEditable lê ui>/inheritedContracts). -->
          <Input
            editable="{parts: [{path: 'ui>/editable'}, {path: 'ui>/isCounterNote'}, {path: 'ComplementedItemKey', targetType: 'any'}, {path: 'ui>/inheritedContracts'}, {path: 'UsageCode', targetType: 'any'}, {path: 'ui>/otherPurchaseUsages'}, {path: 'ui>/otherPurchaseEligible'}], formatter: 'draft.isLineContractEditable'}"
            value="{parts: [{path: 'PurchaseContract/Code', mode: 'OneWay'}, {path: 'PurchaseContractKey', mode: 'OneWay'}, {path: 'ui>/contractCodes', mode: 'OneWay'}], formatter: 'draft.formatContractCode', mode: 'OneWay'}"
            showValueHelp="{parts: [{path: 'ui>/editable'}, {path: 'ui>/isCounterNote'}, {path: 'ComplementedItemKey', targetType: 'any'}, {path: 'ui>/inheritedContracts'}, {path: 'UsageCode', targetType: 'any'}, {path: 'ui>/otherPurchaseUsages'}, {path: 'ui>/otherPurchaseEligible'}], formatter: 'draft.isLineContractEditable'}"
            valueHelpOnly="true"
            valueHelpRequest=".openContractValueHelp" />
        </t:template>
      </t:Column>

      <!-- Complemento de valor próprio (spec 2026-10-14): o item da nota original que a linha complementa, como
           documento/item. Lido do mapa ui>/complementedItemLabels (function de candidatos), não de $expand. -->
      <t:Column label="Nota original" width="9rem" visible="{= ${ui>/ownComplement} === true }">
        <t:template>
          <Text
            wrapping="false"
            text="{parts: [{path: 'ComplementedItemKey', targetType: 'any'}, {path: 'ui>/complementedItemLabels'}], formatter: 'draft.formatComplementedItem'}" />
        </t:template>
      </t:Column>

      <!-- A AMARRAÇÃO, só relevante no tipo Devolução: manual, porque o XML da NF-e não diz
           qual linha veio de qual origem. O Input mostra a NF de origem e o value help grava
           a chave da linha. -->
      <t:Column label="NF de Origem" width="12rem" visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' &amp;&amp; ${IsNfeReturn} !== true }">
        <t:template>
          <!-- OneWay é obrigatório: o campo exibe uma NAVEGAÇÃO, e quem grava é o
               `SalesInvoiceItemKey` da linha. No modo padrão (TwoWay) o `setValue` do value help
               tenta escrever em `SalesInvoiceItem/SalesInvoice/InvoiceNumber` — e numa linha ainda
               não amarrada `SalesInvoiceItem` é null, então escolher a origem estourava
               "Cannot set properties of null (setting 'SalesInvoice')". -->
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
            value="{path: 'SalesInvoiceItem/SalesInvoice/InvoiceNumber', mode: 'OneWay'}"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
            valueHelpOnly="true"
            valueHelpRequest=".openOriginItemValueHelp" />
        </t:template>
      </t:Column>

      <!-- Retorno de depósito (spec backend 2026-10-10 §5.3): a linha aponta a linha da remessa. OneWay pelo mesmo
           motivo da NF de Origem: o campo exibe uma NAVEGAÇÃO e quem grava é o SalesInvoiceItemKey. -->
      <t:Column label="Remessa" width="10rem"
                visible="{= ${ui>/storageDepositMode} === true &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} !== 'Return' &amp;&amp; ${ui>/isCounterNote} !== true }">
        <t:template>
          <Input
            editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
            value="{parts: [{path: 'SalesInvoiceItem/SalesInvoice/TaxDocumentNumber', mode: 'OneWay'}, {path: 'SalesInvoiceItem/SalesInvoice/InvoiceNumber', mode: 'OneWay'}, {path: 'NfeItemNumber', mode: 'OneWay'}, {path: 'ui>/remittanceNumbers', mode: 'OneWay'}], formatter: 'draft.formatRemittanceNumber', mode: 'OneWay'}"
            showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${ui>/isCounterNote} !== true }"
            valueHelpOnly="true"
            valueHelpRequest=".openRemittanceItemValueHelp" />
        </t:template>
      </t:Column>

      <t:Column label="Quebra Apurada" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' &amp;&amp; ${IsNfeReturn} !== true }">
        <t:template>
          <!-- Faturado − líquido recebido: é o volume que o fator efetivo já devolveu ao
               contrato, e o número que o fiscal precisa espelhar. -->
          <Text text="{
            path: 'AssessedShortage',
            type: 'sap.ui.model.odata.type.Decimal',
            constraints: { precision: 18, scale: 3 },
            formatOptions: {
              decimalSeparator: ',',
              groupingEnabled: true,
              groupingSeparator: '.'
            }
          }" />
        </t:template>
      </t:Column>

      <t:Column label="Diferença" width="11rem" hAlign="End"
                visible="{= ${path: 'InvoiceType', targetType: 'any'} === 'Return' &amp;&amp; ${IsNfeReturn} !== true }">
        <t:template>
          <ObjectStatus
            text="{
              path: 'Difference',
              type: 'sap.ui.model.odata.type.Decimal',
              constraints: { precision: 18, scale: 3 },
              formatOptions: {
                decimalSeparator: ',',
                groupingEnabled: true,
                groupingSeparator: '.'
              }
            }"
            state="{
              path: 'Difference',
              targetType: 'any',
              formatter: 'formatter.stateInvoiceDifference'
            }" />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
