<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    core:require="{ DoubleType: 'sap/ui/model/odata/type/Double', nfeHelpers: 'siagrob1/helpers/PurchaseInvoiceNfeHelpers', draft: 'siagrob1/helpers/PurchaseInvoiceDraftHelpers' }"
>
    <!-- Mesmo desenho do formulário do documento de saída (salesInvoices/fragments/Form): três colunas no XL,
         seções Dados do Documento, Transporte, Dados da NF-e, Informações Complementares e Outras Informações. -->
    <f:SimpleForm
      id="purchaseInvoicesForm"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
      busyIndicatorDelay="0">
        <f:content>
          <core:Title text="Dados do Documento de Entrada" emphasized="true" />

          <!-- Número interno (DE000001): na inclusão a série decide — Automático (o servidor gera ao gravar)
               ou Manual (o operador digita). Depois de gravado nunca muda: série e número só editáveis na inclusão. -->
          <Label text="Número interno" />
          <Select
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true }"
              forceSelection="false"
              required="true"
              change=".onDocNumberSeriesChange"
              selectedKey="{DocNumberKey}"
              items="{
                path: '/DocNumbers',
                parameters: {
                  $filter: 'TransactionCode eq \'PurchaseInvoice\' and Inactive eq false',
                  $orderby: 'IsManual,Name',
                  $select: 'Key,Name,IsManual'
                }
              }">
            <customData>
              <core:CustomData key="codeProperty" value="InvoiceNumber" />
            </customData>
            <core:ListItem key="{Key}" text="{Name}" />
          </Select>
          <Input
              value="{InvoiceNumber}"
              editable="{= ${ui>/docNumberManual} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true }"
              required="{= ${ui>/docNumberManual} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true }"
              maxLength="9" />

          <!-- Depois que existe número reservado ou NF-e (NfeStatus diferente de None, ou NfeRandomCode), a filial
               fica travada: trocá-la invalidaria a numeração e o cálculo já feitos (spec D10). -->
          <!-- Filial do documento: decide se a emissão própria sai com NF-e pelo Siagro (modo NF-e). -->
          <Label text="Filial" />
          <Select
            selectedKey="{BranchCode}"
            editable="{= ${ui>/editable} === true &amp;&amp; ${IsNfeReturn} !== true &amp;&amp; !${path: 'ProducerInvoiceKey', targetType: 'any'} &amp;&amp; !${path: 'NfeRandomCode', targetType: 'any'} &amp;&amp; (${path: 'NfeStatus', targetType: 'any'} === undefined || ${path: 'NfeStatus', targetType: 'any'} === null || ${path: 'NfeStatus', targetType: 'any'} === 'None') }"
            forceSelection="false"
            change=".onBranchChange"
            items="{ path: '/Branchs', sorter: { path: 'Code' } }"
            width="100%">
            <core:ListItem key="{Code}" text="{ShortName}" additionalText="{Code}" />
          </Select>

          <!-- O tipo define a natureza do documento e as regras que o acompanham; mudá-lo depois
               de gravado invalidaria as amarrações já feitas. Editável só na inclusão. -->
          <!-- DUAS armadilhas neste par de Selects, ambas invisíveis fora do navegador:
               1. `targetType: 'any'` é obrigatório em propriedade de ENUM — sem ele o UI5 tenta
                  formatar com sap.ui.model.odata.type.Raw e estoura FormatException;
               2. `forceSelection="false"` é obrigatório sobre entidade TRANSIENTE — no padrão
                  (true) o Select auto-seleciona um item na inicialização e ESCREVE a chave de
                  volta, o que abre "Must not change a property before it has been read" em
                  diálogo de erro na cara do usuário. -->
          <!-- No modo NF-e (Emissão Própria na filial que emite pelo Siagro) o tipo é Normal ou Complemento de valor
               (NF-e complementar, spec 2026-10-14): a devolução de compra própria só nasce pelo "Devolver" (o servidor
               recusa a manual), por isso o item Devolução fica desabilitado nesse modo, e uma Devolução escolhida antes
               volta para Normal (mustFallBackToNormal). A devolução do cliente (De terceiro) e a filial sem NF-e seguem
               escolhendo os três. -->
          <!-- Complemento de ICMS (spec 2026-10-17 D10): só STANDALONE. Item desabilitado some da lista do sap.m.Select
               (hideDisabledItems), então o enabled em ui>/standalone esconde o tipo em SAPB1. -->
          <Label text="Tipo" />
          <Select
            selectedKey="{path: 'InvoiceType', targetType: 'any'}"
            change=".onInvoiceTypeChange"
            enabled="{= ${ui>/typeEditable} === true }"
            forceSelection="false"
            width="100%">
            <core:Item key="Normal" text="Normal" />
            <core:Item key="Return" text="Devolução" enabled="{= ${ui>/nfeMode} !== true }" />
            <core:Item key="ValueComplement" text="Complemento de valor" />
            <core:Item key="IcmsComplement" text="Complemento de ICMS" enabled="{= ${ui>/standalone} === true }" />
          </Select>

          <Label text="Emissão" />
          <Select
            selectedKey="{path: 'IssuerType', targetType: 'any'}"
            enabled="{ui>/typeEditable}"
            forceSelection="false"
            change=".onIssuerTypeChange"
            width="100%">
            <core:Item key="ThirdParty" text="De terceiro" />
            <core:Item key="Own" text="Própria" />
          </Select>

          <!-- Vínculos da contra-nota (spec 2026-10-10 §9): a escrituração mostra a contra-nota válida; a contra-nota mostra
               a escrituração do produtor de que nasceu. -->
          <Label text="Contra-nota" visible="{= !!${ui>/counterNote/key} }" />
          <Link text="{ui>/counterNote/text}" visible="{= !!${ui>/counterNote/key} }" press=".onOpenCounterNote" />
          <Label text="Escrituração do produtor" visible="{= !!${ui>/producerInvoice/key} }" />
          <Link text="{ui>/producerInvoice/text}" visible="{= !!${ui>/producerInvoice/key} }" press=".onOpenProducerInvoice" />

          <!-- Nota de custódia em armazém próprio (spec backend 2026-10-12 §4.4): romaneio do lote de terceiro que esta
               entrada cumpre. Escolhido à mão na escrituração da NF-e do depositante (o XML não o identifica); a nota
               própria gerada pelo romaneio já nasce com ele. O servidor exige quando a natureza da linha é de custódia. -->
          <Label text="Romaneio (custódia)"
                 visible="{= ${ui>/storageDepositMode} === true &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} === 'Normal' &amp;&amp; (${ui>/editable} === true || !!${ui>/custody/key}) }" />
          <HBox
            visible="{= ${ui>/editable} === true &amp;&amp; ${ui>/storageDepositMode} === true &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} === 'Normal' }">
            <Input
              width="100%"
              value="{ui>/custody/code}"
              showValueHelp="true"
              valueHelpOnly="true"
              valueHelpRequest=".openCustodyTransactionValueHelp" />
            <Button icon="sap-icon://decline" type="Transparent" tooltip="Limpar romaneio"
                    visible="{= !!${ui>/custody/key} }" press=".onClearCustodyTransaction" />
          </HBox>
          <Link text="{ui>/custody/code}"
                visible="{= ${ui>/editable} !== true &amp;&amp; !!${ui>/custody/key} }"
                press=".onOpenCustodyTransaction" />

          <!-- Documento de terceiro Normal na filial que emite NF-e pelo Siagro: NF-e (eletrônica, com a chave
               conferida) ou outro documento (serviço, papel/talão), sem chave. Fora disso o campo some: a emissão
               própria é sempre NF-e, a devolução do cliente não tem chave e a filial sem a regra (SAPB1, MH Agro)
               fica como sempre foi. -->
          <Label text="Tipo de documento"
            visible="{= (${ui>/taxLocked} === true || ${ui>/storageDepositMode} === true) &amp;&amp; ${path: 'IssuerType', targetType: 'any'} === 'ThirdParty' &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} === 'Normal' }" />
          <Select
            visible="{= (${ui>/taxLocked} === true || ${ui>/storageDepositMode} === true) &amp;&amp; ${path: 'IssuerType', targetType: 'any'} === 'ThirdParty' &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} === 'Normal' }"
            selectedKey="{path: 'TaxDocumentKind', targetType: 'any'}"
            enabled="{= ${ui>/editable} === true }"
            forceSelection="false"
            change=".onTaxDocumentKindChange"
            width="100%">
            <core:Item key="Nfe" text="NF-e (eletrônica)" />
            <!-- Itens estáticos: reconstruir os itens com selectedKey em duas vias esvazia/zera o valor gravado. O CT-e só
                 é oferecido no STANDALONE (ou se o documento já é CT-e). -->
            <core:Item key="Cte" text="CT-e (frete)"
              enabled="{= ${ui>/storageDepositMode} === true || ${path: 'TaxDocumentKind', targetType: 'any'} === 'Cte' }" />
            <core:Item key="Other" text="Outro (serviço, papel/talão…)" />
          </Select>

          <Label text="Emitente" required="true" />
          <Input
              value="{CardCode}"
              editable="{= ${ui>/editable} === true &amp;&amp; ${IsNfeReturn} !== true &amp;&amp; !${path: 'ProducerInvoiceKey', targetType: 'any'} }"
              showValueHelp="{= ${ui>/editable} === true &amp;&amp; ${IsNfeReturn} !== true &amp;&amp; !${path: 'ProducerInvoiceKey', targetType: 'any'} }"
              valueHelpOnly="true"
              valueHelpRequest=".openBusinessPartnersValueHelp">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
            <customData>
              <core:CustomData key="descriptionProperty" value="CardName" />
            </customData>
          </Input>
          <Input value="{CardName}" editable="false" />

          <Label text="Data de emissão" />
          <DatePicker
              value="{
                path: 'IssueDate',
                type: 'sap.ui.model.odata.type.DateTimeOffset',
                constraints: { precision: 7 },
                formatOptions: { pattern: 'dd/MM/yyyy' }
              }"
              editable="{ui>/editable}" />

          <Label text="Data de entrada" />
          <DatePicker
              value="{
                path: 'PostingDate',
                type: 'sap.ui.model.odata.type.DateTimeOffset',
                constraints: { precision: 7 },
                formatOptions: { pattern: 'dd/MM/yyyy' }
              }"
              editable="{ui>/editable}" />

          <!-- Total DECLARADO pelo emitente. Divergir da soma das linhas é informação de
               conciliação (frete e impostos entram aqui e não nas linhas), não erro. -->
          <!-- `Double` e não `Decimal`: campo de ESCRITA. `Decimal` faz parse para string e o
               leitor OData deste backend recusa Edm.Decimal em string (400 sem nomear o campo).
               Mesma escolha do documento de saída. -->
          <!-- Gravado pelo sistema, não digitado: na emissão própria é o vNF da emissão; no terceiro Normal da filial
               que emite pelo Siagro, a soma das linhas a cada gravação. Fora disso segue digitado. -->
          <Label text="Valor declarado" />
          <Input
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/taxMode} !== true }"
              value="{
                path: 'TotalDocumentValue',
                type: 'sap.ui.model.odata.type.Double',
                formatOptions: {
                  decimals: 2,
                  decimalSeparator: ',',
                  groupingEnabled: true,
                  groupingSeparator: '.'
                }
              }">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
          </Input>

          <!-- Filial que emite pelo Siagro, emissão própria ou de terceiro Normal (a tela do terceiro é igual à da
               própria). Na própria a condição vira cobr/dup e pag; padrão do fornecedor. A devolução de compra não tem
               pagamento (tPag 90), nem o complemento de ICMS (D8). O complemento de valor de terceiro sem contrato (outra
               compra, spec 2026-10-17 D3/D6) também mostra: as parcelas saem dela. -->
          <Label text="Condição de pagamento"
                 visible="{= (${ui>/taxMode} === true || ${ui>/otherPurchaseDoc} === true) &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/icmsComplement} !== true }" />
          <!-- ui5lint-disable no-deprecated-api -->
          <Input
            visible="{= (${ui>/taxMode} === true || ${ui>/otherPurchaseDoc} === true) &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/icmsComplement} !== true }"
            editable="{= ${ui>/editable} === true &amp;&amp; !${path: 'ProducerInvoiceKey', targetType: 'any'} }"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openPaymentConditionsValueHelp"
            value="{PaymentConditionCode}">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
          </Input>
          <!-- ui5lint-enable no-deprecated-api -->
          <Input value="{ui>/paymentConditionName}" editable="false"
                 visible="{= (${ui>/taxMode} === true || ${ui>/otherPurchaseDoc} === true) &amp;&amp; ${ui>/nfeReturn} !== true &amp;&amp; ${ui>/icmsComplement} !== true }" />

          <!-- Transporte, pesos e volume (grupos transp e vol da NF-e): emissão própria e terceiro Normal na filial
               que emite pelo Siagro, com a mesma tela. Peso bruto e líquido são exigidos na emissão própria
               (NfeReadinessValidator); no terceiro são os dados da nota do fornecedor. Na devolução de compra seguem
               editáveis (spec 9.3). O texto do título some fora disso porque core:Title não tem visible. Ordem do grupo vol da NF-e/DANFE: peso bruto, peso
               líquido, quantidade, espécie, marca e numeração. O complemento de ICMS não tem transporte nem pesos (D8,
               modFrete 9). -->
          <core:Title id="purchaseInvoicesTransportTitle" text="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true ? 'Transporte' : '' }" />

          <!-- ui5lint-disable no-deprecated-api -->
          <Label text="Transportadora" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true }"
              editable="{ui>/editable}"
              showValueHelp="true"
              valueHelpOnly="true"
              valueHelpRequest=".openBusinessPartnersValueHelp"
              value="{TruckingCompanyCode}">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
            <customData>
              <core:CustomData key="descriptionProperty" value="TruckingCompanyName:CardName" />
            </customData>
          </Input>
          <Input value="{TruckingCompanyName}" editable="false" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true }" />

          <Label text="Placa" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true }"
              editable="{ui>/editable}"
              showValueHelp="true"
              valueHelpOnly="true"
              valueHelpRequest=".openTrucksValueHelp"
              value="{TruckCode}">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
          </Input>
          <!-- ui5lint-enable no-deprecated-api -->

          <Label text="Tipo do Frete" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true }" />
          <Select
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true }"
              editable="{ui>/editable}"
              forceSelection="false"
              width="100%"
              selectedKey="{path: 'FreightTerms', targetType: 'any'}">
            <core:ListItem key="Cif" text="CIF" />
            <core:ListItem key="Fob" text="FOB" />
            <core:ListItem key="Ter" text="TER" />
            <core:ListItem key="None" text="SEM FRETE" />
          </Select>

          <!-- `Double` e não `Decimal`: campo de ESCRITA (o leitor OData recusa Edm.Decimal em string). -->
          <Label text="Peso Bruto" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }"
              editable="{ui>/editable}"
              value="{
                path: 'GrossWeight',
                type: 'DoubleType',
                formatOptions: {
                  decimals: 3,
                  decimalSeparator: ',',
                  groupingEnabled: true,
                  groupingSeparator: '.'
                }
              }">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
          </Input>

          <Label text="Peso Líquido" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }"
              editable="{ui>/editable}"
              value="{
                path: 'NetWeight',
                type: 'DoubleType',
                formatOptions: {
                  decimals: 3,
                  decimalSeparator: ',',
                  groupingEnabled: true,
                  groupingSeparator: '.'
                }
              }">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
          </Input>

          <Label text="Qtde. Volumes" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }"
              editable="{ui>/editable}"
              value="{VolumeQuantity}">
            <layoutData>
              <l:GridData span="XL3 L3 M3 S8" />
            </layoutData>
          </Input>

          <Label text="Espécie" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }"
              editable="{ui>/editable}"
              value="{VolumeSpecies}"
              maxLength="60"
              placeholder="GRANEL, SACO, BAG, CAIXA" />

          <Label text="Marca" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }"
              editable="{ui>/editable}"
              value="{VolumeBrand}"
              maxLength="60" />

          <Label text="Numeração" visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }" />
          <Input
              visible="{= ${ui>/taxMode} === true &amp;&amp; ${ui>/icmsComplement} !== true &amp;&amp; ${ui>/isCte} !== true }"
              editable="{ui>/editable}"
              value="{VolumeNumbering}"
              maxLength="60" />

          <!-- Na entrada de terceiro são os dados da nota do fornecedor, digitados ou lidos do XML. No modo NF-e
               quem grava número, série e chave é a emissão. -->
          <core:Title text="{= ${ui>/isCte} === true ? 'Dados do CT-e' : 'Dados da NF-e' }" />

          <Label text="Número" />
          <Input value="{TaxDocumentNumber}" editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeMode} !== true }" maxLength="9" />

          <Label text="Série" />
          <Input value="{TaxDocumentSeries}" editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeMode} !== true }" maxLength="3" />

          <!-- A chave tem 44 dígitos, mas a colada do DANFE vem com espaços (54 caracteres): maxLength menor trunca
               em silêncio. O servidor tira os espaços antes de validar e grava os 44 dígitos. -->
          <Label text="{= ${ui>/isCte} === true ? 'Chave de acesso do CT-e' : 'Chave de Acesso'}"
            required="{= ${ui>/editable} === true &amp;&amp; ${ui>/taxLocked} === true &amp;&amp; ${path: 'IssuerType', targetType: 'any'} === 'ThirdParty' &amp;&amp; ${path: 'InvoiceType', targetType: 'any'} === 'Normal' &amp;&amp; (${path: 'TaxDocumentKind', targetType: 'any'} === 'Nfe' || ${ui>/isCte} === true) }" />
          <Input value="{ChaveNFe}" editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeMode} !== true }" maxLength="54" />

          <!-- Prestação do CT-e (frete tomado, spec 2026-10-17): o CT-e é sempre de terceiro e tem uma linha só. O CNPJ
               do tomador precisa ser o da filial; o servidor confere. UF por value help da tabela de estados. -->
          <Label text="UF de início da prestação" required="{= ${ui>/editable} === true }" visible="{ui>/isCte}" />
          <!-- ui5lint-disable no-deprecated-api -->
          <Input value="{FreightStartState}" maxLength="2" visible="{ui>/isCte}"
                 editable="{ui>/editable}" showValueHelp="{ui>/editable}" valueHelpOnly="true"
                 valueHelpRequest=".openStatesAbbreviationValueHelp" />
          <Label text="Município de início" visible="{ui>/isCte}" />
          <Input value="{FreightStartCity}" maxLength="60" visible="{ui>/isCte}" editable="{ui>/editable}" />
          <Label text="UF de fim da prestação" required="{= ${ui>/editable} === true }" visible="{ui>/isCte}" />
          <Input value="{FreightEndState}" maxLength="2" visible="{ui>/isCte}"
                 editable="{ui>/editable}" showValueHelp="{ui>/editable}" valueHelpOnly="true"
                 valueHelpRequest=".openStatesAbbreviationValueHelp" />
          <!-- ui5lint-enable no-deprecated-api -->
          <Label text="Município de fim" visible="{ui>/isCte}" />
          <Input value="{FreightEndCity}" maxLength="60" visible="{ui>/isCte}" editable="{ui>/editable}" />
          <Label text="CNPJ do tomador" required="{= ${ui>/editable} === true }" visible="{ui>/isCte}" />
          <Input value="{FreightPayerTaxId}" maxLength="14" visible="{ui>/isCte}" editable="{ui>/editable}" />

          <!-- Autorização da NF-e do fornecedor gravada pelo confirmar com a filial em Produção (spec terceiro-chave R4). -->
          <Label text="Autorização na SEFAZ" visible="{= !!${path: 'SupplierNfeProtocol', targetType: 'any'} }" />
          <Text
            visible="{= !!${path: 'SupplierNfeProtocol', targetType: 'any'} }"
            text="{parts: [{path: 'SupplierNfeProtocol', targetType: 'any'}, {path: 'SupplierNfeCheckedAt', targetType: 'any'}], formatter: 'nfeHelpers.supplierNfeAuthorizationText'}" />

          <core:Title text="Informações Complementares" />
          <!-- Entrada de terceiro: é AQUI que o emitente escreve número/série/chave e quantidade das notas de
               origem; o layout da NF-e não amarra linha a origem, então este texto é a referência que o
               operador usa para fazer a amarração na grade. Na emissão própria (modo NF-e) é o infCpl que o
               operador escreve e vai na NF-e. O texto do Funrural NÃO se digita aqui: é gerado automaticamente na emissão. -->
          <Label text="{= ${ui>/nfeMode} === true ? 'Inf.Contribuinte' : 'Referências informadas pelo emitente' }" />
          <TextArea
              value="{TaxPayerComments}"
              editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/nfeMode} === true }"
              rows="5"
              growing="true"
              width="100%" />

          <core:Title text="Outras Informações" />
          <Label text="Observações" />
          <TextArea value="{Comments}" editable="{ui>/editable}" rows="5" width="100%" />

          <!-- Retenções de serviço (outra compra): só quando TODAS as linhas têm natureza de outra compra. core:Title não
               tem visible, então o texto some junto (mesmo recurso do bloco Transporte). Valores gravados: Double e não
               Decimal (o leitor OData recusa Edm.Decimal em string). Editar qualquer um liga WithholdingsManual
               (onWithholdingChange); sem a flag o servidor recalcula tudo pelas alíquotas a cada gravação. Total retido
               e Líquido a pagar são calculados aqui (TotalWithheld/NetPayable são [NotMapped] e viram late property). -->
          <core:Title text="{= ${ui>/otherPurchaseDoc} === true ? 'Retenções' : '' }" />

          <Label text="Base de cálculo" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="{ui>/editable}"
              textAlign="End"
              change=".onWithholdingChange"
              value="{
                path: 'WithholdingBase',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }" />

          <Label text="ISS retido" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="{ui>/editable}"
              textAlign="End"
              change=".onWithholdingChange"
              value="{
                path: 'WithheldIss',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }" />

          <Label text="IRRF retido" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="{ui>/editable}"
              textAlign="End"
              change=".onWithholdingChange"
              value="{
                path: 'WithheldIrrf',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }" />

          <Label text="INSS retido" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="{ui>/editable}"
              textAlign="End"
              change=".onWithholdingChange"
              value="{
                path: 'WithheldInss',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }" />

          <Label text="PIS retido" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="{ui>/editable}"
              textAlign="End"
              change=".onWithholdingChange"
              value="{
                path: 'WithheldPis',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }" />

          <Label text="COFINS retido" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="{ui>/editable}"
              textAlign="End"
              change=".onWithholdingChange"
              value="{
                path: 'WithheldCofins',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }" />

          <Label text="CSLL retido" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="{ui>/editable}"
              textAlign="End"
              change=".onWithholdingChange"
              value="{
                path: 'WithheldCsll',
                type: 'DoubleType',
                formatOptions: { decimals: 2, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
              }" />

          <Label text="Total retido" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="false"
              textAlign="End"
              value="{
                parts: [
                  { path: 'WithheldIss', targetType: 'any' }, { path: 'WithheldIrrf', targetType: 'any' },
                  { path: 'WithheldInss', targetType: 'any' }, { path: 'WithheldPis', targetType: 'any' },
                  { path: 'WithheldCofins', targetType: 'any' }, { path: 'WithheldCsll', targetType: 'any' }
                ],
                formatter: 'draft.formatTotalWithheld',
                mode: 'OneWay'
              }" />

          <Label text="Líquido a pagar" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <Input
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="false"
              textAlign="End"
              value="{
                parts: [
                  { path: 'WithheldIss', targetType: 'any' }, { path: 'WithheldIrrf', targetType: 'any' },
                  { path: 'WithheldInss', targetType: 'any' }, { path: 'WithheldPis', targetType: 'any' },
                  { path: 'WithheldCofins', targetType: 'any' }, { path: 'WithheldCsll', targetType: 'any' },
                  { path: 'ui>/chargeTotals/netPayable' }
                ],
                formatter: 'draft.formatNetPayable',
                mode: 'OneWay'
              }" />

          <!-- Indicador e, ao mesmo tempo, a leitura de WithholdingsManual (entra no $select; sem ela o UI5 recusa a
               escrita da flag). Somente leitura: liga-se editando um valor e desliga-se em "Recalcular pelas alíquotas". -->
          <Label text="Informadas manualmente" visible="{= ${ui>/otherPurchaseDoc} === true }" />
          <CheckBox
              visible="{= ${ui>/otherPurchaseDoc} === true }"
              editable="false"
              selected="{path: 'WithholdingsManual', mode: 'OneWay'}" />

          <Label text="" visible="{= ${ui>/otherPurchaseDoc} === true &amp;&amp; ${ui>/withholdingsRecalculable} === true }" />
          <Button
              text="Recalcular pelas alíquotas"
              icon="sap-icon://synchronize"
              visible="{= ${ui>/otherPurchaseDoc} === true &amp;&amp; ${ui>/editable} === true &amp;&amp; ${ui>/withholdingsRecalculable} === true }"
              press=".onRecalculateWithholdings" />
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>
