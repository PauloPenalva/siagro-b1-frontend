<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
  <!--
    Alterações feitas no documento de entrada. Hoje só recebe as linhas de comentário. Somente
    leitura: as linhas nascem nos services que fazem a alteração.

    `$$ownRequest` é obrigatório - sem ele o binding vira $expand no GET do documento, e
    PurchaseInvoicesGetService não inclui ChangeLogs: a tabela viria vazia.

    O `sorter` também é obrigatório, por menos óbvio: o OrderByDescending do get service SÓ vale
    na consulta sem paginação. A sap.ui.table pede $skip/$top, e aí o [EnableQuery] reordena por
    chave para estabilizar a paginação - a lista sairia na ordem de inserção.
  -->
  <t:Table
    id="purchaseInvoiceChangeLogsTable"
    class="sapUiSizeCondensed"
    alternateRowColors="true"
    enableBusyIndicator="true"
    enableSelectAll="false"
    selectionMode="None"
    busyIndicatorDelay="0"
    rows="{
      path: 'ChangeLogs',
      parameters: { '$$ownRequest': true },
      sorter: { path: 'ChangedAt', descending: true }
    }"
    noData="Nenhuma alteração registrada neste documento."
    >
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Log de Alterações" />
          <ToolbarSpacer />
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <t:Column label="Data/Hora" width="10rem">
        <t:template>
          <Text wrapping="false" text="{
            path: 'ChangedAt',
            targetType: 'any',
            formatter: '.formatter.formatDateTime'
          }" />
        </t:template>
      </t:Column>
      <t:Column label="Usuário" width="8rem">
        <t:template>
          <Text wrapping="false" text="{ChangedBy}" />
        </t:template>
      </t:Column>
      <t:Column label="Campo" width="10rem">
        <t:template>
          <Text wrapping="false" text="{
            path: 'Field',
            formatter: '.formatter.formatContractChangeLogField'
          }" />
        </t:template>
      </t:Column>
      <t:Column label="De">
        <t:template>
          <Text text="{OldValue}" tooltip="{OldValue}" wrapping="false" />
        </t:template>
      </t:Column>
      <t:Column label="Para">
        <t:template>
          <Text text="{NewValue}" tooltip="{NewValue}" wrapping="false" />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
