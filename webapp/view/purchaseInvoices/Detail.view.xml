<mvc:View
	controllerName="siagrob1.controller.purchaseInvoices.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:uxap="sap.uxap"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

  <uxap:ObjectPageLayout
    showFooter="true"
    toggleHeaderOnTitleClick="true"
    preserveHeaderStateOnScroll="false"
    busy="{ui>/busy}"
    busyIndicatorDelay="0"
  >
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:expandedHeading>
          <Title text="{= ${IsNfeReturn} === true ? 'Devolução de Compra ' + (${TaxDocumentNumber} || '') : 'Documento de Entrada ' + (${TaxDocumentNumber} || '') }"/>
        </uxap:expandedHeading>
        <uxap:snappedHeading>
          <Title text="{= ${IsNfeReturn} === true ? 'Devolução de Compra ' + (${TaxDocumentNumber} || '') : 'Documento de Entrada ' + (${TaxDocumentNumber} || '') }"/>
        </uxap:snappedHeading>
        <uxap:actions>
          <ObjectStatus
            text="{
              path: 'InvoiceStatus',
              targetType: 'any',
              formatter: 'formatter.formatPurchaseInvoiceStatus'
            }"
            state="{
              path: 'InvoiceStatus',
              targetType: 'any',
              formatter: 'formatter.statePurchaseInvoiceStatus'
            }" />
        </uxap:actions>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <uxap:sections>
      <uxap:ObjectPageSection titleUppercase="false" title="Dados do Documento">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.purchaseInvoices.fragments.Form" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="NF-e" visible="{= ${ui>/nfeMode} === true || (${path: 'NfeStatus', targetType: 'any'} !== undefined &amp;&amp; ${path: 'NfeStatus', targetType: 'any'} !== null &amp;&amp; ${path: 'NfeStatus', targetType: 'any'} !== 'None') }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.salesInvoices.fragments.NfePanel" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Itens">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.purchaseInvoices.fragments.Items" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Totais">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.fragments.InvoiceChargeTotals" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Tributos" visible="{= ${ui>/taxTotals/visible} === true }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.fragments.InvoiceTaxTotals" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Comentários">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.purchaseInvoices.fragments.PurchaseInvoiceComments" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Log de Alterações">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.purchaseInvoices.fragments.PurchaseInvoiceChangeLogs" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>
    <uxap:footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <!-- Duas coisas obrigatórias aqui, e as duas só quebram no navegador:
             1. `targetType: 'any'` — InvoiceStatus é ENUM, e sem isso o UI5 tenta formatar com
                sap.ui.model.odata.type.Raw e estoura FormatException;
             2. expression binding explícito — `visible` com binding indefinido avalia como TRUE,
                e o botão apareceria antes de o documento carregar. -->
        <Button text="Emitir NF-e" type="Emphasized" icon="sap-icon://paper-plane" visible="{ui>/canIssueNfe}" press=".onIssueNfe" />
        <Button text="Consultar situação" icon="sap-icon://synchronize"
                visible="{= ${path: 'NfeStatus', targetType: 'any'} === 'Processing' }"
                press=".onConsultNfe" />
        <Button text="Concluir confirmação"
                visible="{= ${path: 'NfeStatus', targetType: 'any'} === 'Authorized' &amp;&amp; ${path: 'InvoiceStatus', targetType: 'any'} === 'Pending' }"
                press=".onCompleteNfeConfirmation" />
        <Button text="DANFE" icon="sap-icon://pdf-attachment"
                visible="{= ${path: 'NfeStatus', targetType: 'any'} === 'Authorized' }" press=".onDanfe" />
        <Button text="XML" icon="sap-icon://download"
                visible="{= ${path: 'NfeStatus', targetType: 'any'} === 'Authorized' }" press=".onNfeXml" />
        <Button text="Devolver" icon="sap-icon://undo" visible="{ui>/canReturn}" press=".onNfeReturn" />
        <Button
          text="Editar"
          icon="sap-icon://edit"
          visible="{= ${path: 'InvoiceStatus', targetType: 'any'} === 'Pending' &amp;&amp; ${path: 'NfeStatus', targetType: 'any'} !== 'Processing' }"
          press=".onEdit" />
        <Button
          text="Confirmar"
          type="Emphasized"
          visible="{= ${path: 'InvoiceStatus', targetType: 'any'} === 'Pending' &amp;&amp; ${ui>/nfeMode} !== true &amp;&amp; (${path: 'NfeStatus', targetType: 'any'} === undefined || ${path: 'NfeStatus', targetType: 'any'} === null || ${path: 'NfeStatus', targetType: 'any'} === 'None') }"
          press=".onConfirm" />
        <Button
          text="Estornar"
          visible="{= ${path: 'InvoiceStatus', targetType: 'any'} === 'Confirmed' }"
          press=".onReverseConfirm" />
        <Button
          text="Cancelar Documento"
          icon="sap-icon://decline"
          visible="{= ${path: 'InvoiceStatus', targetType: 'any'} !== 'Cancelled' }"
          press=".onCancelInvoice" />
        <Button text="Voltar" press=".onBack" />
      </OverflowToolbar>
    </uxap:footer>
  </uxap:ObjectPageLayout>

</mvc:View>
