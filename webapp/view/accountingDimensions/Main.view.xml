<mvc:View
	controllerName="siagrob1.controller.accountingDimensions.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<Page title="Dimensões Gerenciais" busy="{ui>/busy}">
		<content>
			<Table
				id="dimensionsTable"
				class="sapUiSizeCondensed"
				items="{
					path: '/AccountingDimensions',
					parameters: { $orderby: 'Number' }
				}">
				<columns>
					<Column width="6rem"><Text text="Número" /></Column>
					<Column><Text text="Nome" /></Column>
					<Column width="8rem"><Text text="Ativa" /></Column>
					<Column width="14rem"><Text text="Papel" /></Column>
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{Number}" />
							<Input value="{Name}" maxLength="50" required="true" />
							<Switch state="{Active}" enabled="{= ${Number} !== 1}" />
							<Select selectedKey="{Role}" width="100%">
								<core:Item key="None" text="Nenhum" />
								<core:Item key="Vehicle" text="Veículo" />
								<core:Item key="Partner" text="Parceiro" />
							</Select>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="Cancelar alterações" press=".onCancel" />
				<Button text="Salvar" type="Emphasized" press=".onSave" />
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
