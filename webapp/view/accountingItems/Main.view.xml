<mvc:View
	controllerName="siagrob1.controller.accountingItems.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Itens Contábeis">
		<content>
      <t:Table
				id="accountingItemsTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/AccountingItems'
				}"
			>
				<t:extension>
					<OverflowToolbar >
            <ToolbarSpacer />
						<SearchField placeholder="Pesquisar..." width="30%" search=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column
						label="Código"
						sortProperty="Code"
						filterProperty="Code"
            visible="true"
            width="10rem"
						>
						<t:template>
							<Text text="{Code}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Nome"
						sortProperty="Name"
						filterProperty="Name"
						>
						<t:template>
							<Text text="{Name}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Classe"
						sortProperty="Class"
						width="9rem"
						>
						<t:template>
							<Text text="{
								path: 'Class',
								targetType: 'any',
								formatter: '.formatClass'
							}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Superior"
						sortProperty="ParentCode"
						filterProperty="ParentCode"
						width="10rem"
						>
						<t:template>
							<Text text="{ParentCode}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Vigência de"
						sortProperty="ValidFrom"
						width="9rem"
						>
						<t:template>
							<Text text="{path: 'ValidFrom', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: {precision: 7}, formatOptions: {pattern: 'dd/MM/yyyy'}}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Vigência até"
						sortProperty="ValidTo"
						width="9rem"
						>
						<t:template>
							<Text text="{path: 'ValidTo', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: {precision: 7}, formatOptions: {pattern: 'dd/MM/yyyy'}}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Inativo"
						sortProperty="Inactive"
						filterProperty="Inactive"
						width="8rem"
						>
						<t:template>
							<Text text="{
								path: 'Inactive',
								targetType: 'any',
								formatter: 'formatter.formatBooleanYesNo'
							}" />
						</t:template>
					</t:Column>
				</t:columns>

			</t:Table>
		</content>
    <footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit"/>
				<Button text="Deletar" icon="sap-icon://delete" press=".onDelete"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
