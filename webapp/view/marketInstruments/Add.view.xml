<mvc:View
	controllerName="siagrob1.controller.marketInstruments.Add"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<Page title="{i18n>marketInstrumentTitle}" busy="{ui>/busy}" busyIndicatorDelay="0">
		<content>
			<core:Fragment fragmentName="siagrob1.view.marketInstruments.fragments.Form" type="XML" />
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="{i18n>commonCancel}" press=".onCancel" />
				<Button text="{i18n>commonSave}" type="Emphasized" press=".onSave" visible="{form>/canManage}" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
