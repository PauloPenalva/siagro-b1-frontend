<mvc:View
	controllerName="siagrob1.controller.offlinePosting.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:form="sap.ui.layout.form"
	xmlns:t="sap.ui.table">

	<Page title="Contabilização Off-line" showNavButton="true" navButtonPress=".onNavBack" busyIndicatorDelay="0">
		<content>
			<MessageStrip
				text="Contabiliza os documentos do período que ainda não têm lançamento, pelo lançamento padrão ativo. Simular mostra o resultado sem gravar. Documentos anteriores à data de corte não entram."
				type="Information" showIcon="true" class="sapUiSmallMargin" />
			<form:Form editable="true">
				<form:layout>
					<form:ColumnLayout columnsM="2" columnsL="2" columnsXL="2" />
				</form:layout>
				<form:formContainers>
					<form:FormContainer>
						<form:formElements>
							<form:FormElement label="De">
								<form:fields>
									<DatePicker value="{params>/DateFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" required="true" />
								</form:fields>
							</form:FormElement>
							<form:FormElement label="Até">
								<form:fields>
									<DatePicker value="{params>/DateTo}" valueFormat="yyyy-MM-dd" displayFormat="dd/MM/yyyy" required="true" />
								</form:fields>
							</form:FormElement>
							<form:FormElement label="Filial">
								<form:fields>
									<Input value="{params>/BranchCode}" placeholder="Todas" showValueHelp="true" valueHelpOnly="true"
										showClearIcon="true" valueHelpRequest=".openBranchsValueHelp" />
								</form:fields>
							</form:FormElement>
						</form:formElements>
					</form:FormContainer>
					<form:FormContainer>
						<form:formElements>
							<form:FormElement label="Módulos">
								<form:fields>
									<CheckBox text="Entradas" selected="{params>/PurchaseInvoices}" />
									<CheckBox text="Saídas" selected="{params>/SalesInvoices}" />
									<CheckBox text="Financeiro" selected="{params>/Financial}" />
								</form:fields>
							</form:FormElement>
						</form:formElements>
					</form:FormContainer>
				</form:formContainers>
			</form:Form>

			<t:Table
				id="offlinePostingRunsTable"
				title="Execuções"
				selectionMode="Single"
				selectionBehavior="RowOnly"
				rowSelectionChange=".onRunSelected"
				class="sapUiSizeCondensed sapUiSmallMarginTop"
				visibleRowCount="5"
				rows="{op>/Runs}">
				<t:columns>
					<t:Column label="Pedido em" width="10rem">
						<t:template><Text text="{op>RequestedAtText}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Usuário" width="8rem">
						<t:template><Text text="{op>RequestedBy}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Período" width="12rem">
						<t:template><Text text="{path: 'op>DateFrom', type: 'sap.ui.model.odata.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}} a {path: 'op>DateTo', type: 'sap.ui.model.odata.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Filial" width="6rem">
						<t:template><Text text="{op>BranchText}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Módulos" width="12rem">
						<t:template><Text text="{op>ModulesText}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Tipo" width="9rem">
						<t:template><Text text="{op>KindText}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Situação" width="9rem">
						<t:template>
							<ObjectStatus text="{op>StatusText}"
								state="{= ${op>Status} === 'Completed' ? 'Success' : ${op>Status} === 'Failed' ? 'Error' : 'Information' }" />
						</t:template>
					</t:Column>
					<t:Column label="Contabilizados" width="8rem" hAlign="End">
						<t:template><Text text="{op>PostedCount}" /></t:template>
					</t:Column>
					<t:Column label="Erros" width="5rem" hAlign="End">
						<t:template><Text text="{op>ErrorCount}" /></t:template>
					</t:Column>
					<t:Column label="Ignorados" width="6rem" hAlign="End">
						<t:template><Text text="{op>SkippedCount}" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>

			<MessageStrip text="{op>/Current/FailureMessage}" type="Error" showIcon="true" class="sapUiSmallMargin"
				visible="{= !!${op>/Current/FailureMessage} }" />

			<t:Table
				id="offlinePostingItemsTable"
				title="Documentos da execução selecionada"
				selectionMode="None"
				class="sapUiSizeCondensed sapUiSmallMarginTop"
				visibleRowCountMode="Auto"
				minAutoRowCount="5"
				alternateRowColors="true"
				rows="{op>/Items}">
				<t:columns>
					<t:Column label="Seq." width="4rem" hAlign="End">
						<t:template><Text text="{op>Sequence}" /></t:template>
					</t:Column>
					<t:Column label="Data" width="7rem">
						<t:template><Text text="{path: 'op>EventDate', type: 'sap.ui.model.odata.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Tipo" width="11rem">
						<t:template><Text text="{op>DocumentTypeText}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Documento" width="10rem">
						<t:template><Text text="{op>DocumentNumber}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Filial" width="5rem">
						<t:template><Text text="{op>BranchCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Códigos" width="7rem">
						<t:template><Text text="{op>Codes}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Resultado" width="9rem">
						<t:template>
							<ObjectStatus text="{op>ResultText}"
								state="{= ${op>Result} === 'Posted' ? 'Success' : ${op>Result} === 'WouldPost' ? 'Information' : ${op>Result} === 'Error' ? 'Error' : 'None' }" />
						</t:template>
					</t:Column>
					<t:Column label="Mensagem">
						<t:template><Text text="{op>Message}" wrapping="false" tooltip="{op>Message}" /></t:template>
					</t:Column>
					<t:Column label="Lançamentos" width="8rem">
						<t:template><Text text="{op>JournalEntryDocEntries}" wrapping="false" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Excel" icon="sap-icon://excel-attachment" press=".onExportExcel" />
				<Button text="Simular" icon="sap-icon://simulate" press=".onSimulate" enabled="{= !${op>/Busy} }" />
				<Button text="Processar" type="Emphasized" icon="sap-icon://accept" press=".onProcess" enabled="{= !${op>/Busy} }" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
