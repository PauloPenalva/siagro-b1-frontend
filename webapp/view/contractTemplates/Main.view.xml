<mvc:View
	controllerName="siagrob1.controller.contractTemplates.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:rowmodes="sap.ui.table.rowmodes"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Modelos de Contrato">
		<content>
			<t:Table
				id="tableContractTemplates"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/ContractTemplates',
					sorter: { path: 'Name' }
				}"
			>
				<t:rowMode>
					<rowmodes:Auto />
				</t:rowMode>
				<t:extension>
					<OverflowToolbar>
						<Label text="Aplica-se a" labelFor="filterScope"/>
						<Select
							id="filterScope"
							forceSelection="false"
							selectedKey="{options>/filter/scope}"
							change=".onFilterChange"
							items="{options>/scopes}">
							<core:ListItem key="{options>key}" text="{options>text}"/>
						</Select>
						<Label text="Situação" labelFor="filterActive"/>
						<Select
							id="filterActive"
							forceSelection="false"
							selectedKey="{options>/filter/active}"
							change=".onFilterChange">
							<core:ListItem key="" text="Todas"/>
							<core:ListItem key="Y" text="Ativos"/>
							<core:ListItem key="N" text="Inativos"/>
						</Select>
						<ToolbarSpacer />
						<SearchField
							placeholder="Pesquisar..."
							width="25%"
							value="{options>/filter/query}"
							search=".onFilterChange"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="Nome" sortProperty="Name" filterProperty="Name">
						<t:template>
							<Text text="{Name}" />
						</t:template>
					</t:Column>
					<t:Column label="Título" sortProperty="Title" filterProperty="Title">
						<t:template>
							<Text text="{Title}" />
						</t:template>
					</t:Column>
					<t:Column label="Aplica-se a" sortProperty="ContractType" width="12rem">
						<t:template>
							<Text text="{path: 'ContractType', targetType: 'any', formatter: '.formatter.templateScopeText'}" />
						</t:template>
					</t:Column>
					<t:Column label="Ativo" width="7rem">
						<t:template>
							<ObjectStatus
								text="{path: 'Active', targetType: 'any', formatter: '.formatter.formatActive'}"
								state="{path: 'Active', targetType: 'any', formatter: '.formatter.stateActive'}" />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit"/>
				<Button text="Excluir" icon="sap-icon://delete" press=".onDelete"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
