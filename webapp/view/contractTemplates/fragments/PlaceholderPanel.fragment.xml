<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
  <!--
    A raiz do JSONModel "placeholders" É o array (a function do backend responde array cru, sem
    envelope OData), então a lista se liga a `placeholders>/` e os campos a `placeholders>Name`.
  -->
  <List
    id="contractTemplatePlaceholders"
    items="{placeholders>/}"
    mode="None"
    growing="false"
    noDataText="Escolha o tipo de contrato para ver os campos disponíveis."
    class="sapUiSizeCompact">
    <headerToolbar>
      <OverflowToolbar>
        <Title text="Campos disponíveis" level="H3"/>
        <ToolbarSpacer />
      </OverflowToolbar>
    </headerToolbar>
    <StandardListItem
      title="{placeholders>Name}"
      description="{placeholders>Description}"
      icon="sap-icon://insert-text"
      iconInset="false"
      type="Active"
      tooltip="Inserir no texto, na posição do cursor"
      press=".onInsertPlaceholder"/>
  </List>
</core:FragmentDefinition>
