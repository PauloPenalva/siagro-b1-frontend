<mvc:View
	controllerName="siagrob1.controller.contractTemplates.Edit"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<Page title="Editar Modelo de Contrato" busy="{ui>/busy}">
		<content>
			<core:Fragment fragmentName="siagrob1.view.contractTemplates.fragments.Editor" type="XML" />
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="Cancelar" press=".onCancel" />
				<Button text="Salvar" type="Emphasized" press=".onSave"/>
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
