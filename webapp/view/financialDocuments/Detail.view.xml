<mvc:View
	controllerName="siagrob1.controller.financialDocuments.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:uxap="sap.uxap"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

  <uxap:ObjectPageLayout
    showFooter="true"
    toggleHeaderOnTitleClick="true"
    preserveHeaderStateOnScroll="false"
    busy="{ui>/busy}"
    busyIndicatorDelay="0"
  >
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>
        <uxap:expandedHeading>
          <Title text="Título {Code}"/>
        </uxap:expandedHeading>
        <uxap:snappedHeading>
          <Title text="Título {Code}"/>
        </uxap:snappedHeading>
        <uxap:actions>
          <ObjectStatus
            inverted="true"
            text="{ path: 'Status', targetType: 'any', formatter: 'formatter.formatFinancialStatus' }"
            state="{ path: 'Status', targetType: 'any', formatter: 'formatter.stateFinancialStatus' }" />
        </uxap:actions>
      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <uxap:sections>
      <uxap:ObjectPageSection titleUppercase="false" title="Dados do Título">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.financialDocuments.fragments.Form" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Composição"
        visible="{= ${path: 'Nature', targetType: 'any'} === 'Provisional' }">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.financialDocuments.fragments.Composition" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Baixas">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.financialDocuments.fragments.Settlements" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
      <uxap:ObjectPageSection titleUppercase="false" title="Log de Alterações">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title=" " titleUppercase="false">
            <core:Fragment fragmentName="siagrob1.view.financialDocuments.fragments.ChangeLogs" type="XML" />
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>

    <uxap:footer>
      <OverflowToolbar>
        <ToolbarSpacer />
        <Button
          text="Editar"
          icon="sap-icon://edit"
          type="Emphasized"
          visible="{
            parts: [
              { path: 'Status', targetType: 'any' },
              { path: 'Nature', targetType: 'any' },
              { path: 'OriginType', targetType: 'any' }
            ],
            formatter: '.formatter.formatManualFinancialTitleEditable'
          }"
          press=".onEditManual" />
        <Button
          text="Excluir"
          icon="sap-icon://delete"
          visible="{= ${path: 'Nature', targetType: 'any'} === 'Firm'
                    &amp;&amp; ${path: 'OriginType', targetType: 'any'} === 'Manual'
                    &amp;&amp; !(Number(${path: 'SettledAmount', targetType: 'any'}) !== 0) }"
          press=".onDeleteManual" />
        <Button
          text="Corrigir vencimento"
          icon="sap-icon://appointment-2"
          visible="{= ${path: 'Status', targetType: 'any'} !== 'Canceled' }"
          press=".onSetDueDate" />
        <Button
          text="Devolver adiantamento"
          icon="sap-icon://undo"
          visible="{= ${path: 'Nature', targetType: 'any'} === 'Advance'
                    &amp;&amp; ${path: 'Status', targetType: 'any'} !== 'Canceled'
                    &amp;&amp; ${path: 'AvailableAdvanceAmount', targetType: 'any'} > 0 }"
          press=".onRefundAdvance" />
        <Button
          text="{= !${path: 'PurchaseContractKey', targetType: 'any'} &amp;&amp; !${path: 'SalesContractKey', targetType: 'any'} ? 'Vincular a contrato' : 'Vincular a outro contrato' }"
          icon="sap-icon://chain-link"
          visible="{= ${path: 'Nature', targetType: 'any'} === 'Advance'
                    &amp;&amp; ${path: 'Status', targetType: 'any'} !== 'Canceled'
                    &amp;&amp; !(Number(${path: 'AppliedAmount', targetType: 'any'}) > 0
                              &amp;&amp; Number(${path: 'AvailableAdvanceAmount', targetType: 'any'}) &lt;= 0) }"
          press=".onRelinkContract" />
        <Button
          text="Cancelar título"
          icon="sap-icon://decline"
          visible="{
            parts: [
              { path: 'Status', targetType: 'any' },
              { path: 'SettledAmount', targetType: 'any' },
              { path: 'Nature', targetType: 'any' },
              { path: 'OriginType', targetType: 'any' },
              { path: 'ComposedAmount', targetType: 'any' }
            ],
            formatter: '.formatter.formatFinancialDocumentCancelable'
          }"
          press=".onCancelDocument" />
        <Button text="Voltar" press=".onBack" />
      </OverflowToolbar>
    </uxap:footer>
  </uxap:ObjectPageLayout>

</mvc:View>
