<mvc:View
	controllerName="siagrob1.controller.fiscalStockAdjustments.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">

	<Page title="Ajuste de Estoque" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<MessageStrip
				text="Ajuste manual de entrada ou saída no Registro Kardex (PEPS), por filial e produto. A saída não pode passar da quantidade nem do valor em estoque na data. O motivo é obrigatório e não é possível lançar em mês fechado."
				type="Information"
				showIcon="true"
				class="sapUiSmallMargin" />
			<t:Table
				id="adjustmentsTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/FiscalStockAdjustments',
					sorter: [ { path: 'AdjustmentDate', descending: true }, { path: 'DocNumber', descending: true } ]
				}">
				<t:columns>
					<t:Column label="Nº" width="7rem">
						<t:template><Text text="{DocNumber}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Filial" width="6rem">
						<t:template><Text text="{BranchCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Data" width="7rem" hAlign="Center">
						<t:template><Text text="{ path: 'AdjustmentDate', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { precision: 7 }, formatOptions: { pattern: 'dd/MM/yyyy' } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Tipo" width="6rem">
						<t:template><Text text="{ path: 'Direction', formatter: '.directionText' }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Produto" width="8rem">
						<t:template><Text text="{ItemCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Descrição" width="16rem">
						<t:template><Text text="{ItemName}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="UM" width="4rem">
						<t:template><Text text="{UnitOfMeasureCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Quantidade" width="8rem" hAlign="End">
						<t:template><Text text="{ path: 'Quantity', type: 'sap.ui.model.odata.type.Decimal', constraints: { precision: 19, scale: 3 }, formatOptions: { decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.', minFractionDigits: 3, maxFractionDigits: 3 } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Valor total" width="8rem" hAlign="End">
						<t:template><Text text="{ path: 'TotalValue', type: 'sap.ui.model.odata.type.Decimal', constraints: { precision: 19, scale: 2 }, formatOptions: { decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.', minFractionDigits: 2, maxFractionDigits: 2 } }" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="Motivo" width="18rem">
						<t:template><Text text="{Reason}" wrapping="false" tooltip="{Reason}" /></t:template>
					</t:Column>
					<t:Column label="Incluído por" width="8rem">
						<t:template><Text text="{CreatedBy}" wrapping="false" /></t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate" />
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit" />
				<Button text="Excluir" icon="sap-icon://delete" press=".onDelete" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
