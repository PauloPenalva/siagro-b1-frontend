<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<Dialog id="fxSettleDialog" title="{i18n>marketFxSettleTitle}" contentWidth="30rem">
		<content>
			<MessageStrip text="{settle>/summary}" type="Information" showIcon="true" class="sapUiTinyMargin" />
			<f:Form editable="true">
				<f:layout>
					<f:ColumnLayout columnsM="1" columnsL="1" columnsXL="1" />
				</f:layout>
				<f:formContainers>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="{i18n>marketColSettlementRate}">
								<Input id="settleRate" value="{settle>/rate}" required="true" textAlign="End" liveChange=".onSettleRateLiveChange"
									valueState="{settle>/rateState}" valueStateText="{settle>/rateStateText}" description="{settle>/sourceText}" />
							</f:FormElement>
							<f:FormElement label="{i18n>marketColResultBrl}">
								<ObjectStatus text="{settle>/resultText}" state="{settle>/resultState}" />
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>
		</content>
		<beginButton>
			<Button text="{i18n>marketFxSettle}" type="Emphasized" press=".onSettleConfirm" enabled="{= !${ui>/isBusy} }" />
		</beginButton>
		<endButton>
			<Button text="{i18n>commonCancel}" press=".onSettleCancel" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
