<mvc:View
	controllerName="siagrob1.controller.marketPriceTables.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:rowmodes="sap.ui.table.rowmodes">

	<Page title="{i18n>marketPriceTablesTitle}" busy="{ui>/busy}" busyIndicatorDelay="0">
		<content>
			<t:Table
				id="tableMarketPriceTables"
				core:require="{ DateTimeOffset: 'sap/ui/model/odata/type/DateTimeOffset' }"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{ path: '/MarketPriceTables', sorter: [{ path: 'Description' }] }">
				<t:rowMode>
					<rowmodes:Auto />
				</t:rowMode>
				<t:extension>
					<OverflowToolbar>
						<ToolbarSpacer />
						<SearchField placeholder="{i18n>commonSearch}" width="30%" search=".onSearch" />
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="{i18n>marketFieldDescription}" sortProperty="Description">
						<t:template><Text text="{Description}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="{i18n>marketColItem}" sortProperty="ItemName" width="18rem">
						<t:template><Text text="{ItemName}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="{i18n>marketColHarvestSeason}" sortProperty="HarvestSeasonCode" width="9rem">
						<t:template><Text text="{HarvestSeasonCode}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="{i18n>marketFieldActive}" width="6rem" hAlign="Center">
						<t:template><CheckBox selected="{Active}" editable="false" /></t:template>
					</t:Column>
					<t:Column label="{i18n>marketColUpdatedBy}" sortProperty="UpdatedBy" width="12rem">
						<t:template><Text text="{UpdatedBy}" wrapping="false" /></t:template>
					</t:Column>
					<t:Column label="{i18n>marketColUpdatedAt}" sortProperty="UpdatedAt" width="11rem">
						<t:template>
							<Text text="{ path: 'UpdatedAt', type: 'DateTimeOffset', formatOptions: { pattern: 'dd/MM/yyyy HH:mm' } }" wrapping="false" />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="{i18n>commonRefresh}" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="{i18n>commonAdd}" icon="sap-icon://add" type="Emphasized" press=".onCreate" visible="{view>/canManage}" />
				<Button text="{i18n>commonEdit}" icon="sap-icon://edit" press=".onEdit" />
				<Button text="{i18n>commonDelete}" icon="sap-icon://delete" press=".onDelete" visible="{view>/canManage}" />
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
