<mvc:View
	controllerName="siagrob1.controller.marketPriceTables.Add"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<Page title="{i18n>marketPriceTableTitle}" busy="{ui>/busy}" busyIndicatorDelay="0">
		<content>
			<core:Fragment fragmentName="siagrob1.view.marketPriceTables.fragments.PriceTableForm" type="XML" />
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="{i18n>commonCancel}" press=".onCancel" />
				<Button text="{i18n>commonSave}" type="Emphasized" press=".onSave" visible="{view>/canManage}" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
