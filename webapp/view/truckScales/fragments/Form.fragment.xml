<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
    core:require="{ IntegerType: 'sap/ui/model/type/Integer' }"
>
    <f:SimpleForm
      id="formTruckScales"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Dados da Balança"
              emphasized="true"
          />
          <Label text="Codigo" />
          <Input
              value="{Code}"
              required="true"
              maxLength="11"
          />
          <Label text="Nome" />
          <Input
              value="{Name}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Localização" />
          <Input
              value="{Localization}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />

          <core:Title text="Conexão" emphasized="true" />
          <Label text="Tipo de conexão" />
          <Select
            selectedKey="{
              path: 'ConnectionType',
              targetType: 'any'
            }"
            forceSelection="false">
            <core:ListItem key="Tcp" text="TCP/IP" />
            <core:ListItem key="Serial" text="Serial" />
          </Select>
          <Label text="Endereço IP" visible="{= ${path: 'ConnectionType', targetType: 'any'} !== 'Serial' }" />
          <Input value="{IpAddress}" editable="true" maxLength="50" visible="{= ${path: 'ConnectionType', targetType: 'any'} !== 'Serial' }" />
          <Label text="Porta" visible="{= ${path: 'ConnectionType', targetType: 'any'} !== 'Serial' }" />
          <Input
            value="{
              path: 'Port',
              type: 'IntegerType'
            }"
            editable="true"
            visible="{= ${path: 'ConnectionType', targetType: 'any'} !== 'Serial' }" />
          <Label text="Porta serial" visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Input
            value="{SerialPortName}"
            maxLength="50"
            placeholder="COM3"
            visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Label text="Baud rate" visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Input
            value="{ path: 'BaudRate', type: 'IntegerType' }"
            placeholder="9600"
            visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Label text="Bits de dados" visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Input
            value="{ path: 'DataBits', type: 'IntegerType' }"
            placeholder="8"
            visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Label text="Paridade" visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Select
            selectedKey="{
              path: 'Parity',
              targetType: 'any'
            }"
            forceSelection="false"
            visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }">
            <core:ListItem key="None" text="Nenhuma" />
            <core:ListItem key="Odd" text="Ímpar" />
            <core:ListItem key="Even" text="Par" />
          </Select>
          <Label text="Bits de parada" visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Input
            value="{ path: 'StopBits', type: 'IntegerType' }"
            placeholder="1"
            visible="{= ${path: 'ConnectionType', targetType: 'any'} === 'Serial' }" />
          <Label text="Protocolo" />
          <Select
            selectedKey="{
              path: 'Protocol',
              targetType: 'any'
            }"
            forceSelection="false">
            <core:ListItem key="JundiaiBj850" text="Jundiaí BJ850" />
            <core:ListItem key="Generic" text="Genérico (expressão regular)" />
          </Select>

          <core:Title text="Validação da Tara" emphasized="true" />
          <Label text="Validar tara" />
          <CheckBox
            selected="{
              path: 'ValidateTare',
              targetType: 'any'
            }" />
          <Label text="Tolerância (kg)" />
          <Input
            value="{
              path: 'TareToleranceKg',
              type: 'IntegerType'
            }"
            editable="true" />

          <core:Title text="Avançado (parsing do frame)" emphasized="true" />
          <Label text="Caracteres antes do peso" />
          <Input value="{ path: 'FramePrefixLength', type: 'IntegerType' }" />
          <Label text="Dígitos do peso" />
          <Input value="{ path: 'WeightLength', type: 'IntegerType' }" />
          <Label text="Casas decimais" />
          <Input value="{ path: 'DecimalPlaces', type: 'IntegerType' }" />
          <Label text="Expressão regular (protocolo genérico)" />
          <Input value="{FramePattern}" maxLength="200" />
          <Label text="Registrar frames no log" />
          <CheckBox selected="{ path: 'LogRawFrames', targetType: 'any' }" />
        <core:Title />
        <core:Title />
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>
