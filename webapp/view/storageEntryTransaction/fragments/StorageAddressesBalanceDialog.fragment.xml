<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <TableSelectDialog
        class=" sapUiSizeCompact"
        growing="true"
        growingThreshold="20"
        items="{lots>/}"
        rememberSelections="true"
        title="Lotes de Armazenagem Abertos"
    >
        <columns>
            <Column>
                <header>
                    <Text text="Codigo" />
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Descrição" />
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Cliente" />
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Produto" />
                </header>
            </Column>
            <Column>
                <header>
                    <Text text="Armazem" />
                </header>
            </Column>
            <Column hAlign="End">
                <header>
                    <Text text="Saldo" />
                </header>
            </Column>
        </columns>
        <ColumnListItem>
            <cells>
                <Text text="{lots>Code}" />
                <Text text="{lots>Description}" />
                <Text text="({lots>CardCode}) {lots>CardName}" />
                <Text text="({lots>ItemCode}) {lots>ItemName}" />
                <Text text="{lots>WarehouseCode}" />
                <ObjectNumber number="{lots>Balance}" unit="KG" />
            </cells>
        </ColumnListItem>
    </TableSelectDialog>
</core:FragmentDefinition>
