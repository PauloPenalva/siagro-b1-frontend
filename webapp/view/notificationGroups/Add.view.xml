<mvc:View
	controllerName="siagrob1.controller.notificationGroups.Add"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Grupo de Notificação">
		<content>
			<core:Fragment fragmentName="siagrob1.view.notificationGroups.fragments.Form" type="XML" />
			<IconTabBar id="notificationGroupTabsAdd" expanded="true" class="sapUiResponsiveContentPadding">
				<items>
					<IconTabFilter text="Membros">
						<core:Fragment fragmentName="siagrob1.view.notificationGroups.fragments.Members" type="XML" />
					</IconTabFilter>
					<IconTabFilter text="Eventos">
						<core:Fragment fragmentName="siagrob1.view.notificationGroups.fragments.Subscriptions" type="XML" />
					</IconTabFilter>
				</items>
			</IconTabBar>
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="Cancelar" press=".onCancel" />
				<Button text="Salvar" type="Emphasized" press=".onSave"/>
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
