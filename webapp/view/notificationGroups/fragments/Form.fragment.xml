<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="formNotificationGroup"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
      busyIndicatorDelay="0">
        <f:content>
          <core:Title text="Dados do Grupo" emphasized="true" />
          <Label text="Código" />
          <Input
              value="{Code}"
              required="true"
              liveChange=".validateField"
              maxLength="20"
          />
          <Label text="Nome" />
          <Input
              value="{Name}"
              required="true"
              liveChange=".validateField"
              maxLength="100"
          />
          <Label text="Ativo" />
          <CheckBox selected="{Active}" />
        </f:content>
        <core:Title />
        <core:Title />
    </f:SimpleForm>
</core:FragmentDefinition>
