<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
>
  <!-- Seções do ObjectPageLayout da natureza (inclusão, edição e detalhe usam este mesmo fragmento).
       ui>/editable: true na inclusão/edição, false no detalhe (só leitura).
       ui>/identityEditable: false em SAPB1 — a IDENTIDADE fiscal vem do OUSG e o Siagro não a escreve; o EFEITO
       no contrato é do Siagro nos dois modos e continua editável. -->

  <uxap:ObjectPageSection id="usagesGeneralSection" titleUppercase="false" title="Geral">
    <uxap:subSections>
      <uxap:ObjectPageSubSection title="Identificação" titleUppercase="false">
        <uxap:blocks>
          <VBox>
            <MessageStrip
                visible="{= !${ui>/identityEditable} }"
                text="Nome, descrição e CFOP são mantidos no SAP (OUSG). Aqui você configura apenas o efeito no contrato."
                type="Information"
                showIcon="true"
                class="sapUiSmallMarginBottom"
            />
            <!-- O id é o que validateForm/clearStates percorrem: o Nome (único obrigatório) mora aqui. -->
            <f:SimpleForm
                id="usagesForm"
                editable="true"
                layout="ColumnLayout"
                columnsM="2"
                columnsL="2"
                columnsXL="2">
              <f:content>
                <Label text="Nome" />
                <Input
                    value="{Name}"
                    editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/identityEditable} === true }"
                    required="true"
                    liveChange=".validateField"
                    maxLength="200"
                />
                <Label text="Descrição" />
                <Input
                    value="{Description}"
                    editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/identityEditable} === true }"
                    maxLength="200"
                />
                <!-- Tipo da natureza (só STANDALONE: o OUSG não tem tipo, e ali o campo vem nulo).
                     Decide quais CFOPs aparecem e se há efeito em contrato de venda. -->
                <Label text="Tipo" visible="{ui>/identityEditable}" />
                <Select
                  visible="{ui>/identityEditable}"
                  editable="{ui>/editable}"
                  selectedKey="{ path: 'Direction', targetType: 'any' }"
                  change=".onDirectionChange"
                  forceSelection="false">
                  <core:ListItem key="Outgoing" text="Saída" />
                  <core:ListItem key="Incoming" text="Entrada" />
                </Select>
                <Label text="CFOP dentro do estado"
                       visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
                <Input
                    value="{CfopOutgoingInState}"
                    editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/identityEditable} === true }"
                    maxLength="4"
                    visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
                />
                <Label text="CFOP fora do estado"
                       visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
                <Input
                    value="{CfopOutgoingOutState}"
                    editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/identityEditable} === true }"
                    maxLength="4"
                    visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
                />
                <Label text="CFOP de entrada dentro do estado"
                       visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }" />
                <Input
                    value="{CfopIncomingInState}"
                    editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/identityEditable} === true }"
                    maxLength="4"
                    visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }"
                />
                <Label text="CFOP de entrada fora do estado"
                       visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }" />
                <Input
                    value="{CfopIncomingOutState}"
                    editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/identityEditable} === true }"
                    maxLength="4"
                    visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }"
                />
                <Label text="Texto na nota (natOp)" visible="{ui>/identityEditable}" />
                <Input
                    value="{InvoiceOperationText}"
                    editable="{ui>/editable}"
                    maxLength="60"
                    placeholder="Vazio = usa o Nome"
                    visible="{ui>/identityEditable}"
                />
                <!-- Natureza de devolução, só STANDALONE: a de venda (Saída) aponta a de devolução de venda (Entrada)
                     e a de compra (Entrada) aponta a de devolução de compra (Saída). O "Devolver" herda esta
                     natureza em cada linha da devolução. -->
                <Label text="Natureza de devolução" visible="{ui>/identityEditable}" />
                <!-- ui5lint-disable no-deprecated-api -->
                <Input
                    value="{ReturnUsageCode}"
                    editable="{ui>/editable}"
                    showValueHelp="true"
                    valueHelpOnly="true"
                    showClearIcon="true"
                    valueHelpRequest=".onReturnUsageValueHelp"
                    change=".onReturnUsageChange"
                    visible="{ui>/identityEditable}">
                  <layoutData>
                    <f:ColumnElementData cellsSmall="4" cellsLarge="3" />
                  </layoutData>
                </Input>
                <!-- ui5lint-enable no-deprecated-api -->
                <Input
                    value="{ReturnUsageName}"
                    editable="false"
                    visible="{ui>/identityEditable}">
                  <layoutData>
                    <f:ColumnElementData cellsSmall="8" cellsLarge="5" />
                  </layoutData>
                </Input>
              </f:content>
            </f:SimpleForm>
          </VBox>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>

      <!-- Comportamento da natureza no documento fiscal: só STANDALONE (em SAPB1 é o SAP quem decide). -->
      <uxap:ObjectPageSubSection title="Comportamento no documento" titleUppercase="false" visible="{ui>/identityEditable}">
        <uxap:blocks>
          <f:SimpleForm
              editable="true"
              layout="ColumnLayout"
              columnsM="2"
              columnsL="2"
              columnsXL="2">
            <f:content>
              <!-- Contra-nota a partir da escrituração da NF-e do produtor (spec 2026-10-10 D4): só natureza de entrada.
                   A contra-nota usa esta mesma natureza e os mesmos tributos da escrituração. -->
              <Label text="Permite contra-nota"
                     visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }" />
              <CheckBox selected="{AllowsCounterNote}"
                        editable="{ui>/editable}"
                        visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }" />
              <!-- Remessa para depósito em armazém de terceiro (spec backend 2026-10-10 §2.1). Remessa é natureza de
                   saída e Retorno de entrada; o servidor recusa a combinação errada. -->
              <Label text="Papel no depósito" />
              <Select
                editable="{ui>/editable}"
                selectedKey="{ path: 'StorageDepositRole', targetType: 'any' }"
                forceSelection="false">
                <core:ListItem key="None" text="Nenhum" />
                <core:ListItem key="Remittance" text="Remessa para depósito" />
                <core:ListItem key="Return" text="Retorno de depósito" />
              </Select>
              <!-- Notas de custódia em armazém próprio (spec backend 2026-10-12 §3.1). Entradas são naturezas de
                   entrada; devolução e retornos, de saída — o servidor recusa a combinação errada. -->
              <Label text="Papel na custódia (armazenagem)" />
              <Select
                editable="{ui>/editable}"
                selectedKey="{ path: 'StorageCustodyRole', targetType: 'any' }"
                forceSelection="false">
                <core:ListItem key="None" text="Nenhum" />
                <core:ListItem key="ProcessingEntry" text="Entrada para beneficiamento" />
                <core:ListItem key="ProcessingSymbolicReturn" text="Devolução simbólica do beneficiamento" />
                <core:ListItem key="StorageEntry" text="Entrada para armazenagem" />
                <core:ListItem key="StorageReturn" text="Retorno de armazenagem" />
                <core:ListItem key="StorageSymbolicReturn" text="Retorno simbólico de armazenagem" />
              </Select>
              <!-- Flags da natureza (equivalem a "Atualiza Estoque" e "Gera Duplicata" da TES do Protheus). -->
              <Label text="Movimenta estoque ?" />
              <CheckBox selected="{MovesFiscalInventory}" editable="{ui>/editable}" />
              <Label text="Gera financeiro ?" />
              <CheckBox selected="{CreatesFinancialDocument}" editable="{ui>/editable}" />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>
    </uxap:subSections>
  </uxap:ObjectPageSection>

  <!-- Efeito em contrato de VENDA: não se aplica à natureza de entrada (o efeito em contrato de compra vem com a
       NF-e de entrada). -->
  <uxap:ObjectPageSection titleUppercase="false" title="Efeito no Contrato">
    <uxap:subSections>
      <uxap:ObjectPageSubSection title="Efeito no Contrato" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm
              editable="true"
              layout="ColumnLayout"
              columnsM="2"
              columnsL="2"
              columnsXL="2">
            <f:content>
              <Label text="Efeito" visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }" />
              <Text
                  text="Não se aplica à natureza de entrada."
                  visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }"
              />
              <Label text="Saldo do contrato"
                     visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
              <Select
                visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
                editable="{ui>/editable}"
                selectedKey="{ path: 'ContractBalanceEffect', targetType: 'any' }"
                forceSelection="false">
                <core:ListItem key="None" text="Não altera" />
                <core:ListItem key="Consume" text="Consome saldo" />
                <core:ListItem key="Restore" text="Devolve saldo" />
              </Select>
              <Label text="Valor do contrato"
                     visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
              <Select
                visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
                editable="{ui>/editable}"
                selectedKey="{ path: 'ContractValueEffect', targetType: 'any' }"
                forceSelection="false">
                <core:ListItem key="None" text="Não altera" />
                <core:ListItem key="Add" text="Soma ao apurado" />
                <core:ListItem key="Subtract" text="Subtrai do apurado" />
              </Select>
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>
    </uxap:subSections>
  </uxap:ObjectPageSection>

  <uxap:ObjectPageSection titleUppercase="false" title="Obrigatoriedades">
    <uxap:subSections>
      <uxap:ObjectPageSubSection title="Obrigatoriedades" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm
              editable="true"
              layout="ColumnLayout"
              columnsM="2"
              columnsL="2"
              columnsXL="2">
            <f:content>
              <!-- Na entrada, "Exige contrato" decide se o item de uma compra comum (não grão) deve citar contrato;
                   vale para os dois tipos de natureza. -->
              <Label text="Exige contrato ?" />
              <CheckBox selected="{RequiresContract}" editable="{ui>/editable}" />
              <Label text="Exige quantidade ?"
                     visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
              <CheckBox
                selected="{RequiresQuantity}"
                editable="{ui>/editable}"
                visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
              />
              <Label text="Exige peso ?"
                     visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
              <CheckBox
                selected="{RequiresWeight}"
                editable="{ui>/editable}"
                visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
              />
              <Label text="Padrão do faturamento de romaneio ?"
                     visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
              <CheckBox
                selected="{IsDefault}"
                editable="{ui>/editable}"
                visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
              />
              <Label text="Inativo ?" />
              <CheckBox
                selected="{Inactive}"
                editable="{= ${ui>/editable} === true &amp;&amp; ${ui>/identityEditable} === true }"
              />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>
    </uxap:subSections>
  </uxap:ObjectPageSection>

  <!-- Compra: só natureza de ENTRADA em STANDALONE. -->
  <uxap:ObjectPageSection titleUppercase="false" title="Compra"
      visible="{= ${ui>/identityEditable} === true &amp;&amp; ${path: 'Direction', targetType: 'any'} === 'Incoming' }">
    <uxap:subSections>
      <!-- Destinação da compra (spec 2026-10-17, Efeito dos tributos e DIFAL): decide crédito de ICMS/PIS/COFINS e
           o DIFAL. -->
      <uxap:ObjectPageSubSection title="Destinação da compra" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm
              editable="true"
              layout="ColumnLayout"
              columnsM="2"
              columnsL="2"
              columnsXL="2">
            <f:content>
              <Label text="Destinação" />
              <Select
                editable="{ui>/editable}"
                selectedKey="{ path: 'PurchasePurpose', targetType: 'any' }"
                forceSelection="false">
                <core:ListItem key="ResaleOrInput" text="Revenda / insumo" />
                <core:ListItem key="UseAndConsumption" text="Uso e consumo" />
                <core:ListItem key="FixedAsset" text="Ativo imobilizado" />
              </Select>
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>
      <!-- Retenções sobre serviço (spec 2026-10-17, Outras compras). Percentuais editáveis usam Double, nunca Decimal
           (o Decimal grava string e o OData recusa). Vazio = não retém. -->
      <uxap:ObjectPageSubSection title="Retenções de serviço" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm
              editable="true"
              layout="ColumnLayout"
              columnsM="2"
              columnsL="3"
              columnsXL="3">
            <f:content>
              <Label text="ISS %" />
              <Input editable="{ui>/editable}" value="{ path: 'WithholdingIssRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="IRRF %" />
              <Input editable="{ui>/editable}" value="{ path: 'WithholdingIrrfRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="INSS %" />
              <Input editable="{ui>/editable}" value="{ path: 'WithholdingInssRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="PIS %" />
              <Input editable="{ui>/editable}" value="{ path: 'WithholdingPisRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="COFINS %" />
              <Input editable="{ui>/editable}" value="{ path: 'WithholdingCofinsRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="CSLL %" />
              <Input editable="{ui>/editable}" value="{ path: 'WithholdingCsllRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>
    </uxap:subSections>
  </uxap:ObjectPageSection>

  <uxap:ObjectPageSection id="usagesDimensionsSection" titleUppercase="false" title="Dimensões padrão" visible="{dims>/items/0/Active}">
    <uxap:subSections>
      <uxap:ObjectPageSubSection title=" " titleUppercase="false">
        <uxap:blocks>
          <f:Form editable="true">
            <f:layout>
              <f:ColumnLayout columnsM="2" columnsL="2" columnsXL="2" />
            </f:layout>
            <f:formContainers>
              <f:FormContainer>
                <f:formElements>
                  <core:Fragment fragmentName="siagrob1.view.common.fragments.DimensionFields" type="XML" />
                </f:formElements>
              </f:FormContainer>
            </f:formContainers>
          </f:Form>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>
    </uxap:subSections>
  </uxap:ObjectPageSection>
</core:FragmentDefinition>
