<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
>
  <!-- Tributação da NF-e STANDALONE. Oculta em SAPB1 (ui>/identityEditable = erp !== 'SAPB1'): lá a tributação é do
       SAP. Nada aqui é obrigatório — natureza sem tributação continua válida (a MH Agro não emite NF-e); quem exige é
       o documento de saída, e só na filial com "Emite NF-e pelo Siagro". O servidor valida a coerência do que for
       preenchido. Percentuais editáveis usam Double, nunca Decimal: o Decimal grava string e o leitor OData recusa
       com um 400 que não nomeia o campo. ui>/editable = false no detalhe (só leitura). -->
  <uxap:ObjectPageSection id="usagesTaxationSection" titleUppercase="false" title="Tributação" visible="{ui>/identityEditable}">
    <uxap:subSections>
      <uxap:ObjectPageSubSection title="ICMS dentro do estado" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
            <f:content>
              <Label text="CST" />
              <Select selectedKey="{IcmsInStateCst}" forceSelection="false" editable="{ui>/editable}">
                <core:ListItem key="" text="" />
                <core:ListItem key="00" text="00 - Tributada integralmente" />
                <core:ListItem key="20" text="20 - Com redução de base de cálculo" />
                <core:ListItem key="40" text="40 - Isenta" />
                <core:ListItem key="41" text="41 - Não tributada" />
                <core:ListItem key="50" text="50 - Suspensão" />
                <core:ListItem key="51" text="51 - Diferimento" />
                <core:ListItem key="90" text="90 - Outras" />
              </Select>
              <Label text="CSOSN (Simples Nacional)" />
              <Select selectedKey="{IcmsInStateCsosn}" forceSelection="false" editable="{ui>/editable}">
                <core:ListItem key="" text="" />
                <core:ListItem key="102" text="102 - Sem permissão de crédito" />
                <core:ListItem key="103" text="103 - Isenção por faixa de receita" />
                <core:ListItem key="300" text="300 - Imune" />
                <core:ListItem key="400" text="400 - Não tributada" />
                <core:ListItem key="900" text="900 - Outros" />
              </Select>
              <Label text="Alíquota %" />
              <Input editable="{ui>/editable}" value="{ path: 'IcmsInStateRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="Redução de base %" />
              <Input editable="{ui>/editable}" value="{ path: 'IcmsInStateBaseReduction', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="Diferimento % (CST 51)" />
              <Input editable="{ui>/editable}" value="{ path: 'IcmsInStateDeferral', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="cBenef" />
              <Input editable="{ui>/editable}" value="{IcmsInStateBenefitCode}" maxLength="10" />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>

      <uxap:ObjectPageSubSection title="ICMS fora do estado" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
            <f:content>
              <Label text="Alíquota" />
              <Text text="Automática: 7% ou 12% pela UF do destinatário (Resolução do Senado), 4% para produto importado." />
              <Label text="CST" />
              <Select selectedKey="{IcmsOutStateCst}" forceSelection="false" editable="{ui>/editable}">
                <core:ListItem key="" text="" />
                <core:ListItem key="00" text="00 - Tributada integralmente" />
                <core:ListItem key="20" text="20 - Com redução de base de cálculo" />
                <core:ListItem key="40" text="40 - Isenta" />
                <core:ListItem key="41" text="41 - Não tributada" />
                <core:ListItem key="50" text="50 - Suspensão" />
                <core:ListItem key="51" text="51 - Diferimento" />
                <core:ListItem key="90" text="90 - Outras" />
              </Select>
              <Label text="CSOSN (Simples Nacional)" />
              <Select selectedKey="{IcmsOutStateCsosn}" forceSelection="false" editable="{ui>/editable}">
                <core:ListItem key="" text="" />
                <core:ListItem key="102" text="102 - Sem permissão de crédito" />
                <core:ListItem key="103" text="103 - Isenção por faixa de receita" />
                <core:ListItem key="300" text="300 - Imune" />
                <core:ListItem key="400" text="400 - Não tributada" />
                <core:ListItem key="900" text="900 - Outros" />
              </Select>
              <Label text="Redução de base %" />
              <Input editable="{ui>/editable}" value="{ path: 'IcmsOutStateBaseReduction', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="Diferimento % (CST 51)" />
              <Input editable="{ui>/editable}" value="{ path: 'IcmsOutStateDeferral', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="cBenef" />
              <Input editable="{ui>/editable}" value="{IcmsOutStateBenefitCode}" maxLength="10" />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>

      <uxap:ObjectPageSubSection title="PIS/COFINS" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
            <f:content>
              <!-- A lista de CST muda com o tipo: 01-49 na saída, 50-99 na entrada. Só um dos dois Select fica visível;
                   cada um leva a largura da linha toda, senão o layout daria metade a cada. -->
              <Label text="CST PIS" />
              <Select selectedKey="{PisCst}" forceSelection="false" width="100%" editable="{ui>/editable}"
                      visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
                      items="{ui>/pisCofinsOutgoingCsts}">
                <core:ListItem key="{ui>key}" text="{ui>text}" />
                <layoutData><f:ColumnElementData cellsSmall="12" cellsLarge="8" /></layoutData>
              </Select>
              <Select selectedKey="{PisCst}" forceSelection="false" width="100%" editable="{ui>/editable}"
                      visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }"
                      items="{ui>/pisCofinsIncomingCsts}">
                <core:ListItem key="{ui>key}" text="{ui>text}" />
                <layoutData><f:ColumnElementData cellsSmall="12" cellsLarge="8" /></layoutData>
              </Select>
              <Label text="Alíquota PIS %" />
              <Input editable="{ui>/editable}" value="{ path: 'PisRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="CST COFINS" />
              <Select selectedKey="{CofinsCst}" forceSelection="false" width="100%" editable="{ui>/editable}"
                      visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }"
                      items="{ui>/pisCofinsOutgoingCsts}">
                <core:ListItem key="{ui>key}" text="{ui>text}" />
                <layoutData><f:ColumnElementData cellsSmall="12" cellsLarge="8" /></layoutData>
              </Select>
              <Select selectedKey="{CofinsCst}" forceSelection="false" width="100%" editable="{ui>/editable}"
                      visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }"
                      items="{ui>/pisCofinsIncomingCsts}">
                <core:ListItem key="{ui>key}" text="{ui>text}" />
                <layoutData><f:ColumnElementData cellsSmall="12" cellsLarge="8" /></layoutData>
              </Select>
              <Label text="Alíquota COFINS %" />
              <Input editable="{ui>/editable}" value="{ path: 'CofinsRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="Excluir o ICMS da base do PIS/COFINS ?" />
              <CheckBox selected="{ExcludeIcmsFromPisCofinsBase}" editable="{ui>/editable}" />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>

      <uxap:ObjectPageSubSection title="IBS/CBS (reforma tributária)" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
            <f:content>
              <Label text="CST IBS/CBS" />
              <Select selectedKey="{IbsCbsCst}" forceSelection="false" editable="{ui>/editable}">
                <core:ListItem key="" text="" />
                <core:ListItem key="000" text="000 - Tributação integral" />
                <core:ListItem key="200" text="200 - Alíquota reduzida" />
                <core:ListItem key="400" text="400 - Isenção" />
                <core:ListItem key="410" text="410 - Imunidade e não incidência" />
              </Select>
              <Label text="cClassTrib" />
              <Input editable="{ui>/editable}" value="{IbsCbsClassCode}" maxLength="6" />
              <Label text="Redução IBS %" />
              <Input editable="{ui>/editable}" value="{ path: 'IbsRateReduction', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="Redução CBS %" />
              <Input editable="{ui>/editable}" value="{ path: 'CbsRateReduction', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
              <Label text="Alíquotas" />
              <Text text="Vêm da tabela de Alíquotas IBS/CBS vigente na data de emissão." />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>

      <!-- Retenção do produtor rural na compra: só natureza de ENTRADA; as alíquotas vêm da tabela de vigências. -->
      <uxap:ObjectPageSubSection title="Contribuição Social" titleUppercase="false"
          visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }">
        <uxap:blocks>
          <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
            <f:content>
              <Label text="Contribuição social" />
              <Select
                  editable="{ui>/editable}"
                  selectedKey="{ path: 'RuralContributionMode', targetType: 'any' }"
                  forceSelection="false">
                <core:ListItem key="None" text="Não incide" />
                <core:ListItem key="Full" text="FUNRURAL (INSS + RAT + SENAR)" />
                <core:ListItem key="SenarOnly" text="Somente SENAR" />
              </Select>
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>

      <!-- A tributação muda dentro e fora do estado (ex.: ICMS diferido x tributado), então o texto também: a emissão
           escolhe pelo CFOP da linha (1xxx/5xxx = dentro; os demais = fora). -->
      <uxap:ObjectPageSubSection title="Informações complementares" titleUppercase="false">
        <uxap:blocks>
          <f:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
            <f:content>
              <Label text="Dentro do estado" />
              <TextArea value="{DefaultAdditionalInfo}" editable="{ui>/editable}" rows="4" maxLength="2000" growing="true" />
              <Label text="Fora do estado" />
              <TextArea value="{DefaultAdditionalInfoOutState}" editable="{ui>/editable}" rows="4" maxLength="2000" growing="true" />
            </f:content>
          </f:SimpleForm>
        </uxap:blocks>
      </uxap:ObjectPageSubSection>
    </uxap:subSections>
  </uxap:ObjectPageSection>
</core:FragmentDefinition>
