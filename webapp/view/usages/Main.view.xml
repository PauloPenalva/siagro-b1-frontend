<mvc:View
	controllerName="siagrob1.controller.usages.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Naturezas de Operação">
		<content>
      <t:Table
				id="usagesTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/Usages'
				}"
			>
				<t:extension>
					<OverflowToolbar >
            <ToolbarSpacer />
						<SearchField placeholder="Pesquisar..." width="30%" search=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column
						label="Codigo"
						sortProperty="Code"
						filterProperty="Code"
            visible="true"
            width="8rem"
						>
						<t:template>
							<Text text="{Code}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Nome"
						sortProperty="Name"
						filterProperty="Name"
						>
						<t:template>
							<Text text="{Name}" />
						</t:template>
					</t:Column>
					<t:Column
						label="CFOP Dentro"
						width="9rem"
						>
						<t:template>
							<Text text="{CfopOutgoingInState}" />
						</t:template>
					</t:Column>
					<t:Column
						label="CFOP Fora"
						width="9rem"
						>
						<t:template>
							<Text text="{CfopOutgoingOutState}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Saldo"
						width="10rem"
						>
						<t:template>
							<Text text="{
								path: 'ContractBalanceEffect',
								targetType: 'any',
								formatter: 'formatter.formatContractBalanceEffect'
							}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Valor"
						width="10rem"
						>
						<t:template>
							<Text text="{
								path: 'ContractValueEffect',
								targetType: 'any',
								formatter: 'formatter.formatContractValueEffect'
							}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Padrão"
						width="7rem"
						>
						<t:template>
							<Text text="{
								path: 'IsDefault',
								targetType: 'any',
								formatter: 'formatter.formatBooleanYesNo'
							}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Inativo"
						sortProperty="Inactive"
						filterProperty="Inactive"
						width="7rem"
						>
						<t:template>
							<Text text="{
								path: 'Inactive',
								targetType: 'any',
								formatter: 'formatter.formatBooleanYesNo'
							}" />
						</t:template>
					</t:Column>
				</t:columns>

			</t:Table>
		</content>
    <footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit"/>
				<Button text="Deletar" icon="sap-icon://delete" press=".onDelete"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
