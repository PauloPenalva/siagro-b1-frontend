<mvc:View
	controllerName="siagrob1.controller.usages.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Naturezas de Operação">
		<content>
      <t:Table
				id="usagesTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/Usages'
				}"
			>
				<t:extension>
					<OverflowToolbar >
            <ToolbarSpacer />
						<SearchField placeholder="Pesquisar..." width="30%" search=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column
						label="Codigo"
						sortProperty="Code"
						filterProperty="Code"
            visible="true"
            width="8rem"
						>
						<t:template>
							<Text text="{Code}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column
						label="Nome"
						sortProperty="Name"
						filterProperty="Name"
						width="22rem"
						>
						<t:template>
							<Text text="{Name}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column
						label="Tipo"
						width="7rem"
						visible="{ui>/identityEditable}"
						>
						<t:template>
							<Text text="{
								path: 'Direction',
								targetType: 'any',
								formatter: 'formatter.formatUsageDirection'
							}" wrapping="false" />
						</t:template>
					</t:Column>
					<!-- O CFOP mora em colunas diferentes conforme o tipo: entrada grava em
					     CfopIncoming*, saída (e natureza do OUSG, sem tipo) em CfopOutgoing*. -->
					<t:Column
						label="CFOP Dentro"
						width="9rem"
						>
						<t:template>
							<HBox>
								<Text text="{CfopOutgoingInState}" wrapping="false"
									visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
								<Text text="{CfopIncomingInState}" wrapping="false"
									visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }" />
							</HBox>
						</t:template>
					</t:Column>
					<t:Column
						label="CFOP Fora"
						width="9rem"
						>
						<t:template>
							<HBox>
								<Text text="{CfopOutgoingOutState}" wrapping="false"
									visible="{= ${path: 'Direction', targetType: 'any'} !== 'Incoming' }" />
								<Text text="{CfopIncomingOutState}" wrapping="false"
									visible="{= ${path: 'Direction', targetType: 'any'} === 'Incoming' }" />
							</HBox>
						</t:template>
					</t:Column>
					<!-- Um campo por propriedade: binding composto quebra no OData v4. -->
					<t:Column
						label="ICMS Dentro"
						width="9rem"
						visible="{ui>/identityEditable}"
						>
						<t:template>
							<HBox>
								<Text text="{IcmsInStateCst}" class="sapUiTinyMarginEnd" wrapping="false" />
								<Text text="{IcmsInStateCsosn}" wrapping="false" />
							</HBox>
						</t:template>
					</t:Column>
					<t:Column
						label="ICMS Fora"
						width="9rem"
						visible="{ui>/identityEditable}"
						>
						<t:template>
							<HBox>
								<Text text="{IcmsOutStateCst}" class="sapUiTinyMarginEnd" wrapping="false" />
								<Text text="{IcmsOutStateCsosn}" wrapping="false" />
							</HBox>
						</t:template>
					</t:Column>
					<t:Column
						label="Saldo"
						width="10rem"
						>
						<t:template>
							<Text text="{
								path: 'ContractBalanceEffect',
								targetType: 'any',
								formatter: 'formatter.formatContractBalanceEffect'
							}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column
						label="Valor"
						width="10rem"
						>
						<t:template>
							<Text text="{
								path: 'ContractValueEffect',
								targetType: 'any',
								formatter: 'formatter.formatContractValueEffect'
							}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column
						label="Efeito Configurado"
						width="11rem"
						>
						<t:template>
							<!-- Sem isto, natureza vinda do OUSG e natureza configurada como
							     "não altera nada" ficam idênticas na tela. -->
							<ObjectStatus
								text="{
									path: 'HasConfiguredEffects',
									targetType: 'any',
									formatter: 'formatter.formatBooleanYesNo'
								}"
								state="{
									path: 'HasConfiguredEffects',
									targetType: 'any',
									formatter: 'formatter.stateConfiguredEffects'
								}" />
						</t:template>
					</t:Column>
					<t:Column
						label="Padrão"
						width="7rem"
						>
						<t:template>
							<Text text="{
								path: 'IsDefault',
								targetType: 'any',
								formatter: 'formatter.formatBooleanYesNo'
							}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column
						label="Inativo"
						sortProperty="Inactive"
						filterProperty="Inactive"
						width="7rem"
						>
						<t:template>
							<Text text="{
								path: 'Inactive',
								targetType: 'any',
								formatter: 'formatter.formatBooleanYesNo'
							}" wrapping="false" />
						</t:template>
					</t:Column>
				</t:columns>

			</t:Table>
		</content>
    <footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<!-- Em SAPB1 o cadastro da natureza é do SAP: só o efeito é configurável aqui.
				     Incluir/Deletar sumem em vez de estourar NotImplemented no servidor. -->
				<Button text="Alíquotas IBS/CBS" icon="sap-icon://simulate" press=".onOpenIbsCbsRates" visible="{ui>/identityEditable}"/>
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate" visible="{ui>/identityEditable}"/>
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit"/>
				<Button text="Deletar" icon="sap-icon://delete" press=".onDelete" visible="{ui>/identityEditable}"/>
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
