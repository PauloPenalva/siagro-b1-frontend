<mvc:View
	controllerName="siagrob1.controller.produtos.Complement"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">

	<Page title="Complemento do Produto" busy="{ui>/busy}" busyIndicatorDelay="0">
		<content>
			<f:SimpleForm
				id="itemComplementForm"
				editable="true"
				layout="ResponsiveGridLayout"
				labelSpanXL="4"
				labelSpanL="4"
				labelSpanM="4"
				labelSpanS="12"
				adjustLabelSpan="false"
				emptySpanXL="0"
				emptySpanL="0"
				emptySpanM="0"
				emptySpanS="0"
				columnsXL="3"
				columnsL="2"
				columnsM="2"
				singleContainerFullSize="true"
				busyIndicatorDelay="0">
				<f:content>
					<core:Title text="Produto" emphasized="true" />
					<Label text="Codigo" />
					<Text text="{complement>/ItemCode}" />
					<Label text="Descrição" />
					<Text text="{complement>/ItemName}" />

					<core:Title text="UoM Comercial" emphasized="true" />
					<Label text="Unidade" />
					<Input
						id="commercialUnitOfMeasureCode"
						value="{complement>/CommercialUnitOfMeasureCode}"
						showValueHelp="true"
						valueHelpOnly="true"
						valueHelpRequest=".onCommercialUnitOfMeasureValueHelp"
						maxLength="4"
					/>
					<Label text="Fator (KG por unidade)" />
					<Input
						id="commercialFactor"
						value="{
							path: 'complement>/CommercialFactor',
							type: 'sap.ui.model.type.Float',
							formatOptions: { decimals: 6, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
						}"
					/>
					<Label text="" />
					<Text text="Preenchidos os dois campos, o preço do contrato (sempre em KG) passa a ser exibido nesta unidade. Deixe os dois em branco para voltar a exibir em KG." />

					<core:Title text="Exportação (NF-e)" emphasized="true" />
					<Label text="Unidade tributável" />
					<Input
						id="taxableUnitOfMeasureCode"
						value="{complement>/TaxableUnitOfMeasureCode}"
						maxLength="6"
					/>
					<Label text="Fator (KG por unidade tributável)" />
					<Input
						id="taxableFactor"
						value="{
							path: 'complement>/TaxableFactor',
							type: 'sap.ui.model.type.Float',
							formatOptions: { decimals: 6, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
						}"
					/>
					<Label text="" />
					<Text text="Preenchidos os dois campos, a NF-e com CFOP de exportação (7xxx, 5501/6501, 5502/6502, 5504/6504, 5505/6505) informa a quantidade e o valor tributados nesta unidade (ex.: TON com fator 1000). Deixe os dois em branco para usar a unidade do documento." />

					<core:Title text="Royalties (ITS)" emphasized="true" />
					<Label text="Controla royalties" />
					<CheckBox id="controlsRoyalties" selected="{complement>/ControlsRoyalties}" />
					<Label text="" />
					<Text text="Marcado, os tickets e romaneios de entrada deste produto exigem a situação de royalty (Declarada, Testada, Convencional ou Armazém Participante) e entram no controle de baixas do ITS." />

					<core:Title />
				</f:content>
			</f:SimpleForm>
			<!-- ICMS por UF do produto (spec 2026-10-17): só STANDALONE. Alíquota/FCP vazios herdam o cadastro "ICMS por UF".
			     Tabela do model OData (entidade própria), com Salvar próprio: o Salvar do rodapé grava só o complemento. -->
			<Panel headerText="Alíquota interna por UF" class="sapUiSmallMarginTop" visible="{ui>/standalone}">
				<Table
					id="itemStateRatesTable"
					mode="SingleSelectLeft"
					busyIndicatorDelay="0"
					class="sapUiSizeCondensed"
					items="{ path: '/IcmsItemStateRates', sorter: { path: 'StateCode' }, suspended: true }">
					<headerToolbar>
						<OverflowToolbar>
							<Text text="Vazio = usa a alíquota do cadastro ICMS por UF." />
							<ToolbarSpacer />
							<Button text="Incluir" icon="sap-icon://add" press=".onStateRateCreate" />
							<Button text="Excluir" icon="sap-icon://delete" press=".onStateRateDelete" />
							<Button text="Salvar alíquotas" icon="sap-icon://save" press=".onStateRatesSave" />
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column width="8rem"><Text text="UF" /></Column>
						<Column width="10rem"><Text text="Alíquota interna %" /></Column>
						<Column width="10rem"><Text text="FCP %" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Select
									selectedKey="{StateCode}"
									forceSelection="false"
									items="{ path: 'stateCodes>/', templateShareable: true }">
									<core:Item key="{stateCodes>key}" text="{stateCodes>text}" />
								</Select>
								<Input
									value="{ path: 'InternalRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
								<Input
									value="{ path: 'FcpRate', type: 'sap.ui.model.odata.type.Double', formatOptions: { decimals: 4, groupingEnabled: false } }" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</Panel>
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="Limpar" press=".onClear" />
				<Button text="Cancelar" press=".onCancel" />
				<Button text="Salvar" type="Emphasized" press=".onSave" />
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
