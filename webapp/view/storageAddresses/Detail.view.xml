<mvc:View
	controllerName="siagrob1.controller.storageAddresses.Detail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	xmlns:f="sap.f"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<f:DynamicPage id="pageStorageAddressDetail" busyIndicatorDelay="0">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Lote de Armazenagem {Code}"/>
				</f:heading>
				<f:expandedContent>
					<Text text="{Description}"/>
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{Description}"/>
				</f:snappedContent>
				<f:actions>
					<Button text="Voltar para Lista de Lotes" type="Transparent" press=".navToStorageAddressesList"/>
					<Button text="Editar" type="Transparent" icon="sap-icon://edit" press=".onEdit"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader>
				<f:content>
					<HBox wrap="Wrap">
						<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
							<ObjectStatus
								title="Filial"
								visible="{= !!${path: 'Branch/ShortName', targetType: 'any'} }"
								text="{Branch/ShortName}"/>
							<ObjectStatus
								title="Situação"
								text="{
									path: 'Status',
									targetType: 'any',
									formatter: '.formatter.formatStorageAddressStatus'
								}"
								state="{
									path: 'Status',
									targetType: 'any',
									formatter: '.formatter.formatStorageAddressStatusState'
								}"/>
							<ObjectStatus
								title="Encerrado em"
								visible="{= ${path: 'Status', targetType: 'any'} === 'Closed' }"
								text="{
									path: 'ClosingDate',
									type: 'sap.ui.model.odata.type.Date',
									formatOptions: { pattern: 'dd/MM/yyyy' }
								}"/>
						</VBox>
						<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
							<ObjectStatus title="Cli/For" text="{CardCode} - {CardName}"/>
							<ObjectStatus title="Produto" text="{ItemCode} - {ItemName}"/>
							<ObjectStatus title="Armazém" text="{WarehouseCode} - {WarehouseName}"/>
						</VBox>
						<VBox class="sapUiTinyMarginBottom">
							<ObjectStatus
								title="Tipo Propriedade"
								text="{
									path: 'OwnershipType',
									targetType: 'any',
									formatter: '.formatter.formatStorageOwnershipType'
								}"/>
							<ObjectStatus
								title="Natureza"
								text="{
									path: 'Nature',
									targetType: 'any',
									formatter: '.formatter.formatStorageAddressNature'
								}"/>
							<ObjectStatus
								title="Data"
								text="{
									path: 'CreationDate',
									targetType: 'any',
									formatter: '.formatter.formatDate'
								}"/>
						</VBox>
					</HBox>
				</f:content>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<!-- A tabela lê o JSONModel `lot`, e não o OData direto: a classificação é uma lista por
			     romaneio, e para virar coluna precisa ser reorganizada no controller. As colunas de
			     classificação são criadas lá, depois das fixas. -->
			<t:Table
				id="tableStorageAddressTransactions"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rowActionCount="1"
				rows="{lot>/rows}"
			>
				<t:extension>
					<OverflowToolbar>
						<Title text="Romaneios do Lote ({lot>/count})"/>
						<ToolbarSpacer/>
						<Button type="Transparent" text="Atualizar" icon="sap-icon://refresh" press=".onRefresh"/>
						<Button type="Transparent" text="Exportar Excel" icon="sap-icon://excel-attachment" press=".onExcel"/>
					</OverflowToolbar>
				</t:extension>
				<t:rowActionTemplate>
					<t:RowAction>
						<t:items>
							<t:RowActionItem type="Navigation" press=".onRowNavigate"/>
						</t:items>
					</t:RowAction>
				</t:rowActionTemplate>
				<t:columns>
					<t:Column label="Status" sortProperty="TransactionStatus" hAlign="Center" width="8rem">
						<t:template>
							<ObjectStatus
								inverted="true"
								state="{
									path: 'lot>TransactionStatus',
									formatter: '.formatter.stateStorageTransactionStatus'
								}"
								text="{
									path: 'lot>TransactionStatus',
									formatter: '.formatter.formatStorageTransactionStatus'
								}"/>
						</t:template>
					</t:Column>
					<t:Column label="Codigo" sortProperty="Code" width="8rem">
						<t:template>
							<Text text="{lot>Code}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Tipo" sortProperty="TransactionType" width="9rem">
						<t:template>
							<Text
								wrapping="false"
								text="{
									path: 'lot>TransactionType',
									formatter: '.formatter.formatStorageTransactionType'
								}"/>
						</t:template>
					</t:Column>
					<t:Column label="Emissão" sortProperty="TransactionDate" width="7rem">
						<t:template>
							<Text
								wrapping="false"
								text="{
									path: 'lot>TransactionDate',
									formatter: '.formatter.formatDate'
								}"/>
						</t:template>
					</t:Column>
					<t:Column label="Veículo" sortProperty="TruckCode" width="7rem">
						<t:template>
							<Text text="{lot>TruckCode}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Documento" sortProperty="InvoiceNumber" width="7rem">
						<t:template>
							<Text text="{lot>InvoiceNumber}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Peso Bruto" sortProperty="GrossWeight" hAlign="End" width="9rem">
						<t:template>
							<Text
								wrapping="false"
								text="{
									path: 'lot>GrossWeight',
									type: 'sap.ui.model.type.Float',
									formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
								}"/>
						</t:template>
					</t:Column>
					<t:Column label="Desc. Secagem" sortProperty="DryingDiscount" hAlign="End" width="9rem">
						<t:template>
							<Text
								wrapping="false"
								text="{
									path: 'lot>DryingDiscount',
									type: 'sap.ui.model.type.Float',
									formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
								}"/>
						</t:template>
					</t:Column>
					<t:Column label="Desc. Limpeza" sortProperty="CleaningDiscount" hAlign="End" width="9rem">
						<t:template>
							<Text
								wrapping="false"
								text="{
									path: 'lot>CleaningDiscount',
									type: 'sap.ui.model.type.Float',
									formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
								}"/>
						</t:template>
					</t:Column>
					<t:Column label="Outros Desc." sortProperty="OthersDicount" hAlign="End" width="9rem">
						<t:template>
							<Text
								wrapping="false"
								text="{
									path: 'lot>OthersDicount',
									type: 'sap.ui.model.type.Float',
									formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
								}"/>
						</t:template>
					</t:Column>
					<t:Column label="Peso Liquido" sortProperty="NetWeight" hAlign="End" width="9rem">
						<t:template>
							<Text
								wrapping="false"
								text="{
									path: 'lot>NetWeight',
									type: 'sap.ui.model.type.Float',
									formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
								}"/>
						</t:template>
					</t:Column>
				</t:columns>
				<t:footer>
					<OverflowToolbar style="Clear">
						<ToolbarSpacer/>
						<ObjectStatus
							title="Entradas"
							text="{
								path: 'lot>/totals/receipts',
								type: 'sap.ui.model.type.Float',
								formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
							} {UoM}"/>
						<ToolbarSeparator/>
						<ObjectStatus
							title="Saídas"
							text="{
								path: 'lot>/totals/shipments',
								type: 'sap.ui.model.type.Float',
								formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
							} {UoM}"/>
						<ToolbarSeparator/>
						<ObjectStatus
							title="Quebra Técnica"
							text="{
								path: 'lot>/totals/technicalLoss',
								type: 'sap.ui.model.type.Float',
								formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
							} {UoM}"/>
						<ToolbarSeparator/>
						<ObjectStatus
							title="Saldo"
							state="Information"
							text="{
								path: 'lot>/totals/balance',
								type: 'sap.ui.model.type.Float',
								formatOptions: { decimals: 3, decimalSeparator: ',', groupingEnabled: true, groupingSeparator: '.' }
							} {UoM}"/>
					</OverflowToolbar>
				</t:footer>
			</t:Table>
		</f:content>
	</f:DynamicPage>

</mvc:View>
