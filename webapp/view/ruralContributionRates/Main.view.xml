<mvc:View
	controllerName="siagrob1.controller.ruralContributionRates.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table">

	<Page title="Alíquotas de contribuição social" showNavButton="true" navButtonPress=".onNavBack">
		<content>
			<MessageStrip
				text="Alíquotas da contribuição social (INSS, RAT e SENAR) do produtor rural, por regime. Para cada documento vale a vigência mais recente iniciada até a data de emissão. O modo de incidência de cada operação fica na natureza de operação."
				type="Information"
				showIcon="true"
				class="sapUiSmallMargin" />
			<t:Table
				id="ruralContributionRatesTable"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/RuralContributionRates',
					sorter: { path: 'StartDate', descending: true }
				}">
				<t:columns>
					<t:Column label="Início da vigência" width="11rem">
						<t:template>
							<Text text="{
								path: 'StartDate',
								type: 'sap.ui.model.odata.type.Date',
								formatOptions: { pattern: 'dd/MM/yyyy' }
							}" />
						</t:template>
					</t:Column>
					<t:Column label="Regime" width="12rem">
						<t:template>
							<Text text="{= ${path: 'Scheme', targetType: 'any'} === 'PayrollOption' ? 'Optante pela folha' : 'Comercialização' }" />
						</t:template>
					</t:Column>
					<t:Column label="INSS %" hAlign="End">
						<t:template>
							<Text text="{
								path: 'InssRate',
								type: 'sap.ui.model.odata.type.Decimal',
								constraints: { precision: 7, scale: 4 },
								formatOptions: { decimalSeparator: ',', groupingEnabled: false }
							}" />
						</t:template>
					</t:Column>
					<t:Column label="RAT %" hAlign="End">
						<t:template>
							<Text text="{
								path: 'RatRate',
								type: 'sap.ui.model.odata.type.Decimal',
								constraints: { precision: 7, scale: 4 },
								formatOptions: { decimalSeparator: ',', groupingEnabled: false }
							}" />
						</t:template>
					</t:Column>
					<t:Column label="SENAR %" hAlign="End">
						<t:template>
							<Text text="{
								path: 'SenarRate',
								type: 'sap.ui.model.odata.type.Decimal',
								constraints: { precision: 7, scale: 4 },
								formatOptions: { decimalSeparator: ',', groupingEnabled: false }
							}" />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate" />
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit" />
				<Button text="Excluir" icon="sap-icon://delete" press=".onDelete" />
			</OverflowToolbar>
		</footer>
	</Page>

</mvc:View>
