<mvc:View
	controllerName="siagrob1.controller.distributionRules.Add"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
>

	<Page title="Nova Regra de Distribuição" busy="{ui>/busy}">
		<content>
			<f:Form id="distributionRuleForm" editable="true">
				<f:layout>
					<f:ColumnLayout columnsM="2" columnsL="2" columnsXL="2" />
				</f:layout>
				<f:formContainers>
					<f:FormContainer title="Dados da regra">
						<f:formElements>
							<f:FormElement label="Código">
								<Input value="{rule>/Header/Code}" required="true" maxLength="10" />
							</f:FormElement>
							<f:FormElement label="Nome">
								<Input value="{rule>/Header/Name}" required="true" maxLength="100" />
							</f:FormElement>
							<f:FormElement label="Vigência da primeira versão">
								<DatePicker
									value="{rule>/Selected/ValidFrom}"
									valueFormat="yyyy-MM-dd"
									displayFormat="dd/MM/yyyy"
									required="true" />
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
				</f:formContainers>
			</f:Form>

			<core:Fragment fragmentName="siagrob1.view.distributionRules.fragments.RuleLines" type="XML" />
		</content>
		<footer>
			<Toolbar>
				<ToolbarSpacer />
				<Button text="Cancelar" press=".onCancel" />
				<Button text="Salvar" type="Emphasized" press=".onSave" />
			</Toolbar>
		</footer>
	</Page>

</mvc:View>
