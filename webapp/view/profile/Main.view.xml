<mvc:View
	controllerName="siagrob1.controller.profile.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.ui.unified"
	xmlns:f="sap.ui.layout.form"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Meu Perfil" showNavButton="true" navButtonPress=".onNavBack" busy="{ui>/busy}">
		<content>

			<f:SimpleForm title="Dados do usuário" editable="false" layout="ResponsiveGridLayout">
				<f:content>
					<Label text="Usuário"/>
					<Text text="{profile>/username}"/>
					<Label text="Nome"/>
					<Text text="{profile>/fullName}"/>
					<Label text="E-mail"/>
					<Text text="{profile>/email}"/>
					<!--
						Em modo SAPB1 o cadastro é mantido no SAP; aqui os dados são sempre somente
						leitura, então a faixa apenas explica ONDE alterá-los.
					-->
					<Label text=""/>
					<MessageStrip
						type="Information"
						showIcon="true"
						text="{profile>/maintenanceHint}"/>
				</f:content>
			</f:SimpleForm>

			<Panel headerText="Foto do avatar" expandable="false" class="sapUiSmallMarginTop">
				<content>
					<HBox alignItems="Center" class="sapUiSmallMargin">
						<items>
							<Avatar
								id="profileAvatar"
								displaySize="L"
								initials="{sessionModel>/initials}"
								src="{sessionModel>/photoUrl}"
								fallbackIcon="sap-icon://person-placeholder"/>
							<VBox class="sapUiMediumMarginBegin">
								<items>
									<u:FileUploader
										id="photoUploader"
										name="photo"
										buttonText="Escolher imagem..."
										placeholder="Nenhuma imagem selecionada"
										fileType="png,jpg,jpeg,gif,webp"
										mimeType="image"
										maximumFileSize="2"
										typeMissmatch=".onPhotoTypeMismatch"
										fileSizeExceed=".onPhotoTooLarge"
										change=".onPhotoSelected"/>
									<HBox class="sapUiSmallMarginTop">
										<items>
											<Button text="Enviar foto" type="Emphasized" press=".onUploadPhoto"/>
											<Button
												text="Remover foto"
												press=".onRemovePhoto"
												enabled="{profile>/hasPhoto}"
												class="sapUiTinyMarginBegin"/>
										</items>
									</HBox>
									<Text
										text="PNG, JPEG, GIF ou WEBP, até 2 MB."
										class="sapUiTinyMarginTop"/>
								</items>
							</VBox>
						</items>
					</HBox>
				</content>
			</Panel>

			<Panel headerText="Aparência" expandable="false" class="sapUiSmallMarginTop">
				<content>
					<f:SimpleForm editable="true" layout="ResponsiveGridLayout">
						<f:content>
							<Label text="Tema"/>
							<Select
								id="themeSelect"
								selectedKey="{profile>/theme}"
								items="{ path: 'profile>/availableThemes', templateShareable: false }"
								change=".onThemeChanged">
								<core:Item key="{profile>key}" text="{profile>text}"/>
							</Select>
							<Label text=""/>
							<Text text="O tema escolhido acompanha o seu usuário em qualquer computador."/>
						</f:content>
					</f:SimpleForm>
				</content>
			</Panel>

			<Panel headerText="Alterar senha" expandable="false" class="sapUiSmallMarginTop">
				<content>
					<f:SimpleForm id="passwordForm" editable="true" layout="ResponsiveGridLayout">
						<f:content>
							<Label text="Senha atual" required="true"/>
							<Input id="currentPassword" value="{profile>/currentPassword}" type="Password" width="300px"/>
							<Label text="Nova senha" required="true"/>
							<Input id="newPassword" value="{profile>/newPassword}" type="Password" width="300px"/>
							<Label text="Confirme a nova senha" required="true"/>
							<Input id="confirmPassword" value="{profile>/confirmPassword}" type="Password" width="300px"/>
							<Label text=""/>
							<Text text="{profile>/passwordRequirements}"/>
							<Label text=""/>
							<Button text="Alterar senha" type="Emphasized" press=".onChangePassword" width="300px"/>
						</f:content>
					</f:SimpleForm>
				</content>
			</Panel>

		</content>
	</Page>

</mvc:View>
