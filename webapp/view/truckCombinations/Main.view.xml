<mvc:View
	controllerName="siagrob1.controller.truckCombinations.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:t="sap.ui.table"
	core:require="{
		formatter: 'siagrob1/model/formatter'
	}">

	<Page title="Conjuntos de Veículos">
		<content>
			<t:Table
				id="tableCombinations"
				busyIndicatorDelay="0"
				selectionMode="Single"
				selectionBehavior="Row"
				class="sapUiSizeCondensed"
				visibleRowCountMode="Auto"
				enableBusyIndicator="true"
				alternateRowColors="true"
				rows="{
					path: '/TruckCombinations',
					parameters: { $expand: 'Trailers' },
					sorter: { path: 'Code' }
				}"
			>
				<t:extension>
					<OverflowToolbar>
						<ToolbarSpacer />
						<SearchField placeholder="Pesquisar..." width="30%" search=".onSearch"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column label="Código" sortProperty="Code" width="9rem">
						<t:template>
							<Text text="{Code}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Descrição" sortProperty="Description">
						<t:template>
							<Text text="{Description}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Tração" sortProperty="TractionTruckCode" width="8rem">
						<t:template>
							<Text text="{TractionTruckCode}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Reboques" width="16rem">
						<t:template>
							<Text text="{ path: 'Trailers', formatter: 'formatter.trailersText' }" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Motorista padrão" sortProperty="DefaultDriverCode" width="9rem">
						<t:template>
							<Text text="{DefaultDriverCode}" wrapping="false"/>
						</t:template>
					</t:Column>
					<t:Column label="Inativo" sortProperty="Inactive" hAlign="Center" width="5rem">
						<t:template>
							<CheckBox selected="{Inactive}" editable="false" />
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
		<footer>
			<OverflowToolbar>
				<Button text="Atualizar" icon="sap-icon://refresh" press=".onRefresh" />
				<ToolbarSpacer />
				<Button text="Incluir" icon="sap-icon://add" type="Emphasized" press=".onCreate"/>
				<Button text="Editar" icon="sap-icon://edit" press=".onEdit"/>
				<Button text="Excluir" icon="sap-icon://delete" press=".onDelete"/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>
