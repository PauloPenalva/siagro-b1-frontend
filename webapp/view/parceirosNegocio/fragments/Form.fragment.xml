<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <f:SimpleForm
      id="businessPartnerForm"
      editable="true"
      layout="ResponsiveGridLayout"
      labelSpanXL="4"
      labelSpanL="4"
      labelSpanM="4"
      labelSpanS="12"
      adjustLabelSpan="false"
      emptySpanXL="0"
      emptySpanL="0"
      emptySpanM="0"
      emptySpanS="0"
      columnsXL="3"
      columnsL="2"
      columnsM="2"
      singleContainerFullSize="true"
		  busyIndicatorDelay="0">
        <f:content>
          <core:Title
              text="Dados do Parceiro de Negócio"
              emphasized="true"
          />
          <!-- STANDALONE: série Automático/Manual (só na inclusão; o código é imutável depois). A lista
               depende do Tipo (Cliente C… / Fornecedor F…) e é refiltrada em onCardTypeChange. Em SAPB1 a tela
               segue como era: código digitado, sem série. -->
          <Label text="Série" visible="{= ${ui>/standalone} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true }" />
          <Select
              id="businessPartnerSeriesSelect"
              visible="{= ${ui>/standalone} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true }"
              editable="{= !!${CardType} }"
              required="{= ${ui>/standalone} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true }"
              forceSelection="false"
              change=".onDocNumberSeriesChange"
              selectedKey="{DocNumberKey}"
              items="{
                path: '/DocNumbers',
                parameters: {
                  $filter: 'TransactionCode eq \'Customer\' and Inactive eq false',
                  $orderby: 'IsManual,Name',
                  $select: 'Key,Name,IsManual'
                }
              }"
          >
            <customData>
              <core:CustomData key="codeProperty" value="CardCode" />
            </customData>
            <core:ListItem key="{Key}" text="{Name}" />
          </Select>
          <Label text="Codigo" />
          <Input
              value="{CardCode}"
              editable="{= ${ui>/standalone} !== true || (${ui>/docNumberManual} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true) }"
              required="{= ${ui>/standalone} !== true || (${ui>/docNumberManual} === true &amp;&amp; ${ui>/docNumberSeriesEditable} === true) }"
              maxLength="15"
              liveChange=".validateField"
          />
          <Label text="Razão Social" />
          <Input
              value="{CardName}"
              editable="true"
              required="true"
              liveChange=".validateField"
              maxLength="200"
          />
          <Label text="Nome Fantasia" />
          <Input
              value="{CardFName}"
              editable="true"
              maxLength="200"
          />
          <Label text="Tipo" />
          <Select
              selectedKey="{CardType}"
              forceSelection="false"
              editable="true"
              required="true"
              liveChange=".validateField"
              change=".onCardTypeChange"
          >
            <core:ListItem key="C" text="Cliente" />
            <core:ListItem key="S" text="Fornecedor" />
          </Select>
          <Label text="Armazém" visible="{ui>/standalone}" />
          <Select
              selectedKey="{QryGroup23}"
              forceSelection="false"
              visible="{ui>/standalone}"
          >
            <core:ListItem key="N" text="Não" />
            <core:ListItem key="Y" text="Sim" />
          </Select>
          <Label text="CNPJ/CPF" />
          <Input
              value="{TaxId}"
              editable="true"
              maxLength="14"
          />
          <!-- Destinatário/transportadora da NF-e STANDALONE (ocultos em SAPB1). -->
          <Label text="Indicador da IE" visible="{ui>/standalone}" />
          <Select
              visible="{ui>/standalone}"
              selectedKey="{ path: 'StateRegistrationIndicator', targetType: 'any' }"
              forceSelection="false">
            <core:ListItem key="Taxpayer" text="1 - Contribuinte do ICMS" />
            <core:ListItem key="Exempt" text="2 - Contribuinte isento" />
            <core:ListItem key="NonTaxpayer" text="9 - Não contribuinte" />
          </Select>
          <Label text="Inscrição estadual" visible="{ui>/standalone}" />
          <Input value="{StateRegistration}" maxLength="14" placeholder="Só dígitos" visible="{ui>/standalone}" />
          <Label text="E-mail da NF-e" visible="{ui>/standalone}" />
          <Input value="{NfeEmail}" maxLength="250" type="Email" visible="{ui>/standalone}" />
          <Label text="Telefone" visible="{ui>/standalone}" />
          <Input value="{Phone}" maxLength="14" placeholder="Só dígitos" visible="{ui>/standalone}" />
          <Label text="Condição de pagamento padrão" visible="{ui>/standalone}" />
          <Input
              visible="{ui>/standalone}"
              showValueHelp="true"
              valueHelpOnly="true"
              valueHelpRequest=".openPaymentConditionsValueHelp"
              value="{PaymentConditionCode}" />
          <Input value="{ui>/paymentConditionName}" editable="false" visible="{ui>/standalone}" />
          <!-- Produtor rural (Funrural/SENAR na compra): tipo, CPF e opção pela folha só valem com o flag marcado. -->
          <Label text="Produtor rural" visible="{ui>/standalone}" />
          <CheckBox selected="{IsRuralProducer}" visible="{ui>/standalone}" />
          <Label text="Tipo de produtor" visible="{ui>/standalone}" />
          <Select
              visible="{ui>/standalone}"
              enabled="{= !!${IsRuralProducer} }"
              selectedKey="{ path: 'RuralProducerType', targetType: 'any' }"
              forceSelection="false">
            <core:ListItem key="Individual" text="Pessoa física" />
            <core:ListItem key="SpecialInsured" text="Segurado especial" />
            <core:ListItem key="LegalEntity" text="Pessoa jurídica" />
          </Select>
          <Label text="CPF do produtor" visible="{ui>/standalone}" />
          <Input value="{RuralProducerCpf}" maxLength="14" placeholder="Só dígitos" visible="{ui>/standalone}" enabled="{= !!${IsRuralProducer} }" />
          <Label text="Optante pela contribuição sobre a folha" visible="{ui>/standalone}" />
          <CheckBox selected="{RuralPayrollOption}" visible="{ui>/standalone}" enabled="{= !!${IsRuralProducer} &amp;&amp; ${path: 'RuralProducerType', targetType: 'any'} !== 'LegalEntity' }" />
          <core:Title text="Observações"/>
          <Label text="Observações" />
          <TextArea
              value="{Notes}"
              editable="true"
              maxLength="100"
              rows="5"
              cols="20"
          />
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>
