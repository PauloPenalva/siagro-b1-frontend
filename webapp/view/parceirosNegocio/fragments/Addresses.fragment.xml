<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:core="sap.ui.core"
>
    <t:Table
      id="businessPartnerAddressesTable"
      class="sapUiSizeCondensed"
      alternateRowColors="true"
      enableBusyIndicator="true"
      enableSelectAll="false"
      selectionBehavior="Row"
      selectionMode="Single"
      busyIndicatorDelay="0"
      rows="{Addresses}"
      visible="true"
    >
    <t:extension>
      <OverflowToolbar>
        <content>
          <Title text="Endereços" />
          <ToolbarSpacer />
          <Button
            visible="{ui>/editable}"
            text="Incluir"
            type="Transparent"
            icon="sap-icon://add"
            press=".onAddAddress"
          />
          <Button
            visible="{ui>/editable}"
            text="Remover"
            type="Transparent"
            icon="sap-icon://delete"
            press=".onRemoveAddress"
          />
        </content>
      </OverflowToolbar>
    </t:extension>
    <t:columns>
      <t:Column label="Endereço">
        <t:template>
          <Input
            editable="{ui>/editable}"
            required="true"
            value="{AddressName}" 
          >
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="Tipo">
        <t:template>
          <!-- AdresType é chave do endereço: só a linha nova (transiente) escolhe o tipo.
               isTransient é undefined na linha lida do servidor, por isso "=== true". -->
          <Select
            selectedKey="{path: 'AdresType', targetType: 'any'}"
            forceSelection="false"
            required="true"
            width="100%"
            enabled="{= ${ui>/editable} === true &amp;&amp; %{@$ui5.context.isTransient} === true }"
          >
            <core:ListItem key="B" text="Cobrança" />
            <core:ListItem key="S" text="Entrega" />
          </Select>
        </t:template>
      </t:Column>
      <t:Column label="Logradouro">
        <t:template>
          <Input
            editable="{ui>/editable}"
            required="true"
            value="{Street}" 
          >
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="Número" width="6rem" visible="{ui>/standalone}">
        <t:template>
          <Input editable="{ui>/editable}" value="{StreetNumber}" maxLength="60" />
        </t:template>
      </t:Column>
      <t:Column label="Complemento" visible="{ui>/standalone}">
        <t:template>
          <Input editable="{ui>/editable}" value="{Complement}" maxLength="60" />
        </t:template>
      </t:Column>
      <t:Column>
        <t:label>
          <Label text="{= ${ui>/standalone} ? 'Bairro' : 'Complemento' }" />
        </t:label>
        <t:template>
          <Input
            editable="{ui>/editable}"
            required="true"
            value="{Block}" 
          >
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="Município (IBGE)" width="9rem" visible="{ui>/standalone}">
        <t:template>
          <Input
            editable="{ui>/editable}"
            value="{MunicipalityCode}"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openMunicipalitiesValueHelp">
            <customData>
              <core:CustomData key="descriptionProperty" value="City:Name,State:StateAbbreviation" />
            </customData>
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="CEP" width="7rem" visible="{ui>/standalone}">
        <t:template>
          <Input editable="{ui>/editable}" value="{ZipCode}" maxLength="8" />
        </t:template>
      </t:Column>
      <t:Column label="Cidade">
        <t:template>
          <Input
            editable="{ui>/editable}"
            required="true"
            value="{City}" 
          >
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="Estado">
        <t:template>
          <Input
            editable="{ui>/editable}"
            required="true"
            value="{State}" 
          >
          </Input>
        </t:template>
      </t:Column>
      <t:Column label="País">
        <t:template>
          <Input
            editable="{ui>/editable}"
            required="true"
            value="{Country}"
            showValueHelp="true"
            valueHelpOnly="true"
            valueHelpRequest=".openCountriesValueHelp"
          />
        </t:template>
      </t:Column>
    </t:columns>
  </t:Table>
</core:FragmentDefinition>
