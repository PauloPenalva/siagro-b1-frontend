<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>

<TableSelectDialog
  class=" sapUiSizeCompact"
  growing="true"
  growingThreshold="20"
  items="{
    path: '/DimensionCodes',
    sorter: {
      path: 'Code',
      descending: false
    }
  }"
  rememberSelections="false"
  title="Dimensão"
>
<columns>
  <Column>
    <header>
      <Text text="Código" />
    </header>
  </Column>
  <Column>
    <header>
      <Text text="Nome" />
    </header>
  </Column>
  <Column>
    <header>
      <Text text="Tipo" />
    </header>
  </Column>
</columns>
<ColumnListItem >
  <cells>
    <Text text="{Code}" />
    <Text text="{Name}" />
    <Text text="{= ${Kind} === 'Rule' ? 'Regra' : 'Centro' }" />
  </cells>
</ColumnListItem>
</TableSelectDialog>
</core:FragmentDefinition>
