<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>

<TableSelectDialog
  class=" sapUiSizeCompact"
  growing="true"
  growingThreshold="20"
  items="{
    path: '/Companies',
    sorter: {
      path: 'Code',
      descending: false
    }
  }"
  rememberSelections="true"
  title="Empresas"
>
<columns>
  <Column>
    <header>
      <Text text="Código" />
    </header>
  </Column>
  <Column>
    <header>
      <Text text="Nome" />
    </header>
  </Column>
</columns>
<ColumnListItem >
  <cells>
    <Text text="{Code}" />
    <Text text="{CompanyName}" />
  </cells>
</ColumnListItem>
</TableSelectDialog>
</core:FragmentDefinition>
