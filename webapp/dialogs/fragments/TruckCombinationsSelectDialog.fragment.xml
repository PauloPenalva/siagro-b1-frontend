<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
<TableSelectDialog
  class="sapUiSizeCompact"
  growing="true"
  growingThreshold="20"
  items="{
    path: '/TruckCombinations',
    filters: [{ path: 'Inactive', operator: 'EQ', value1: false }],
    sorter: { path: 'Code', descending: false }
  }"
  rememberSelections="true"
  title="Conjuntos de veículos"
>
<columns>
  <Column><header><Text text="Código" /></header></Column>
  <Column><header><Text text="Descrição" /></header></Column>
  <Column><header><Text text="Tração" /></header></Column>
</columns>
<ColumnListItem>
  <cells>
    <Text text="{Code}" />
    <Text text="{Description}" />
    <Text text="{TractionTruckCode}" />
  </cells>
</ColumnListItem>
</TableSelectDialog>
</core:FragmentDefinition>
